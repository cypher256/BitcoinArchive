---
import { languages, type Lang } from '../i18n/ui';
import { PRIMARY_ORIGIN } from '../lib/constants';

interface Props {
  lang: Lang;
  /** Absolute counterpart URL for this exact page, e.g. the same value
      passed to BaseLayout's `alternateEn`/`alternateJa` (built via
      `absoluteUrl()`, so it's always PRIMARY_ORIGIN-rooted regardless of
      the current host/base). Most page types don't set this because a
      naive path swap already produces the right link -- every locale
      shares the same slug for entries, threads, tags, types, sources.
      Person-type keyword pages are the one case where the JA slug
      (katakana, translated) and EN slug (the English name) are
      deliberately different strings, so the naive swap 404s; passing the
      already-computed alternate here fixes exactly that case without
      touching any page where the naive swap was already correct. */
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const { pathname } = Astro.url;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function getAlternatePath(targetLang: Lang): string {
  if (alternateHref) return `${basePath}${alternateHref.replace(PRIMARY_ORIGIN, '')}`;
  const pathWithoutBase = pathname.replace(basePath, '');
  if (targetLang === 'ja') {
    return `${basePath}/ja${pathWithoutBase === '' ? '/' : pathWithoutBase}`;
  }
  return `${basePath}${pathWithoutBase.replace(/^\/ja/, '') || '/'}`;
}

const targetLang: Lang = lang === 'en' ? 'ja' : 'en';
const targetPath = getAlternatePath(targetLang);
---

<a href={targetPath} class="lang-switch" lang={targetLang}>
  {languages[targetLang]}
</a>

<style>
  .lang-switch {
    display: inline-block;
    padding: 0.25em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .lang-switch:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    text-decoration: none;
  }
  /* ブラウザの優先言語と表示言語が異なり、かつ代替版が実在するとき、
     Header の inline script が .lang-mismatch を付与してトグルを強調する。
     ドットは link 色ではなく注意色 (amber = --color-satoshi) を使う
     (STYLE_GUIDE Link-color confusion 規約: 非リンク要素に link 色を使わない)。 */
  .lang-switch.lang-mismatch {
    position: relative;
    border-color: var(--color-satoshi);
    color: var(--color-satoshi);
  }
  .lang-switch.lang-mismatch::after {
    content: "";
    position: absolute;
    top: -3px;
    right: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-satoshi);
  }
</style>
