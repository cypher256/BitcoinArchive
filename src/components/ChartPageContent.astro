---
import type { Lang } from '../i18n/ui';
import BtcPriceChart from './BtcPriceChart.astro';
import SupplyScheduleChart from './SupplyScheduleChart.astro';
import { useTranslations, localePath, formatUsdForLocale } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Shared body for the EN + JA /chart/ pages. Both pages render this one
// component (translations + per-card text resolve from `lang`), so the page
// markup and CSS live in exactly one place.
const allPredictions = await import('../data/btc-chart/predictions.json').then(m => m.default);
const halvings = await import('../data/btc-chart/halvings.json').then(m => m.default);

// This table only lists still-outstanding predictions: a prediction whose
// own target date has already passed reads as an error here even while its
// `hit` field is still null (not yet manually marked resolved) -- so this
// filters by the actual date, not by `hit`. Astro pages are static (built
// once, not re-rendered per visitor), so "today" is the last build/deploy
// date, not the live date a reader sees the page on -- a prediction whose
// target date passes between deploys keeps showing until the next build.
// Compared as plain ISO YYYY-MM-DD strings (which sort the same as
// chronological order), not as parsed Date instants: `new Date(dateStr)`
// parses to UTC midnight, so comparing it against `new Date()` (the exact
// current instant) would start excluding a prediction targeting *today*
// partway through the day once enough UTC hours have elapsed -- a
// same-calendar-day prediction should stay listed for the entirety of its
// own target day. This code comment itself never reaches the built HTML
// (frontmatter is server-side script, stripped like any other code
// comment at parse time).
const today = new Date().toISOString().slice(0, 10);
const predictions = allPredictions
  .filter((p: any) => p.targetDate >= today)
  // Default order: soonest target date first -- the natural reading order
  // for "which of these might resolve next". Interactive re-sort (by
  // predictor, date, or price) is added client-side below.
  .sort((a: any, b: any) => a.targetDate.localeCompare(b.targetDate));
---

<div class="container-wide chart-page">
  <h1>{t('chart.title' as any)}</h1>
  <p class="page-description">{t('chart.description' as any)}</p>

  <section class="chart-section">
    <BtcPriceChart lang={lang} />
  </section>

  <section class="detail-section">
    <h2>{t('chart.halvings' as any)}</h2>
    <div class="halvings-cards figure-block" data-kind="table">
      {halvings.map((h: any) => (
        <div class:list={['halving-card', { estimated: h.estimated }]}>
          <div class="halving-card-reward">{h.reward} <span>BTC</span></div>
          <div class="halving-card-label">{h.label[lang]}</div>
          <div class="halving-card-meta">
            <span>{h.date}</span>
            <span>#{h.block.toLocaleString()}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="section-reading">
      <a href={localePath('/entries/analysis/2008-10-31-bitcoin-digital-gold-structural-features/', lang)}>
        {t('chart.halvingsReading' as any)} &rarr;
      </a>
    </p>
  </section>

  <section class="detail-section">
    <h2>{t('chart.supplyTitle' as any)}</h2>
    <SupplyScheduleChart lang={lang} />
    <p class="section-reading">
      <a href={localePath('/entries/design/2009-01-03-bitcoin-monetary-design/', lang)}>
        {t('chart.supplyReading' as any)} &rarr;
      </a>
    </p>
  </section>

  <section class="detail-section predictions-section">
    <h2>{t('chart.predictionsTitle' as any)}</h2>
    <div class="predictions-table-wrap">
      <table class="predictions-table" id="predictions-table">
        <thead>
          <tr>
            <th class="pred-sortable" data-sort="predictor" tabindex="0" aria-sort="none">{t('chart.predictedBy' as any)}</th>
            <th class="pred-col-date pred-sortable pred-sort-active" data-sort="date" data-order="asc" tabindex="0" aria-sort="ascending">{t('chart.date' as any)}</th>
            <th class="th-price pred-sortable" data-sort="price" tabindex="0" aria-sort="none">{t('chart.target' as any)}</th>
          </tr>
        </thead>
        <tbody>
          {predictions.map((p: any) => (
              <tr class={p.bearish ? 'pred-bearish' : ''} data-predictor={p.predictor} data-date={p.targetDate} data-price={p.targetPrice}>
                <td>
                  <strong>{p.predictor}</strong>
                  <span class="pred-date-inline">
                    {p.date.slice(0, 7)}
                    <span class="pred-arrow">&rarr;</span>
                    {p.targetDate.slice(0, 7)}
                  </span>
                  <span class="pred-quote">"{p.quote[lang]}"</span>
                </td>
                <td class="pred-col-date pred-date">
                  <span>{p.date.slice(0, 7)}</span>
                  <span class="pred-arrow">&rarr;</span>
                  <span>{p.targetDate.slice(0, 7)}</span>
                </td>
                <td class="pred-price-cell">
                  <span class="pred-price-value">{formatUsdForLocale(p.targetPrice, lang)}</span>
                </td>
              </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <p class="chart-disclaimer">{t('chart.disclaimer' as any)}</p>
</div>

<script>
  // Predictions table: click a sortable header to re-sort by that column,
  // toggling ascending/descending on repeat clicks (same interaction as
  // the .sort-btn pattern used elsewhere on the site, adapted to <th>
  // clicks since this is a real <table> rather than a <li> list). date
  // and predictor sort as strings (ISO dates sort correctly as strings);
  // price sorts numerically. Default order (soonest target date first) is
  // set server-side, so this only needs to run on a click. <th> isn't
  // natively focusable/keyboard-activatable, so tabindex + a keydown
  // handler (Enter/Space) are added alongside click, and aria-sort is
  // kept in sync so the current sort state is exposed to assistive tech.
  (function () {
    var table = document.getElementById('predictions-table');
    if (!table) return;
    var tbody = table.querySelector('tbody');
    var headers = Array.prototype.slice.call(table.querySelectorAll('.pred-sortable'));
    if (!tbody || !headers.length) return;

    function applySort(key: string, order: string) {
      var rows = Array.prototype.slice.call(tbody!.querySelectorAll('tr'));
      rows.sort(function (a: any, b: any) {
        var av: string | number = a.dataset[key];
        var bv: string | number = b.dataset[key];
        if (key === 'price') { av = parseFloat(av as string); bv = parseFloat(bv as string); }
        if (av < bv) return order === 'asc' ? -1 : 1;
        if (av > bv) return order === 'asc' ? 1 : -1;
        return 0;
      });
      rows.forEach(function (r: any) { tbody!.appendChild(r); });
    }

    function activate(th: any) {
      var key = th.dataset.sort;
      var order = th.classList.contains('pred-sort-active') && th.dataset.order === 'asc' ? 'desc' : 'asc';
      headers.forEach(function (h: any) {
        h.classList.remove('pred-sort-active');
        h.removeAttribute('data-order');
        h.setAttribute('aria-sort', 'none');
      });
      th.classList.add('pred-sort-active');
      th.dataset.order = order;
      th.setAttribute('aria-sort', order === 'asc' ? 'ascending' : 'descending');
      applySort(key, order);
    }

    headers.forEach(function (th: any) {
      th.addEventListener('click', function () { activate(th); });
      th.addEventListener('keydown', function (event: KeyboardEvent) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate(th);
        }
      });
    });
  })();
</script>

<style>
  .chart-page h1 {
    margin-top: 2rem;
  }
  .page-description {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .chart-section {
    margin-bottom: 3rem;
  }
  .detail-section {
    margin-bottom: 3rem;
  }
  .detail-section h2 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: var(--heading-underline-gap);
  }

  /* Route out of the figures and into the entries that read them. The page
     is otherwise a dead end -- it shows the schedule but not why it holds. */
  .section-reading {
    margin: 0.9rem 0 0;
    font-size: 0.88rem;
    font-family: var(--font-heading);
  }

  /* Halvings cards: single row, horizontal scroll instead of wrapping.
     A wrapping grid/flex layout strands a lone trailing card whenever
     the item count doesn't divide evenly into the fitted column count
     (7 halvings, 6 per row at wide viewports leaves one card alone on
     the last row) -- centering that lone card independently of the
     columns above it just reads as a stray floating box, not fixed.
     One row that scrolls sidesteps the problem entirely: there is never
     a partial row. Reuses the site's shared .figure-block[data-kind]
     mechanism (overflow-x: auto sizing + BaseLayout's scroll-fade cue)
     so this gets the same horizontal-scroll affordance as tables and
     mermaid diagrams, without a separate implementation. The figure-block
     chrome (border/background/padding) is reset below since each card
     already carries its own border -- keeping both would double-box. */
  .halvings-cards {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.75rem;
    border: none;
    background: none;
    padding: 0;
  }
  .halving-card {
    flex: 0 0 180px;
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    text-align: center;
    font-family: var(--font-heading);
    transition: box-shadow 0.15s;
  }
  .halving-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .halving-card.estimated {
    opacity: 0.6;
    border-style: dashed;
  }
  .halving-card-reward {
    /* --color-text, not --color-accent: in dark mode --color-accent
       (#7aa3d4) sits next to --color-link (#7ab8ff) and this static
       stat number would read as clickable when it is not (same fix
       as f3a449325 / 8643cca36). Size + weight already carry emphasis. */
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }
  .halving-card-reward span {
    font-size: 0.75rem;
    font-weight: 600;
  }
  .halving-card-label {
    font-size: 0.82rem;
    font-weight: 600;
    margin: 0.4rem 0;
    color: var(--color-text);
  }
  .halving-card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  /* Predictions table */
  .predictions-section {
    margin-bottom: 3rem;
  }
  .chart-disclaimer {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 1rem;
  }
  .predictions-table-wrap {
    overflow-x: auto;
  }
  .predictions-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }
  .predictions-table th {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 2px solid var(--color-border);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .pred-sortable {
    cursor: pointer;
    user-select: none;
  }
  .pred-sortable:hover {
    color: var(--color-text);
  }
  .pred-sortable::after {
    content: '';
    display: inline-block;
    width: 0.6em;
    margin-left: 0.2em;
  }
  .pred-sort-active[data-order="asc"]::after {
    content: '↑';
  }
  .pred-sort-active[data-order="desc"]::after {
    content: '↓';
  }
  .predictions-table td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .pred-quote {
    display: block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.2rem;
  }
  .pred-date-inline {
    display: none;
  }
  .pred-date {
    white-space: nowrap;
    font-size: 0.8rem;
  }
  .pred-arrow {
    margin: 0 0.2rem;
    color: var(--color-text-muted);
  }
  .predictions-table .th-price {
    text-align: right;
  }
  .pred-price-cell {
    text-align: right;
    white-space: nowrap;
  }
  .pred-price-value {
    display: block;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    /* Only the date *value* cell hides on mobile (redundant with the
       date already shown inline under the predictor name, see
       .pred-date-inline below) -- the header stays visible so the date
       sort control it carries (see the sort script) remains reachable. */
    td.pred-col-date {
      display: none;
    }
    .pred-date-inline {
      display: block;
      font-size: 0.75rem;
      color: var(--color-text-muted);
      margin-top: 0.15rem;
    }
  }
  .pred-bearish td:first-child strong::after {
    content: ' (bearish)';
    color: #dc2626;
    font-weight: 400;
    font-size: 0.75rem;
  }

  @media (max-width: 600px) {
    .halvings-cards {
      gap: 0.5rem;
    }
    .halving-card {
      flex-basis: 140px;
      padding: 0.75rem 0.5rem;
    }
    .halving-card-reward {
      font-size: 1.1rem;
    }
    .pred-date {
      white-space: normal;
    }
  }
</style>
