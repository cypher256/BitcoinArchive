---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import SourceCitation from '../../components/SourceCitation.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import CommentaryLinks from '../../components/CommentaryLinks.astro';
import SatoshiCodeAnalysis from '../../components/SatoshiCodeAnalysis.astro';
import PlosPatoshiAnomaly from '../../components/PlosPatoshiAnomaly.astro';
import GitHubMigrationTimeline from '../../components/GitHubMigrationTimeline.astro';
import SatoshiHoldingsComparison from '../../components/SatoshiHoldingsComparison.astro';
import WhaleAlertFortune from '../../components/WhaleAlertFortune.astro';
import DesignSeriesNav from '../../components/DesignSeriesNav.astro';
import ParentLink from '../../components/ParentLink.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import { DESIGN_SERIES } from '../../data/design-series';
import { getCollection, render } from 'astro:content';
import { useTranslations, localePath, absoluteUrl, findAuthorParticipant } from '../../i18n/utils';
import Avatar from '../../components/Avatar.astro';
import MessageBlock from '../../components/MessageBlock.astro';
import { resolveThreadId, deriveThreadTitle } from '../../data/threads';
import { renderEditorNote } from '../../lib/editor-note';
import { LABELS as EDITORIAL_LABELS } from '../../lib/remark-editorial-marker.mjs';
import gitDates from '../../data/git-dates.json';
import ChartEmbedRuntime from '../../components/ChartEmbedRuntime.astro';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const jaEntries = await getCollection('entries_ja');
  const jaIds = new Set(jaEntries.filter((e) => e.data.type !== 'biography').map((e) => e.id));
  return entries.filter((e) => e.data.type !== 'biography').map((entry) => ({
    params: { slug: entry.id },
    props: { entry, hasJa: jaIds.has(entry.id) },
  }));
}

const lang = 'en';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const { entry, hasJa } = Astro.props;
const { Content } = await render(entry);
// Only a handful of entries (the whitepaper drafts) contain $$ math blocks.
// Gates the sitewide KaTeX <link> in BaseLayout so it isn't fetched on
// every other entry page for a feature this one mostly doesn't use.
const hasMath = /\$\$/.test(entry.body ?? '');

const allEntries = await getCollection('entries');
const sorted = allEntries.filter((e) => e.data.type !== 'biography').sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const currentIndex = sorted.findIndex((e) => e.id === entry.id);

// All 12 design entries share the same frontmatter `date`, so the date sort
// above carries no real ordering signal between them. Follow the same
// L0 -> L1 #1..#8 -> L2 #9..#11 series order as DesignSeriesNav instead.
let prev, next;
if (entry.data.type === 'design') {
  const bareSlug = entry.id.replace(/^design\//, '');
  const seriesIndex = DESIGN_SERIES.findIndex((e) => e.slug === bareSlug);
  const prevSlug = seriesIndex > 0 ? DESIGN_SERIES[seriesIndex - 1].slug : null;
  const nextSlug = seriesIndex >= 0 && seriesIndex < DESIGN_SERIES.length - 1 ? DESIGN_SERIES[seriesIndex + 1].slug : null;
  prev = prevSlug ? allEntries.find((e) => e.id === `design/${prevSlug}`) ?? null : null;
  next = nextSlug ? allEntries.find((e) => e.id === `design/${nextSlug}`) ?? null : null;
} else {
  prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
  next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
}

const threadId = resolveThreadId(entry);
const threadMessages = threadId
  ? allEntries.filter((e) => resolveThreadId(e) === threadId).length
  : 0;
const entryById = new Map(allEntries.map((e) => [e.id, e]));
// Threads this editorial entry quotes from. Unlike the banner above — which
// links the thread the reader is already inside — these point at a *different*
// document, so each carries the thread's own title: a bare "View full thread
// (N messages)" gives the reader nothing to choose by, and when two quoted
// threads happen to have the same message count the two banners render
// identically (satoshi-final-known-email quotes two 4-message threads).
const commentaryThreadLinks = new Map<string, { id: string; messages: number; title: string }>();
if (entry.data.type === 'article' || entry.data.type === 'analysis' || entry.data.type === 'design') {
  for (const q of entry.data.quotes ?? []) {
    if (!q.sourceEntryId) continue;
    const sourceEntry = entryById.get(q.sourceEntryId);
    if (!sourceEntry) continue;
    const sourceThreadId = resolveThreadId(sourceEntry);
    if (!sourceThreadId || commentaryThreadLinks.has(sourceThreadId)) continue;
    const sourceThreadGroup = allEntries.filter((e) => resolveThreadId(e) === sourceThreadId);
    if (sourceThreadGroup.length >= 2) {
      // Same ordering buildThreadInfo uses, so the derived title matches the
      // one the thread page itself shows.
      const ordered = [...sourceThreadGroup].sort(
        (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
      );
      commentaryThreadLinks.set(sourceThreadId, {
        id: sourceThreadId,
        messages: sourceThreadGroup.length,
        title: deriveThreadTitle(sourceThreadId, ordered, lang),
      });
    }
  }
}
const breadcrumbs = [
  { name: t('nav.home'), url: localePath('/', lang) },
  { name: t('nav.entries'), url: localePath('/entries/', lang) },
  { name: entry.data.title, url: localePath(`/entries/${entry.id}/`, lang) },
];

// Content last-updated date from git history (separate axis from
// frontmatter.date which is the entry's anchor to the historical event).
// git-dates.json keys per-language records (en / ja). EN and JA are usually
// edited together so the two updatedAt values are typically identical, but they
// diverge legitimately when only one side is touched (e.g. a JA-only translation
// pass). Each language page reads its own record.
type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateRecord = (gitDates as Record<string, GitDateRecord>)[entry.id]?.en;
const createdAt = gitDateRecord?.createdAt ? new Date(gitDateRecord.createdAt) : undefined;
const updatedAt = gitDateRecord?.updatedAt ? new Date(gitDateRecord.updatedAt) : undefined;
// OGP / structured-data dates. For analysis entries the editorial
// creation date is the meaningful published time (frontmatter.date
// is the date of the underlying event being analysed, not of the
// analysis writing). Other types keep frontmatter.date as the
// published time. modifiedTime is the git-history updatedAt for all
// types when available.
const isAnalysis = entry.data.type === 'analysis' || entry.data.type === 'design';
const ogPublishedTime = isAnalysis ? (createdAt ?? updatedAt ?? entry.data.date) : entry.data.date;
const ogModifiedTime = updatedAt ?? entry.data.date;
// OG / JSON-LD author. For editorial types the frontmatter `author`
// names the subject the entry is about (per STYLE_GUIDE_CORE.md § Editorial
// Entries → Frontmatter author semantics), not the editorial writer.
// The on-page byline in EntryMeta forces "Bitcoin Institute" for the
// same reason; mirror that forcing here so structured-data and OGP
// metadata cite the actual writer of the content, not the subject.
const isEditorialType = entry.data.type === 'article' || entry.data.type === 'analysis' || entry.data.type === 'design' || entry.data.type === 'currency';
const ogAuthor = isEditorialType ? 'Bitcoin Institute' : entry.data.author;
// The 8 primary-source types where the entire page body is one
// person's own statement (same set CommentaryLinks.astro gates on).
// These render the body inside MessageBlock, whose own header already
// shows the avatar + name + date — so the separate title avatar and
// the EntryMeta byline are dropped for these types instead of
// repeating the same "who wrote this" three times on one page.
const MESSAGE_BLOCK_TYPES = ['correspondence', 'mailing-list', 'forum-post', 'bip', 'whitepaper', 'court-document', 'tweet', 'web-document'];
const isMessageBlockType = MESSAGE_BLOCK_TYPES.includes(entry.data.type);
// Title avatar: Bitcoin Institute for editorial types (article /
// analysis / design / currency), none for MessageBlock types (its own
// header carries the avatar), else the byline participant. null when
// no participant resolves (then no avatar shows before the title).
const titleAvatarParticipant = findAuthorParticipant(entry.data.author, entry.data.participants);
const titleAvatarSlug = isEditorialType
  ? 'bitcoin-institute'
  : (isMessageBlockType ? undefined : titleAvatarParticipant?.slug);
// Every person avatar links to its participant page (the slug comes from
// this entry's own participants[], the same set participant pages are
// generated from, so the target always exists). The Bitcoin Institute
// avatar on editorial pages has no participant page — it links to About.
const titleAvatarHref = isEditorialType
  ? localePath('/about/', lang)
  : (titleAvatarParticipant ? localePath(`/participants/${titleAvatarParticipant.slug}/`, lang) : null);
const titleAvatarLabel = isEditorialType ? t('site.title') : titleAvatarParticipant?.name;
// og:image — prefer the entry's hero illustration when one exists
// (editorial types embed it as the body's first image, see
// STYLE_GUIDE_CORE.md "Hero Images"); the generated /og/ text card stays
// the fallback for the primary-source types that have none. The body
// markdown hardcodes the MIRROR_BASE prefix (remark-rewrite-base
// rewrites it per deployment at build), while BaseHead wants a
// base-stripped path to prepend PRIMARY_ORIGIN to — capture without it.
const heroOgMatch = (entry.body ?? '').match(
  /!\[[^\]]*\]\((?:\/BitcoinArchive)?(\/images\/analysis\/[^)\s]+-hero\.png)\)/,
);
const heroOgImage = heroOgMatch ? heroOgMatch[1] : null;
---

<BaseLayout
  title={`${entry.data.title} - ${t('site.title')}`}
  description={entry.data.description}
  lang={lang}
  alternateJa={hasJa ? absoluteUrl(`/entries/${entry.id}/`, 'ja') : undefined}
  ogType="article"
  publishedTime={ogPublishedTime}
  modifiedTime={ogModifiedTime}
  author={ogAuthor}
  ogImage={heroOgImage ?? `/og/${entry.id}.png`}
  ogImageWidth={heroOgImage ? 1600 : undefined}
  ogImageHeight={heroOgImage ? 900 : undefined}
  breadcrumbs={breadcrumbs}
  hasMath={hasMath}
>
  <article class="container">
    <PrevNextNav
      top
      prev={prev && { href: localePath(`/entries/${prev.id}/`, lang), label: prev.data.title }}
      next={next && { href: localePath(`/entries/${next.id}/`, lang), label: next.data.title }}
    />
    <header class="entry-header">
      <div class="entry-title-row">
        {titleAvatarSlug && (titleAvatarHref ? (
          <a href={titleAvatarHref} class="avatar-link" aria-label={titleAvatarLabel}>
            <Avatar slug={titleAvatarSlug} sizeClass="entry-author-avatar" base={base} />
          </a>
        ) : (
          <Avatar slug={titleAvatarSlug} sizeClass="entry-author-avatar" base={base} />
        ))}
        <h1>{entry.data.title}</h1>
      </div>
      <EntryMeta
        date={entry.data.date}
        author={entry.data.author}
        entryType={entry.data.type}
        source={entry.data.source}
        sourceUrl={entry.data.sourceUrl}
        isSatoshi={entry.data.isSatoshi}
        lang={lang}
        participants={entry.data.participants}
        tags={entry.data.tags}
        inlineLinkKeywords={entry.data.inlineLinkKeywords}
        xHandle={entry.data.xHandle}
        updatedAt={updatedAt}
        createdAt={createdAt}
        showAuthor={!isMessageBlockType}
      />
    </header>

    <ParentLink lang={lang} partOf={entry.data.partOf} />

    {isMessageBlockType && (
      <CommentaryLinks lang={lang} entryId={entry.id} entryType={entry.data.type} />
    )}

    {entry.data.editorNote && (
      <aside class="editorial-note editorial-note--editor">
        <span class="editorial-note-label">{EDITORIAL_LABELS['editor:en']}</span>
        <span class="editorial-note-body" set:html={renderEditorNote(entry.data.editorNote)}></span>
      </aside>
    )}

    {entry.data.type === 'design' && (
      <DesignSeriesNav lang={lang} slug={entry.id} />
    )}

    {isMessageBlockType ? (
      <MessageBlock
        lang={lang}
        base={base}
        author={entry.data.author}
        participants={entry.data.participants}
        date={entry.data.date}
        isSatoshi={entry.data.isSatoshi}
        xHandle={entry.data.xHandle}
        bodyClass="entry-content"
      >
        <Content />
      </MessageBlock>
    ) : (
      <div class:list={["entry-content", { "conversation-thread": entry.data.isConversation }]}>
        <Content />
      </div>
    )}

    {entry.data.type === 'analysis' && entry.id.includes('satoshi-code') && (
      <SatoshiCodeAnalysis lang={lang} />
    )}

    {entry.id.includes('plos-one-patoshi-anomaly-study') && (
      <PlosPatoshiAnomaly lang={lang} />
    )}

    {entry.id.includes('bitcoin-github-migration-committers') && (
      <GitHubMigrationTimeline lang={lang} />
    )}

    {entry.id.includes('satoshi-bitcoin-holdings-analysis') && (
      <SatoshiHoldingsComparison lang={lang} />
    )}

    {entry.id.includes('whale-alert-satoshi-fortune') && (
      <WhaleAlertFortune lang={lang} />
    )}

    {threadId && threadMessages >= 2 && (
      <div class="thread-banner">
        <a href={localePath(`/entries/threads/${threadId}/`, lang)}>
          View full thread ({threadMessages} messages) &rarr;
        </a>
      </div>
    )}

    {[...commentaryThreadLinks.values()].map((thread) => (
      <div class="thread-banner">
        <a href={localePath(`/entries/threads/${thread.id}/`, lang)}>
          Full thread: {thread.title} ({thread.messages} messages) &rarr;
        </a>
      </div>
    ))}

    <RelatedEntries lang={lang} entryId={entry.id} relatedIds={entry.data.relatedEntries ?? []} />

    <SourceCitation
      sourceUrl={entry.data.sourceUrl}
      sourceNote={entry.data.sourceNote}
      secondarySources={entry.data.secondarySources}
      pdfMetadata={entry.data.pdfMetadata}
      lang={lang}
      entryType={entry.data.type}
    />

    <PrevNextNav
      prev={prev && { href: localePath(`/entries/${prev.id}/`, lang), label: prev.data.title }}
      next={next && { href: localePath(`/entries/${next.id}/`, lang), label: next.data.title }}
    />
  </article>

  {isEditorialType && <ChartEmbedRuntime />}
</BaseLayout>

<style>
  .entry-header {
    padding-top: 2rem;
    /* This element has no bottom padding/border, so its own
       margin-bottom rarely wins the collapse against its last child's
       margin-bottom (see EntryMeta.astro's .tags-row comment for the
       actual mechanism) -- kept equal to that shared value anyway so
       the two stay in sync and this rule isn't a silent no-op.
       .entry-content's own padding-top (1.5rem, shared with
       .biography-content) is what guarantees a fixed minimum gap below
       this header regardless of collapse. ParentLink.astro's negative
       top margin is calibrated against the same shared value -- change
       all three (here, EntryMeta.astro, ParentLink.astro) together. */
    margin-bottom: 0.25rem;
  }
  /* .entry-title-row itself (the h1's band + its .flat variant, avatar
     background, and the narrow-screen bleed) is defined once in
     global.css, shared with the JA mirror of this template — see the
     rule there for the full rationale. */
  .entry-content {
    line-height: 1.8;
  }
  /* blockquote styling lives in global.css (`blockquote` + the
     speaker-tagged variant `blockquote[data-speaker="satoshi"]`).
     Re-declaring the base rule here as `.entry-content :global(blockquote)`
     used to silently override the global Satoshi accent because the
     scoped parent class bumped specificity above the data-speaker
     selector. Removed to let global.css win unchanged. */
  .thread-banner {
    /* --rhythm-block (global.css): shared with .related-entries
       and .source-citation so end-of-article spacing collapses
       uniformly everywhere, not three independently-authored magic
       numbers. */
    margin: var(--rhythm-block) 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .thread-banner a {
    font-weight: 600;
  }
</style>
