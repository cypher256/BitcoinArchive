---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import { useTranslations, getDisplayEntries, translateTag, absoluteUrl, localePath } from '../../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../../data/threads';
import { defaultSortAxis, dominantType, byDateAxisDesc } from '../../../lib/dateAxis';
import gitDates from '../../../data/git-dates.json';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

export async function getStaticPaths() {
  const { getDisplayEntries } = await import('../../../i18n/utils');
  const entries = await getDisplayEntries('ja');
  const tags = new Set<string>();
  for (const entry of entries) {
    for (const tag of entry.data.tags ?? []) {
      tags.add(tag);
    }
  }
  // 英語側に存在するタグを取得。type 分布も同時に集計（EN が言語非依存の
  // 真実源 — see EN mirror src/pages/tags/[tag].astro, dateAxis.ts）。
  const enEntries = await getDisplayEntries('en');
  const enTags = new Set<string>();
  const typesByTag = new Map<string, string[]>();
  for (const entry of enEntries) {
    for (const tag of entry.data.tags ?? []) {
      enTags.add(tag);
      if (!typesByTag.has(tag)) typesByTag.set(tag, []);
      typesByTag.get(tag)!.push(entry.data.type);
    }
  }
  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag, hasEn: enTags.has(tag), sortAxis: defaultSortAxis(dominantType(typesByTag.get(tag) ?? [])) },
  }));
}

const lang = 'ja';
const t = useTranslations(lang);
const { tag, hasEn, sortAxis } = Astro.props;
const entries = await getDisplayEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);
const filtered = entries.filter((e) => (e.data.tags ?? []).includes(tag));
// sortAxis was resolved in getStaticPaths from this tag's dominant type.
const displayEntries = collapseThreads(filtered, threadCounts, threadStarters)
  .slice()
  .sort(byDateAxisDesc(sortAxis, (id) => gitDateMap[id]?.ja?.createdAt));
const tagLabel = translateTag(tag, lang);

const searchHref = `${localePath('/entries/', lang)}?q=${encodeURIComponent(tagLabel)}`;

const pageDescription = `「${tagLabel}」タグの付いたエントリー。ビットコイン黎明期のサトシ・ナカモトの投稿・メール・関連する歴史的記録を、このトピックの下に集約。`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tagLabel} - ${t('site.title')}`,
  "url": absoluteUrl(`/tags/${tag}/`, lang),
  "description": pageDescription,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": tagLabel,
    "numberOfItems": displayEntries.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": displayEntries.slice(0, 25).map((entry: any, index: number) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      const itemUrl = isThread
        ? absoluteUrl(`/entries/threads/${tid}/`, lang)
        : absoluteUrl(`/entries/${entry.id}/`, lang);
      const itemName = isThread
        ? (threadTitles.get(tid!) || entry.data.title)
        : entry.data.title;
      return {
        "@type": "ListItem",
        "position": index + 1,
        "url": itemUrl,
        "name": itemName,
      };
    }),
  },
};
---

<BaseLayout
  title={`${tagLabel} - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateEn={hasEn ? absoluteUrl(`/tags/${tag}/`, 'en') : undefined}
  structuredData={structuredData}
>
  <div class="container-wide">
    <h1>{tagLabel}</h1>
    <p class="page-lead">このトピックでタグ付けされたエントリー。タイプ・ソースを横断し、人物・出来事・テーマの関連を辿れます。</p>
    <div class="filter-row">
      <input type="text" id="filter-input" class="filter-input" placeholder="フィルター..." aria-label="フィルター" autocomplete="off" />
    </div>
    <div class="list-header">
      <p class="entry-count"><span id="entry-count-num">{displayEntries.length}</span> 件</p>
      <div class="sort-controls">
        <button class:list={['sort-btn', { active: sortAxis === 'date' }]} data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
        <button class:list={['sort-btn', { active: sortAxis === 'created' }]} data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
        <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
      </div>
    </div>
    <div id="tag-entries-list">
      {displayEntries.map((entry) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            entryType={entry.data.type}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            createdAt={gitDateMap[entry.id]?.ja?.createdAt}
            updatedAt={gitDateMap[entry.id]?.ja?.updatedAt}
          />
        );
      })}
    </div>
    <script>
      import { initListSort, initListFilter } from '../../../scripts/list-sort';
      initListSort('tag-entries-list');
      initListFilter('tag-entries-list', 'filter-input');
    </script>

    <aside class="search-cta">
      <p>
        このタグが付いていなくても、ワード自体を言及しているエントリーを探したい場合：
      </p>
      <a class="search-cta-link" href={searchHref}>
        「{tagLabel}」 でアーカイブ全文をファジー検索 &rarr;
      </a>
      <p class="search-cta-note">
        検索は typo 許容・部分一致を含むファジー方式。タグ一覧では拾えない、
        緩く関連する素材も探せます。
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .filter-row {
    max-width: 28rem;
    margin-bottom: 0.75rem;
  }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 0;
  }
  .search-cta {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .search-cta p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .search-cta-link {
    display: inline-block;
    margin: 0.5rem 0;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-link);
  }
  .search-cta-link:hover {
    text-decoration: underline;
  }
  .search-cta-note {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }
</style>
