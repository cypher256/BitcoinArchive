---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface PdfMetadata {
  id: string;
  language: string;
  creator: string;
  producer: string;
  creationDate: string;
  pages: number;
  checksum: string;
}

interface Props {
  sourceUrl?: string;
  sourceNote?: string;
  secondarySources?: { name: string; url: string; note?: string }[];
  pdfMetadata?: PdfMetadata;
  lang: Lang;
  entryType?: string;
}

const { sourceUrl, sourceNote, secondarySources, pdfMetadata, lang, entryType } = Astro.props;
const t = useTranslations(lang);

// For derivative, Bitcoin-Institute-authored entry types, the `sourceUrl`
// and `secondarySources` are references the entry discusses, not the
// original of a transcribed text. Switch labels accordingly.
const isDerivativeType = entryType === 'analysis' || entryType === 'biography' || entryType === 'design' || entryType === 'currency';
const primaryLabel = isDerivativeType ? 'entry.referenceSource' : 'entry.originalSource';
// `sourceUrl` is omitted for entries with no single canonical external
// reference (several sources are equally primary -- forcing one into
// the "open first" slot would be an arbitrary, unranked pick dressed
// up as a ranking). When that happens, `secondarySources` stands alone
// under a neutral heading instead of reading as "other" relative to a
// primary that does not exist. See STYLE_GUIDE.md "Source Citation".
const secondaryLabel = !sourceUrl
  ? 'entry.externalSources'
  : isDerivativeType
    ? 'entry.relatedSources'
    : 'entry.secondarySources';

// Display cap, mirroring RelatedEntries / CommentaryLinks: the first
// MAX_VISIBLE items (frontmatter order = editorial priority, see
// STYLE_GUIDE "Source Citation") are always shown; the remainder folds
// into a native <details> block. The data layer keeps the full list.
const MAX_VISIBLE = 5;
const visibleSources = secondarySources?.slice(0, MAX_VISIBLE) ?? [];
const hiddenSources = secondarySources?.slice(MAX_VISIBLE) ?? [];
const showMoreLabel = t('related.showMore' as any).replace('{n}', String(hiddenSources.length));

// sourceUrl, secondarySources, and pdfMetadata are all optional; render
// nothing rather than an empty bordered box when none are present.
const hasContent = Boolean(sourceUrl) || visibleSources.length > 0 || Boolean(pdfMetadata);
---

{hasContent && (
<div class="source-citation">
  {sourceUrl && (
    <>
      <h3>{t(primaryLabel as any)}</h3>
      <a href={sourceUrl} target="_blank" rel="noopener">{sourceUrl}</a>
      {sourceNote && (
        <div class="source-note-block">{sourceNote}</div>
      )}
    </>
  )}
  {visibleSources.length > 0 && (
    <div class:list={['secondary-sources', { 'secondary-sources--standalone': !sourceUrl }]}>
      <h4>{t(secondaryLabel as any)}</h4>
      {!sourceUrl && sourceNote && (
        <div class="source-note-block">{sourceNote}</div>
      )}
      <ul>
        {visibleSources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">{s.name}</a>
            {s.note && (
              <span class="source-note">{lang === 'ja' ? `（${s.note}）` : ` — ${s.note}`}</span>
            )}
          </li>
        ))}
      </ul>
      {hiddenSources.length > 0 && (
        <details class="sources-more">
          <summary>{showMoreLabel}</summary>
          <ul>
            {hiddenSources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener">{s.name}</a>
                {s.note && (
                  <span class="source-note">{lang === 'ja' ? `（${s.note}）` : ` — ${s.note}`}</span>
                )}
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}
  {pdfMetadata && (
    <div class="pdf-metadata">
      <h4>{t('entry.pdfMetadata')}</h4>
      <dl>
        <dt>{t('entry.pdfId')}</dt>
        <dd><code>{pdfMetadata.id}</code></dd>
        <dt>{t('entry.pdfLanguage')}</dt>
        <dd>{pdfMetadata.language}</dd>
        <dt>{t('entry.pdfCreator')}</dt>
        <dd>{pdfMetadata.creator}</dd>
        <dt>{t('entry.pdfProducer')}</dt>
        <dd>{pdfMetadata.producer}</dd>
        <dt>{t('entry.pdfCreationDate')}</dt>
        <dd><time datetime={pdfMetadata.creationDate}>{pdfMetadata.creationDate}</time></dd>
        <dt>{t('entry.pdfPages')}</dt>
        <dd>{pdfMetadata.pages}</dd>
        <dt>{t('entry.pdfChecksum')}</dt>
        <dd><code>{pdfMetadata.checksum}</code></dd>
      </dl>
    </div>
  )}
</div>
)}

<style>
  .source-citation {
    /* --rhythm-block (global.css): shared with .thread-banner and
       .related-entries so end-of-article spacing collapses uniformly
       everywhere, not three independently-authored magic numbers. */
    margin-top: var(--rhythm-block);
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-source-bg);
    border-radius: 4px;
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .source-citation h3 {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .source-citation a {
    word-break: break-all;
  }
  .secondary-sources {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  /* No `sourceUrl` above it (no single source outranks the rest), so
     this list is the top-level section, not a follow-on to a primary
     block -- no divider needed. */
  .secondary-sources--standalone {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .secondary-sources h4 {
    margin: 0 0 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .secondary-sources ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  .secondary-sources li {
    margin-bottom: 0.25rem;
  }
  .sources-more {
    margin-top: 0.5rem;
  }
  .sources-more > summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding: 0.4rem 0;
    user-select: none;
    list-style-position: inside;
  }
  .sources-more > summary:hover {
    color: var(--color-link);
  }
  .sources-more[open] > summary {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .source-note {
    color: var(--color-text-muted);
    font-size: 0.85em;
    margin-left: 0.25em;
  }
  .source-note-block {
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.85em;
    line-height: 1.5;
  }
  .pdf-metadata {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .pdf-metadata h4 {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .pdf-metadata dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.75rem;
    margin: 0;
    font-size: 0.8rem;
  }
  .pdf-metadata dt {
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .pdf-metadata dd {
    margin: 0;
  }
  .pdf-metadata code {
    font-size: 0.75rem;
    background: var(--color-bg-alt, #f5f5f5);
    padding: 0.1em 0.3em;
    border-radius: 2px;
    word-break: break-all;
  }
</style>
