---
/**
 * GuideSeriesNav.astro
 *
 * Lightweight step list for the 6-page beginner-guide series. Renders at
 * the top of every `type: "guide"` entry.
 *
 * Deliberately NOT a copy of DesignSeriesNav.astro: that component's dense
 * tree-style table of contents (L0/L1/L2 groups, per-item parameter-level
 * detail) is exactly the "looks like a page for developers" presentation
 * the guide series must avoid (STYLE_GUIDE_CORE.md's "Guide entries"
 * section). This component is a flat, six-item ordered list -- no tiers,
 * no grouping -- with the current page's own title shown in place instead
 * of linked.
 *
 * No separate prev/next links here: the page's top-of-article PrevNextNav
 * already follows GUIDE_SERIES order for `type: "guide"` entries (see
 * [...slug].astro), so restating "next: <title>" a second time down here
 * would just repeat the same link in the same words twice on one page.
 * This list's job is the one PrevNextNav can't do: show the reader where
 * today's page sits among all six, so they can jump to any of them.
 *
 * Wired in via:
 *   src/pages/entries/[...slug].astro
 *   src/pages/ja/entries/[...slug].astro
 * as `{entry.data.type === 'guide' && <GuideSeriesNav lang={lang}
 * slug={entry.id} />}` immediately before `<Content />`.
 *
 * The series order itself lives in ../data/guide-series.ts (shared with
 * the prev/next logic in both [...slug].astro pages) -- add new pages
 * there, not here.
 */
import { localePath } from '../i18n/utils';
import { GUIDE_SERIES } from '../data/guide-series';

interface Props {
  lang: 'en' | 'ja';
  slug: string;
}

const { lang, slug } = Astro.props;

const bareSlug = slug.replace(/^analysis\//, '');
const currentIndex = GUIDE_SERIES.findIndex((e) => e.slug === bareSlug);
const current = currentIndex >= 0 ? GUIDE_SERIES[currentIndex] : undefined;

function titleOf(e: (typeof GUIDE_SERIES)[number]) {
  return lang === 'ja' ? e.titleJa : e.titleEn;
}

function hrefFor(e: (typeof GUIDE_SERIES)[number]) {
  return localePath(`/entries/analysis/${e.slug}/`, lang);
}

const stepNumber = (current ? current.step : 0) + 1;
const stepLabel = lang === 'ja'
  ? `ステップ ${stepNumber} / ${GUIDE_SERIES.length}`
  : `Step ${stepNumber} of ${GUIDE_SERIES.length}`;
const seriesLabel = lang === 'ja' ? '初心者ガイド' : 'Beginner guide';
---

<nav class="guide-series-nav" aria-label={seriesLabel}>
  <div class="guide-series-step">
    <span class="guide-series-kicker">{seriesLabel}</span>
    <span class="guide-series-count">{stepLabel}</span>
  </div>
  <ol class="guide-series-list">
    {GUIDE_SERIES.map((e) => (
      <li class:list={[{ 'is-current': e.slug === bareSlug }]}>
        {e.slug === bareSlug
          ? <span class="guide-series-item" aria-current="step">{titleOf(e)}</span>
          : <a href={hrefFor(e)} class="guide-series-item">{titleOf(e)}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .guide-series-nav {
    margin: var(--gap-header-to-body) 0 var(--rhythm-cluster);
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-alt);
    font-family: var(--font-heading);
  }
  .guide-series-step {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .guide-series-kicker {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .guide-series-count {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .guide-series-list {
    margin: 0.6rem 0 0;
    padding: 0.6rem 0 0 1.4rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .guide-series-list li {
    padding: 0.15rem 0;
  }
  .guide-series-list li.is-current .guide-series-item {
    color: var(--color-text);
    font-weight: 600;
  }
  .guide-series-list a.guide-series-item {
    color: var(--color-link);
    text-decoration: none;
  }
  .guide-series-list a.guide-series-item:hover {
    text-decoration: underline;
  }
</style>
