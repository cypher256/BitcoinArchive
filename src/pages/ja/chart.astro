---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartPageContent from '../../components/ChartPageContent.astro';
import { useTranslations, absoluteUrl } from '../../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('chart.title' as any)} - ${t('site.title')}`}
  description={t('chart.description' as any)}
  lang={lang}
  alternateEn={absoluteUrl('/chart/', 'en')}
>
  <ChartPageContent lang={lang} />
</BaseLayout>
