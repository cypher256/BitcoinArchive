---
import type { Lang } from '../i18n/ui';
import { useTranslations, formatUsdForLocale } from '../i18n/utils';

interface Props {
  lang: Lang;
  mini?: boolean;
}

const { lang, mini = false } = Astro.props;
const t = useTranslations(lang);

// Load data at build time
const prices = await import('../data/btc-chart/prices.json').then(m => m.default);
const halvings = await import('../data/btc-chart/halvings.json').then(m => m.default);
const events = await import('../data/btc-chart/events.json').then(m => m.default);
const predictions = await import('../data/btc-chart/predictions.json').then(m => m.default);
const supply = await import('../data/btc-chart/supply.json').then(m => m.default);
const modelsData = await import('../data/btc-chart/models.json').then(m => m.default);

const chartData = {
  prices,
  halvings: halvings.map((h: any) => ({ ...h, label: h.label[lang] })),
  events: events.map((e: any) => ({ ...e, label: e.label[lang] })),
  predictions: predictions.map((p: any) => ({
    ...p,
    quote: p.quote[lang],
    // Resolved server-side (like `quote` above) so the client tooltip
    // script never needs its own copy of the JA man-unit formatting rule
    // -- see formatUsdForLocale's own comment for why JA reads "100万ドル"
    // rather than "$1,000,000".
    targetPriceLabel: formatUsdForLocale(p.targetPrice, lang),
    actualPriceLabel: p.actualPrice != null ? formatUsdForLocale(p.actualPrice, lang) : null,
  })),
  supply,
  models: modelsData.models.map((m: any) => ({
    ...m,
    name: m.name[lang],
    description: m.description[lang],
  })),
};

const chartId = mini ? 'btc-mini-chart' : 'btc-price-chart';
---

<div class:list={['btc-chart-wrapper', { mini }]}>
  {!mini && (
    <div class="chart-controls">
      <div class="chart-toggles">
        <label class="toggle-btn active" data-toggle="halvings">
          <span class="toggle-dot halving-dot"></span> {t('chart.halvings' as any)}
        </label>
        <label class="toggle-btn active" data-toggle="events">
          <span class="toggle-dot event-dot"></span> {t('chart.events' as any)}
        </label>
        <label class="toggle-btn active" data-toggle="predictions">
          <span class="toggle-dot prediction-dot"></span> {t('chart.predictions' as any)}
        </label>
        <label class="toggle-btn active" data-toggle="models">
          <span class="toggle-dot model-dot"></span> {t('chart.models' as any)}
        </label>
      </div>
      <div class="chart-scale-btns">
        <button class="scale-btn active" data-scale="log">{t('chart.logScale' as any)}</button>
        <button class="scale-btn" data-scale="linear">{t('chart.linearScale' as any)}</button>
      </div>
      <div class="chart-range-btns">
        <button class="range-btn" data-range="1y">{t('chart.range1Y' as any)}</button>
        <button class="range-btn" data-range="5y">{t('chart.range5Y' as any)}</button>
        <button class="range-btn active" data-range="all">{t('chart.rangeAll' as any)}</button>
      </div>
      <button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button>
    </div>
  )}
  <div id={chartId} class:list={['chart-container', { mini }]}></div>
  <script type="application/json" id={`${chartId}-data`} set:html={JSON.stringify(chartData)} />
  <script
    type="application/json"
    id={`${chartId}-meta`}
    set:html={JSON.stringify({
      chartId,
      mini,
      lang,
      labels: {
        price: t('chart.price' as any),
        date: t('chart.date' as any),
        reward: t('chart.reward' as any),
        block: t('chart.block' as any),
        predictedBy: t('chart.predictedBy' as any),
        target: t('chart.target' as any),
        actual: t('chart.actual' as any),
      },
    })}
  />
</div>

<script>
// Real ES-module script (no define:vars, no is:inline) so Vite bundles it and
// tree-shakes d3 to the ~13 functions actually used, instead of the ~92KB
// full CDN bundle. define:vars would force Astro to treat this as is:inline
// — see the sibling `#<chartId>-meta` JSON block above for how the
// server-side values (chartId/mini/lang/labels) now cross into this script.
// `area`/`line` are aliased on import since this file already has local
// variables with those names (the configured d3 shape generators).
import { select, pointer } from 'd3-selection';
import { scaleTime, scaleLog, scaleLinear } from 'd3-scale';
import { axisLeft, axisBottom } from 'd3-axis';
import { area as d3area, line as d3line, curveMonotoneX } from 'd3-shape';
import { extent, min, max, bisector } from 'd3-array';
import { format } from 'd3-format';

// Data shapes below are typed loosely (`any` on nested fields, esp. the
// datum callback parameters passed to d3 .attr()/.text() etc.) rather than
// modeling every prediction/event/model field precisely: the goal here is
// catching real mistakes elsewhere in this file (typos, wrong argument
// counts, undefined access), not exhaustively describing chart JSON shapes
// that already have a single source of truth in src/data/btc-chart/*.json.
interface PricePoint {
  date: Date;
  price: number;
}
interface ChartMeta {
  chartId: string;
  mini: boolean;
  lang: string;
  labels: Record<string, string>;
}
interface ChartJsonData {
  prices: Array<{ date: string; price: number }>;
  halvings: any[];
  events: any[];
  predictions: any[];
  supply: any;
  models: any[];
}

(function() {
  // chartId is always exactly one of these two literal values (see the
  // frontmatter above). This module script is deduplicated by Astro/Vite
  // if the component is ever used twice on one page (unlike the old
  // is:inline copy, which duplicated verbatim per instance) — iterating
  // both possible ids here means both a full and a mini instance on the
  // same page would still each get initialized correctly.
  ['btc-price-chart', 'btc-mini-chart'].forEach(function (id) {
    var metaEl = document.getElementById(id + '-meta');
    if (metaEl) initChart(JSON.parse(metaEl.textContent as string) as ChartMeta);
  });

  function initChart(meta: ChartMeta) {
    var chartId = meta.chartId, mini = meta.mini, lang = meta.lang, labels = meta.labels;

    // Asserted non-null: the runtime check right below returns early if
    // either lookup actually failed, but that guard doesn't narrow the type
    // inside functions declared further down (draw(), etc.), so the
    // declared type itself has to already say "non-null" for those call
    // sites to type-check (same pattern as NetworkGraph.astro).
    var container = document.getElementById(chartId) as HTMLElement;
    var dataEl = document.getElementById(chartId + '-data') as HTMLElement;
    if (!container || !dataEl) return;

    var data = JSON.parse(dataEl.textContent as string) as ChartJsonData;
    var prices: PricePoint[] = data.prices.map(function(d) { return { date: new Date(d.date), price: d.price }; });

    // Resolve a CSS custom property against :root. Tokens are guaranteed
    // by `src/styles/global.css`; reading them at draw() time is what
    // allows the chart to repaint when the theme/mode changes.
    function token(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function readTokens() {
      return {
        accent: token('--color-accent'),
        text: token('--color-text'),
        muted: token('--color-text-muted'),
        grid: token('--color-divider'),
        surface: token('--color-bg'),
        positive: token('--chart-positive'),
        negative: token('--chart-negative'),
        warning: token('--chart-warning'),
        // Halving lines use chart-color-1 (warm/accent family) so they
        // visually thread to the price area below them.
        halving: token('--chart-color-1'),
        // Crash / regulation / win event markers carry semantic tone:
        // negative for crashes, purple (chart-color-4) for regulation,
        // positive for the rest.
        eventCrash: token('--chart-negative'),
        eventRegulation: token('--chart-color-4'),
        eventOther: token('--chart-positive'),
        // Prediction status: bearish (red), pending (chart-color-4 purple),
        // hit (positive green), missed (muted).
        predBearish: token('--chart-negative'),
        predPending: token('--chart-color-4'),
        predHit: token('--chart-positive'),
        predMissed: token('--chart-color-6'),
      };
    }

    // State
    var useLog = !mini;
    var showHalvings = true;
    var showEvents = true;
    var showPredictions = !mini;
    var showModels = !mini;
    var rangeMode = 'all';
    var replayFn: (() => void) | null = null;   // re-run the reveal animation (set once armed)
    var fullExtent: [Date, Date] | null = null; // [startDate, endDate] of the completed chart, for the animation driver

    function getFilteredPrices() {
      if (rangeMode === 'all') return prices;
      var now = new Date();
      var cutoff = new Date(now);
      if (rangeMode === '1y') cutoff.setFullYear(now.getFullYear() - 1);
      if (rangeMode === '5y') cutoff.setFullYear(now.getFullYear() - 5);
      return prices.filter(function(d) { return d.date >= cutoff; });
    }

    // animEnd: a Date to reveal the chart up to (the reveal animation drives this);
    // null/undefined draws the complete, interactive chart. While animating, the
    // x-domain stretches to animEnd, the y-domain stays fixed at the final range,
    // and the expensive model + hover layers are skipped for smoothness.
    function draw(animEnd?: Date) {
      var animating = !!animEnd;
      container.innerHTML = '';
      var T = readTokens();
      var filteredPrices = getFilteredPrices();
      if (filteredPrices.length === 0) return;

      var rect = container.getBoundingClientRect();
      var W = rect.width || 800;
      var H = mini ? 180 : 500;

      var margin = mini
        ? { top: 20, right: 15, bottom: 30, left: 55 }
        : { top: 45, right: (showModels ? (W < 500 ? 30 : 150) : 30), bottom: 40, left: (W < 500 ? 50 : 70) };
      var w = W - margin.left - margin.right;
      var h = H - margin.top - margin.bottom;

      var svg = select(container).append('svg')
        .attr('width', W).attr('height', H);
      var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      // Scales. filteredPrices is non-empty (checked above), so extent/min/max
      // are asserted non-null rather than threading `| undefined` through
      // every downstream use — they can only be undefined on an empty array.
      var xExtent = extent(filteredPrices, function(d) { return d.date; }) as [Date, Date];

      // Extend X axis to show model projections into the future
      if (showModels && !mini && data.models && rangeMode === 'all') {
        var modelMaxDate = new Date(xExtent[1]);
        data.models.forEach(function(model) {
          model.data.forEach(function(d: any) {
            var md = new Date(d.date);
            if (md > modelMaxDate) modelMaxDate = md;
          });
        });
        xExtent[1] = modelMaxDate;
      }

      // Cache the full span (incl. model projection) once, so the animation
      // driver knows the start/end dates to sweep between.
      if (!animating) fullExtent = [xExtent[0], xExtent[1]];
      // domEnd is the current right edge: animEnd while animating, full extent otherwise.
      var domEnd = animating ? animEnd! : xExtent[1];
      var x = scaleTime().domain([xExtent[0], domEnd]).range([0, w]);

      var priceMin = min(filteredPrices, function(d) { return d.price; }) as number;
      var priceMax = max(filteredPrices, function(d) { return d.price; }) as number;

      // When models are visible, extend Y max to include model curves
      // Cap at 10x actual price max so extreme models (S2F) don't crush the chart
      var actualPriceMax = priceMax;
      if (showModels && !mini && data.models) {
        var modelCap = actualPriceMax * 10;
        data.models.forEach(function(model) {
          model.data.forEach(function(d: any) {
            var md = new Date(d.date);
            if (md >= xExtent[0] && md <= xExtent[1]) {
              var capped = Math.min(d.price, modelCap);
              if (capped > priceMax) priceMax = capped;
            }
          });
        });
      }

      var y: any;
      if (useLog) {
        y = scaleLog().domain([Math.max(0.01, priceMin * 0.8), priceMax * 1.3]).range([h, 0]).clamp(true);
      } else {
        y = scaleLinear().domain([0, priceMax * 1.15]).range([h, 0]);
      }

      // Y-axis tick values
      var yTickValues: number[] | undefined;
      if (useLog) {
        // Explicit log scale ticks to avoid overlapping labels
        var allLogTicks = [0.01, 0.1, 1, 10, 100, 1000, 10000, 100000, 1000000];
        var yDomain = y.domain();
        yTickValues = allLogTicks.filter(function(v) { return v >= yDomain[0] && v <= yDomain[1]; });
      }

      // Grid lines
      var gridAxis = axisLeft(y).tickSize(-w).tickFormat(function() { return ''; });
      if (yTickValues) gridAxis.tickValues(yTickValues);
      else gridAxis.ticks(mini ? 4 : 8);
      g.append('g').attr('class', 'grid').call(gridAxis)
        .selectAll('line').attr('stroke', T.grid).attr('stroke-opacity', 0.7);
      g.selectAll('.grid .domain').remove();

      // Axes
      var xAxis = mini ? axisBottom(x).ticks(4) : axisBottom(x).ticks(w > 600 ? 12 : 6);
      g.append('g').attr('transform', 'translate(0,' + h + ')').call(xAxis)
        .selectAll('text').attr('font-family', 'var(--font-heading)').attr('font-size', mini ? '9px' : '11px');

      var yFormat = useLog
        ? function(d: number) {
            if (d >= 1000) return '$' + format(',.0f')(d);
            if (d >= 1) return '$' + d;
            return '$' + d;
          }
        : function(d: number) { return '$' + format(',.0f')(d); };
      var yAxis = axisLeft(y).tickFormat(yFormat as any);
      if (yTickValues) yAxis.tickValues(yTickValues);
      else yAxis.ticks(mini ? 4 : 8);
      g.append('g').call(yAxis)
        .selectAll('text').attr('font-family', 'var(--font-heading)').attr('font-size', mini ? '9px' : '11px');

      // Price line with gradient fill. While animating, draw only up to animEnd
      // so the line grows left-to-right as the x-domain stretches (the reveal).
      var revealPrices = animating
        ? filteredPrices.filter(function(d) { return d.date <= animEnd!; })
        : filteredPrices;
      if (revealPrices.length === 0) revealPrices = filteredPrices.slice(0, 1);

      var area = d3area<PricePoint>()
        .x(function(d) { return x(d.date); })
        .y0(h)
        .y1(function(d) { return y(d.price); })
        .curve(curveMonotoneX);

      var line = d3line<PricePoint>()
        .x(function(d) { return x(d.date); })
        .y(function(d) { return y(d.price); })
        .curve(curveMonotoneX);

      var gradient = svg.append('defs').append('linearGradient')
        .attr('id', chartId + '-gradient')
        .attr('x1', '0').attr('x2', '0').attr('y1', '0').attr('y2', '1');
      gradient.append('stop').attr('offset', '0%').attr('stop-color', T.accent).attr('stop-opacity', 0.3);
      gradient.append('stop').attr('offset', '100%').attr('stop-color', T.accent).attr('stop-opacity', 0.02);

      g.append('path').datum(revealPrices)
        .attr('fill', 'url(#' + chartId + '-gradient)')
        .attr('d', area);

      g.append('path').datum(revealPrices)
        .attr('fill', 'none')
        .attr('stroke', T.accent)
        .attr('stroke-width', mini ? 1.5 : 2)
        .attr('d', line);

      if (mini) {
        // Mini: just show latest price
        var last = filteredPrices[filteredPrices.length - 1];
        g.append('text')
          .attr('x', w - 5).attr('y', 14)
          .attr('text-anchor', 'end')
          .attr('font-family', 'var(--font-heading)')
          .attr('font-size', '14px')
          .attr('font-weight', '700')
          .attr('fill', T.accent)
          .text('$' + format(',.0f')(last.price));
        return;
      }

      // Tooltip (shared by all interactive elements)
      var tooltip = select(container).append('div')
        .attr('class', 'chart-tooltip').style('opacity', 0);

      // Position tooltip, flipping to left/above if near edges
      function positionTooltip(event: MouseEvent) {
        var cRect = container.getBoundingClientRect();
        var tipNode = tooltip.node();
        var tipW = tipNode ? tipNode.offsetWidth || 200 : 200;
        var tipH = tipNode ? tipNode.offsetHeight || 80 : 80;
        var ex = event.offsetX;
        var ey = event.offsetY;
        var left = (ex + 15 + tipW > cRect.width) ? ex - tipW - 15 : ex + 15;
        var top = (ey - 40 < 0) ? ey + 15 : ey - tipH - 10;
        tooltip.style('left', Math.max(0, left) + 'px').style('top', Math.max(0, top) + 'px');
      }

      // --- Layer 1: Halving lines (background) ---
      if (showHalvings) {
        data.halvings.forEach(function(hv) {
          var hvDate = new Date(hv.date);
          if (hvDate < xExtent[0] || hvDate > domEnd) return;
          var hvx = x(hvDate);

          g.append('line')
            .attr('x1', hvx).attr('x2', hvx).attr('y1', 0).attr('y2', h)
            .attr('stroke', T.halving).attr('stroke-width', 1.5)
            .attr('stroke-dasharray', hv.estimated ? '6,4' : 'none')
            .attr('stroke-opacity', 0.6);

          var labelG = g.append('g').attr('transform', 'translate(' + hvx + ',0)');
          labelG.append('rect')
            .attr('x', -40).attr('y', -38).attr('width', 80).attr('height', 16)
            .attr('rx', 3).attr('fill', T.halving).attr('fill-opacity', 0.12);
          labelG.append('text')
            .attr('y', -26).attr('text-anchor', 'middle')
            .attr('font-family', 'var(--font-heading)')
            .attr('font-size', '8px').attr('font-weight', '600')
            .attr('fill', T.halving)
            .text(hv.label);
        });
      }

      // --- Layer 2: Model curves (interactive) ---
      // Skipped during the reveal animation: model labels force getBBox reflows
      // (expensive per frame) and the curves are future projections that only
      // matter at the completed state.
      var modelElements: any[] = [];
      if (showModels && data.models && !animating) {
        var modelLine = d3line<PricePoint>()
          .x(function(d) { return x(d.date); })
          .y(function(d) { return y(Math.max(y.domain()[0], Math.min(y.domain()[1], d.price))); })
          .curve(curveMonotoneX);

        data.models.forEach(function(model: any) {
          var pts: PricePoint[] = model.data
            .map(function(d: any) { return { date: new Date(d.date), price: d.price }; })
            .filter(function(d: PricePoint) { return d.date >= xExtent[0] && d.date <= xExtent[1]; });
          if (pts.length < 2) return;

          // Visible line
          var path = g.append('path').datum(pts)
            .attr('fill', 'none')
            .attr('stroke', model.color)
            .attr('stroke-width', 2)
            .attr('stroke-dasharray', model.id === 'stock-to-flow' ? '8,4' : '6,3')
            .attr('stroke-opacity', 0.55)
            .attr('d', modelLine);

          // Label at end
          var lastPt = pts[pts.length - 1];
          var ly = y(Math.max(y.domain()[0], Math.min(y.domain()[1], lastPt.price)));
          var lx = x(lastPt.date);

          // Determine if label should go left (when near right edge)
          var labelOnLeft = (lx + 4) > (w - 20);
          var labelOffset = labelOnLeft ? -4 : 4;
          var textAnchor = labelOnLeft ? 'end' : 'start';
          var textX = labelOnLeft ? -3 : 3;

          // Background rect for readability — surface colour pulls
          // from the active theme's --color-bg so the label remains
          // legible against the chart fill on dark themes too.
          var labelNode = g.append('g').attr('transform', 'translate(' + (lx + labelOffset) + ',' + ly + ')');
          var labelBg = labelNode.append('rect')
            .attr('rx', 3).attr('fill', T.surface).attr('fill-opacity', 0.85);
          var labelTxt = labelNode.append('text')
            .attr('x', textX).attr('y', 4)
            .attr('text-anchor', textAnchor)
            .attr('font-family', 'var(--font-heading)')
            .attr('font-size', '11px')
            .attr('font-weight', '700')
            .attr('fill', model.color)
            .text(model.name);
          // Size bg rect to text
          var bbox = labelTxt.node()!.getBBox();
          labelBg.attr('x', bbox.x - 2).attr('y', bbox.y - 1)
            .attr('width', bbox.width + 4).attr('height', bbox.height + 2);

          var entry = { path: path, label: labelNode, model: model, pts: pts };
          modelElements.push(entry);

          function highlightModel(event: MouseEvent) {
            // Dim all others
            modelElements.forEach(function(e) {
              if (e === entry) {
                e.path.attr('stroke-width', 3.5).attr('stroke-opacity', 1);
                e.label.select('text').attr('font-size', '13px');
                var bb = e.label.select('text').node()!.getBBox();
                e.label.select('rect').attr('x', bb.x - 2).attr('y', bb.y - 1)
                  .attr('width', bb.width + 4).attr('height', bb.height + 2);
              } else {
                e.path.attr('stroke-opacity', 0.15);
                e.label.attr('opacity', 0.2);
              }
            });
            // Show tooltip with model details
            tooltip.html(
              '<strong style="color:' + model.color + '">' + model.name + '</strong><br>' +
              '<span style="font-size:0.78em">' + model.description + '</span>'
            ).style('opacity', 1);
            positionTooltip(event);
          }

          function unhighlightModel() {
            modelElements.forEach(function(e) {
              e.path.attr('stroke-width', 2).attr('stroke-opacity', 0.55);
              e.label.attr('opacity', 1);
              e.label.select('text').attr('font-size', '11px');
              var bb = e.label.select('text').node()!.getBBox();
              e.label.select('rect').attr('x', bb.x - 2).attr('y', bb.y - 1)
                .attr('width', bb.width + 4).attr('height', bb.height + 2);
            });
            tooltip.style('opacity', 0);
          }

          labelNode.style('cursor', 'pointer')
            .on('mouseover', highlightModel).on('mousemove', function(event) {
              positionTooltip(event);
            }).on('mouseout', unhighlightModel);
        });

        // Resolve overlapping model labels
        if (modelElements.length > 1) {
          var minGap = 16; // minimum vertical gap in px
          // Extract current Y positions from transform
          var labelPositions = modelElements.map(function(e) {
            var t = e.label.attr('transform');
            var m = t.match(/translate\(\s*([\d.e+-]+)\s*,\s*([\d.e+-]+)\s*\)/);
            return { el: e, tx: parseFloat(m[1]), ty: parseFloat(m[2]) };
          });
          // Sort by Y position
          labelPositions.sort(function(a, b) { return a.ty - b.ty; });
          // Push overlapping labels apart
          for (var li = 1; li < labelPositions.length; li++) {
            var gap = labelPositions[li].ty - labelPositions[li - 1].ty;
            if (gap < minGap) {
              var shift = minGap - gap;
              labelPositions[li].ty += shift;
            }
          }
          // Apply adjusted positions
          labelPositions.forEach(function(lp) {
            lp.el.label.attr('transform', 'translate(' + lp.tx + ',' + lp.ty + ')');
          });
        }
      }

      // --- Layer 3: Prediction dashed lines (background) ---
      if (showPredictions) {
        data.predictions.forEach(function(pred: any) {
          var predDate = new Date(pred.date);
          var targetDate = new Date(pred.targetDate);
          if (targetDate < xExtent[0] || predDate > domEnd) return;

          var targetY = y(Math.max(y.domain()[0], Math.min(y.domain()[1], pred.targetPrice)));
          var targetX = x(Math.min(targetDate.getTime(), domEnd.getTime()));
          var predX = x(Math.max(predDate.getTime(), xExtent[0].getTime()));

          var isFuture = pred.hit === null;
          var color = pred.bearish ? T.predBearish : isFuture ? T.predPending : pred.hit ? T.predHit : T.predMissed;

          g.append('line')
            .attr('x1', predX).attr('y1', targetY)
            .attr('x2', targetX).attr('y2', targetY)
            .attr('stroke', color).attr('stroke-width', 1)
            .attr('stroke-dasharray', '4,3').attr('stroke-opacity', 0.4);
        });
      }

      // --- Layer 3: Price crosshair + hover (below markers) — skipped during the reveal ---
      if (!animating) {
      var bisect = bisector<PricePoint, Date>(function(d) { return d.date; }).left;
      var focusLine = g.append('line')
        .attr('stroke', T.accent).attr('stroke-opacity', 0.4)
        .attr('stroke-width', 1).attr('stroke-dasharray', '4,3')
        .attr('y1', 0).attr('y2', h).style('opacity', 0);
      var focusDot = g.append('circle')
        .attr('r', 4).attr('fill', T.accent).attr('stroke', T.surface).attr('stroke-width', 2)
        .style('opacity', 0);

      // Invisible rect for price hover — pointer-events: all but sits below markers
      var hoverRect = g.append('rect').attr('width', w).attr('height', h)
        .attr('fill', 'transparent')
        .on('mousemove', function(this: SVGRectElement, event: MouseEvent) {
          var coords = pointer(event, this);
          var xDate = x.invert(coords[0]);
          var idx = bisect(filteredPrices, xDate, 1);
          var d0 = filteredPrices[idx - 1];
          var d1 = filteredPrices[idx] || d0;
          var d = (xDate.getTime() - d0.date.getTime() > d1.date.getTime() - xDate.getTime()) ? d1 : d0;

          focusLine.attr('x1', x(d.date)).attr('x2', x(d.date)).style('opacity', 1);
          focusDot.attr('cx', x(d.date)).attr('cy', y(d.price)).style('opacity', 1);

          var dateStr = d.date.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });
          tooltip.html('<strong>$' + format(',.2f')(d.price) + '</strong><br>' + dateStr)
            .style('opacity', 1)
          positionTooltip(event);
        })
        .on('mouseout', function() {
          focusLine.style('opacity', 0);
          focusDot.style('opacity', 0);
          tooltip.style('opacity', 0);
        });
      }

      // --- Layer 4: Event markers (above hover rect) ---
      if (showEvents) {
        var eventPriceMap: Record<string, number> = {};
        filteredPrices.forEach(function(d) {
          eventPriceMap[d.date.toISOString().slice(0, 10)] = d.price;
        });

        data.events.forEach(function(ev: any) {
          var evDate = new Date(ev.date);
          if (evDate < xExtent[0] || evDate > domEnd) return;

          var evDateStr = ev.date;
          var closestPrice = eventPriceMap[evDateStr];
          if (!closestPrice) {
            var nearest = filteredPrices.reduce(function(best, d) {
              var diff = Math.abs(d.date.getTime() - evDate.getTime());
              return diff < best.diff ? { diff: diff, price: d.price } : best;
            }, { diff: Infinity, price: 0 });
            closestPrice = nearest.price;
          }
          if (!closestPrice || closestPrice <= 0) return;

          var evx = x(evDate);
          var evy = y(closestPrice);
          var color = ev.type === 'crash' ? T.eventCrash : ev.type === 'regulation' ? T.eventRegulation : T.eventOther;

          var marker = g.append('g')
            .attr('transform', 'translate(' + evx + ',' + evy + ')')
            .style('cursor', 'pointer');

          marker.append('circle')
            .attr('r', 6).attr('fill', color).attr('stroke', T.surface).attr('stroke-width', 1.5)
            .attr('fill-opacity', 0.9);

          marker.on('mouseover', function(this: SVGGElement, event: MouseEvent) {
            select(this).select('circle').attr('r', 8);
            tooltip.html(
              '<strong>' + ev.label + '</strong><br>' +
              evDate.toLocaleDateString(lang === 'ja' ? 'ja-JP' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' }) +
              '<br>$' + format(',.0f')(closestPrice)
            )
            .style('opacity', 1)
          positionTooltip(event);
          })
          .on('mouseout', function(this: SVGGElement) {
            select(this).select('circle').attr('r', 6);
            tooltip.style('opacity', 0);
          });
        });
      }

      // --- Layer 5: Prediction markers with labels (topmost) ---
      if (showPredictions) {
        // Collect prediction markers for overlap avoidance
        var predMarkers: Array<{ pred: any; x: number; y: number; color: string }> = [];

        data.predictions.forEach(function(pred: any) {
          var predDate = new Date(pred.date);
          var targetDate = new Date(pred.targetDate);
          if (targetDate < xExtent[0] || predDate > domEnd) return;

          var targetPrice = pred.targetPrice;
          var targetY = y(Math.max(y.domain()[0], Math.min(y.domain()[1], targetPrice)));
          var targetX = x(Math.min(targetDate.getTime(), domEnd.getTime()));

          var isFuture = pred.hit === null;
          var color = pred.bearish ? T.predBearish : isFuture ? T.predPending : pred.hit ? T.predHit : T.predMissed;

          predMarkers.push({ pred: pred, x: targetX, y: targetY, color: color });
        });

        // Sort by x position to stagger overlapping labels
        predMarkers.sort(function(a, b) { return a.x - b.x; });

        predMarkers.forEach(function(pm, idx) {
          var markerG = g.append('g')
            .attr('transform', 'translate(' + pm.x + ',' + pm.y + ')')
            .style('cursor', 'pointer');

          // Larger diamond marker — surface stroke for halo effect.
          markerG.append('rect')
            .attr('x', -5).attr('y', -5).attr('width', 10).attr('height', 10)
            .attr('rx', 2).attr('fill', pm.color).attr('stroke', T.surface).attr('stroke-width', 1.5)
            .attr('fill-opacity', 0.9)
            .attr('transform', 'rotate(45)');

          // Name label — alternate above/below to reduce overlap
          var labelText = pm.pred.predictor.split(' ').pop();
          var above = (idx % 2 === 0);
          var labelDy = above ? -12 : 16;

          markerG.append('text')
            .attr('x', 0).attr('y', labelDy)
            .attr('text-anchor', 'middle')
            .attr('font-family', 'var(--font-heading)')
            .attr('font-size', '8px')
            .attr('font-weight', '600')
            .attr('fill', pm.color)
            .attr('fill-opacity', 0.8)
            .style('pointer-events', 'none')
            .text(labelText);

          // Hover: show full details
          markerG.on('mouseover', function(event) {
            select(this).select('rect').attr('width', 12).attr('height', 12).attr('x', -6).attr('y', -6);
            var pred = pm.pred;
            var html = '<strong>' + pred.predictor + '</strong><br>';
            html += '"' + pred.quote + '"<br>';
            html += labels.target + ': ' + pred.targetPriceLabel + ' (' + pred.targetDate.slice(0, 7) + ')';
            if (pred.actualPriceLabel) {
              html += '<br>' + labels.actual + ': ' + pred.actualPriceLabel;
            }

            tooltip.html(html).style('opacity', 1);
            positionTooltip(event);
          })
          .on('mouseout', function() {
            select(this).select('rect').attr('width', 10).attr('height', 10).attr('x', -5).attr('y', -5);
            tooltip.style('opacity', 0);
          });
        });
      }

      // --- Layer 6: Model hit areas & labels (topmost for reliable hover) ---
      if (showModels) {
        modelElements.forEach(function(entry) {
          // Re-append label to bring it to top
          entry.label.raise();

          // Add hit path on top of everything
          var hitPath = g.append('path').datum(entry.pts)
            .attr('fill', 'none')
            .attr('stroke', 'transparent')
            .attr('stroke-width', 14)
            .attr('d', modelLine)
            .style('cursor', 'pointer');

          hitPath.on('mouseover', function(event) {
            modelElements.forEach(function(e) {
              if (e === entry) {
                e.path.attr('stroke-width', 3.5).attr('stroke-opacity', 1);
                e.label.select('text').attr('font-size', '13px');
                var bb = e.label.select('text').node().getBBox();
                e.label.select('rect').attr('x', bb.x - 2).attr('y', bb.y - 1)
                  .attr('width', bb.width + 4).attr('height', bb.height + 2);
              } else {
                e.path.attr('stroke-opacity', 0.15);
                e.label.attr('opacity', 0.2);
              }
            });
            tooltip.html(
              '<strong style="color:' + entry.model.color + '">' + entry.model.name + '</strong><br>' +
              '<span style="font-size:0.78em">' + entry.model.description + '</span>'
            ).style('opacity', 1);
            positionTooltip(event);
          }).on('mousemove', function(event) {
            positionTooltip(event);
          }).on('mouseout', function() {
            modelElements.forEach(function(e) {
              e.path.attr('stroke-width', 2).attr('stroke-opacity', 0.55);
              e.label.attr('opacity', 1);
              e.label.select('text').attr('font-size', '11px');
              var bb = e.label.select('text').node().getBBox();
              e.label.select('rect').attr('x', bb.x - 2).attr('y', bb.y - 1)
                .attr('width', bb.width + 4).attr('height', bb.height + 2);
            });
            tooltip.style('opacity', 0);
          });
        });
      }
    }

    draw();

    // Controls (full chart only)
    if (!mini) {
      // Asserted non-null: this branch only runs for the full (non-mini)
      // chart, whose markup (see the frontmatter above) always wraps the
      // container in `.btc-chart-wrapper`.
      var wrapper = container.parentElement as HTMLElement;

      // Toggle buttons
      wrapper.querySelectorAll('[data-toggle]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          btn.classList.toggle('active');
          var key = btn.getAttribute('data-toggle');
          if (key === 'halvings') showHalvings = btn.classList.contains('active');
          if (key === 'events') showEvents = btn.classList.contains('active');
          if (key === 'predictions') showPredictions = btn.classList.contains('active');
          if (key === 'models') showModels = btn.classList.contains('active');
          draw();
        });
      });

      // Scale buttons
      wrapper.querySelectorAll('[data-scale]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          wrapper.querySelectorAll('[data-scale]').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          useLog = btn.getAttribute('data-scale') === 'log';
          draw();
        });
      });

      // Range buttons
      wrapper.querySelectorAll('[data-range]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          wrapper.querySelectorAll('[data-range]').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          rangeMode = btn.getAttribute('data-range') || 'all';
          draw();
        });
      });

      // Reveal animation: stretch the x-domain from the first date to the full
      // span (incl. model projection) and play once on scroll-in (shared runtime A,
      // public/scripts/chart-anim.js). Halvings, events and predictions surface as
      // the time cursor sweeps past their date.
      function play() {
        if (!window.BAChartAnim || !fullExtent) return;
        var t0 = fullExtent[0].getTime();
        var t1 = fullExtent[1].getTime();
        if (!(t1 > t0)) return;
        replayFn = window.BAChartAnim!.playOnScroll(container, {
          duration: 5200,
          onFrame: function(p: number) {
            if (p >= 1) { draw(); return; }
            var frac = Math.pow(p, 1.25); // ease: linger on the long, flat early years
            draw(new Date(t0 + frac * (t1 - t0)));
          },
        });
      }
      (function arm(n?: number) {
        if (window.BAChartAnim && fullExtent) play();
        else if ((n || 0) < 40) setTimeout(function() { arm((n || 0) + 1); }, 50);
      })();

      // Replay button — re-run the reveal
      var replayBtn = wrapper.querySelector('[data-replay]');
      if (replayBtn) replayBtn.addEventListener('click', function() { if (replayFn) replayFn(); });
    }

    // Resize
    var resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() { draw(); }, 250);
    });

    // Theme/mode listeners — repaint when data-theme/data-mode flips
    // or the OS prefers-color-scheme changes. draw() already wipes
    // container.innerHTML so no SVG accumulation.
    if (typeof window.matchMedia === 'function') {
      var mql = window.matchMedia('(prefers-color-scheme: dark)');
      // Wrap so the event object is not passed as draw()'s animEnd argument.
      if (mql.addEventListener) mql.addEventListener('change', function() { draw(); });
      else if (mql.addListener) mql.addListener(function() { draw(); });
    }
    if (typeof MutationObserver === 'function') {
      new MutationObserver(function() { draw(); }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-mode', 'data-theme'],
      });
    }
  }
})();
</script>

<style>
  .btc-chart-wrapper {
    position: relative;
  }
  .btc-chart-wrapper.mini {
    cursor: pointer;
  }
  .chart-container {
    position: relative;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container.mini {
    border-radius: 6px;
  }
  .chart-container :global(svg) {
    display: block;
  }
  .chart-container :global(.chart-tooltip) {
    position: absolute;
    pointer-events: none;
    /* Slightly transparent surface so price line under the tooltip
       remains visible. --color-bg follows the theme; the rgba
       version below comes from a `color-mix` fallback chain so
       browsers without color-mix() still see a solid surface. */
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    z-index: 10;
    max-width: 320px;
    opacity: 0.96;
  }

  /* Controls */
  .chart-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
  }
  .chart-toggles {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: all 0.15s;
    user-select: none;
  }
  .toggle-btn:hover { background: var(--color-accent-bg); }
  .toggle-btn.active { color: var(--color-text); font-weight: 600; }
  .toggle-btn:not(.active) { opacity: 0.5; text-decoration: line-through; }

  .toggle-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  /* Toggle-legend swatches mirror the runtime palette resolved in
     readTokens(): chart-color-1 (halving) / chart-positive (events) /
     chart-color-4 (predictions) / chart-color-4 (models). Models
     reuse chart-color-4 since the per-curve hue lives in the data. */
  .halving-dot { background: var(--chart-color-1); }
  .event-dot { background: var(--chart-positive); }
  .prediction-dot { background: var(--chart-color-4); }
  .model-dot { background: var(--chart-color-4); }

  .chart-scale-btns, .chart-range-btns {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .scale-btn, .range-btn {
    padding: 0.25rem 0.6rem;
    border: none;
    background: transparent;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: all 0.15s;
  }
  .scale-btn:hover, .range-btn:hover {
    background: var(--color-accent-bg);
  }
  .scale-btn.active, .range-btn.active {
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 600;
  }
  .scale-btn + .scale-btn, .range-btn + .range-btn {
    border-left: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .chart-controls {
      gap: 0.5rem;
    }
  }
</style>
