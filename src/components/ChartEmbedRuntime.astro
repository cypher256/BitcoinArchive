---
// In-body chart runtime (was public/scripts/chart-embeds.js): scans
// `.chart-embed[data-chart]` placeholders and fills each with a registered
// drawer. Real Astro-processed module script, so d3 usage tree-shakes to
// ~10KB instead of a ~92KB CDN bundle -- see chart-embed-runtime.ts.
---
<script>
// Dynamic import (not static) -- see this file's counterpart .ts for why.
// Guarded so pages without a chart-embed placeholder fetch nothing extra.
if (document.querySelector('.chart-embed[data-chart]')) import('../scripts/chart-embed-runtime.ts');
</script>
