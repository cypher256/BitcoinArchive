---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  raceId: string;
}

const { lang, raceId } = Astro.props;

// One component, many races: each race's data + bilingual labels live in a JSON
// under src/data/races/. The drawing runtime (d3-based) lives in the shared
// module src/scripts/bar-chart-race.js. Add a race = add a JSON + inject
// <BarChartRace raceId=.../>.
const races = import.meta.glob('../data/races/*.json', { eager: true });
const race = (races[`../data/races/${raceId}.json`] as any)?.default;
if (!race) throw new Error(`BarChartRace: no race data for "${raceId}"`);

// Fixed USD->JPY display rate for the JA edition. Defined ONCE here, then used
// both for the on-chart note text and (via chartData.jpyRate) for the value
// formatting in the runtime — so the rate can never drift between the two.
const JPY_PER_USD = 160;
const isJa = lang === 'ja';

// Races are USD-denominated by default; a race JSON may declare `unit: "btc"`
// to have values formatted as BTC quantities instead (no USD->JPY conversion
// applies, so the fixed-rate note suffix is skipped for such races).
const isBtc = race.unit === 'btc';
const l = race.labels[lang];
const series = race.series.map((s: any) => ({ name: s.name[lang], colorToken: s.colorToken, values: s.values }));
const chartData = {
  dates: race.dates,
  series,
  topN: race.topN || 8,
  format: isBtc ? (isJa ? 'btc-ja' : 'btc') : (isJa ? 'jpy' : 'usd-b'),
  jpyRate: !isBtc && isJa ? JPY_PER_USD : null,
};
const containerId = `race-${raceId}`;
const note = !isBtc && isJa ? `${l.note}（1ドル＝${JPY_PER_USD}円の固定換算。各年の実勢レートではない）` : l.note;
---

<div class="ba-race">
  <h3 class="ba-race-title">{l.title}</h3>
  <p class="ba-race-sub">{l.subtitle}</p>
  {race.related && race.related.length > 0 ? (
    <div class="ba-race-toolbar">
      <p class="ba-race-related">{lang === 'ja' ? '関連レース: ' : 'Related races: '}{race.related.map((r: any, i: number) => (
        <Fragment>{i > 0 ? ' · ' : ''}<a href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${lang === 'ja' ? 'ja/' : ''}entries/${r.entry}/#${r.anchor}`}>{r.label[lang]}</a></Fragment>
      ))}</p>
      <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    </div>
  ) : (
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
  )}
  <div id={containerId} class="ba-race-chart"></div>
  <p class="ba-race-note">{note}</p>
  <script type="application/json" id={`${containerId}-data`} set:html={JSON.stringify(chartData)} />
  <script type="application/json" id="ba-race-meta" set:html={JSON.stringify({ containerId })} />
</div>

<script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>

<script>
// The drawing logic lives in the shared module src/scripts/bar-chart-race.js
// (one implementation, also used by the in-body ChartEmbedRuntime
// `holders-race` drawer). This script only wires the JSON data blocks emitted
// above into that shared mount(). chart-anim.js stays an external classic
// <script src> — it runs during initial HTML parsing, before this deferred
// module executes, so window.BAChartAnim is already defined by mount time.
import { mount } from '../scripts/bar-chart-race.js';

(function() {
  var metaEl = document.getElementById('ba-race-meta') as HTMLElement | null;
  if (!metaEl) return;
  var meta = JSON.parse(metaEl.textContent as string) as { containerId: string };
  var containerId = meta.containerId;

  var container = document.getElementById(containerId) as HTMLElement | null;
  var dataEl = document.getElementById(containerId + '-data') as HTMLElement | null;
  if (!container || !dataEl) return;
  var data = JSON.parse(dataEl.textContent as string) as {
    dates: number[];
    series: { name: string; colorToken?: string; values: number[] }[];
    topN?: number;
    format?: string;
    jpyRate?: number | null;
  };
  var wrap = container.closest('.ba-race');

  mount(container, {
    dates: data.dates,
    series: data.series,
    topN: data.topN,
    format: data.format,
    jpyRate: data.jpyRate,
    replayBtn: wrap ? wrap.querySelector('[data-replay]') : null,
  });
})();
</script>

<style>
  .ba-race {
    margin: var(--rhythm-block) 0;
  }
  .ba-race-title {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .ba-race-sub {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  /* Shares a row with the replay button when both are present (see
     .ba-race-toolbar below) — there is horizontal room for a short related-
     races line plus a small right-aligned button on any but the narrowest
     viewports, so merging them onto one line removes an entire stacked
     block's worth of vertical whitespace above the chart. flex-wrap lets the
     button drop to its own line below when the combined width doesn't fit,
     so no fixed breakpoint is needed. */
  .ba-race-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.2rem 0.8rem;
    margin-top: -0.6rem;
    margin-bottom: 0.6rem;
  }
  .ba-race-toolbar .ba-replay-controls {
    margin-bottom: 0;
  }
  .ba-race-related {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .ba-race-chart {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
    padding: 0.5rem 0;
  }
  .ba-race-chart :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ba-race-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.6rem;
  }
</style>
