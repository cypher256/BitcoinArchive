---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import { useTranslations, getDisplayEntries, absoluteUrl, findAuthorParticipant } from '../../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../../data/threads';
import { existsSync, readFileSync } from 'fs';
import { join } from 'path';

const lang = 'ja';
const t = useTranslations(lang);
const jaEntries = await getDisplayEntries(lang);
const enEntries = await getDisplayEntries('en');
const entries = jaEntries.length > 0 ? jaEntries : enEntries;
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);
const displayEntries = collapseThreads(entries, threadCounts, threadStarters).reverse();

// 絞り込みメニュー用のファセット集計。表示されるカード (スレッド/単独で 1 枚)
// に対して数えるので、件数は実際の一覧と一致する。
const typeCounts = new Map<string, number>();
const sourceCounts = new Map<string, number>();
for (const entry of displayEntries) {
  typeCounts.set(entry.data.type, (typeCounts.get(entry.data.type) || 0) + 1);
  sourceCounts.set(entry.data.source, (sourceCounts.get(entry.data.source) || 0) + 1);
}
const typeFacets = Array.from(typeCounts.entries()).sort((a, b) => b[1] - a[1]);
const sourceFacets = Array.from(sourceCounts.entries()).sort((a, b) => b[1] - a[1]);

// 著者名 → 参加者 slug。クライアント側の全文検索結果カードが一覧カードと
// 同じアバターを描けるようにする (Algolia 索引は著者名のみ保持)。editorial 型は
// クライアント側で 'bitcoin-institute' に解決する。
const authorToSlug: Record<string, string> = {};
for (const e of entries) {
  const a = (e.data as any).author;
  if (!a || authorToSlug[a] !== undefined) continue;
  if (['article', 'analysis', 'design'].includes((e.data as any).type)) continue;
  const ap = findAuthorParticipant(a, (e.data as any).participants || []);
  if (ap && ap.slug) authorToSlug[a] = ap.slug;
}

// Load git dates (generated at build time). git-dates.json keys each entry by id
// and stores per-language records (en / ja). EN and JA are usually edited together
// so the two updatedAt values are typically identical, but they diverge legitimately
// when only one side is touched (e.g. a JA-only translation pass) — each language
// page reads its own record so the displayed date reflects what was actually edited
// in that language.
const gitDatesPath = join(process.cwd(), 'src/data/git-dates.json');
type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDates: Record<string, GitDateRecord> = existsSync(gitDatesPath)
  ? JSON.parse(readFileSync(gitDatesPath, 'utf-8'))
  : {};
const hasGitDates = Object.keys(gitDates).length > 0;
const pageDescription = "サトシ・ナカモトと初期ビットコイン貢献者によるコミュニケーションの完全な時系列アーカイブ。フォーラム投稿、メーリングリスト、私信、一次資料を、原典を保持した形で収録。";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.entries')} - ${t('site.title')}`,
  "url": absoluteUrl('/entries/', lang),
  "description": pageDescription,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.entries'),
    "numberOfItems": displayEntries.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": displayEntries.slice(0, 25).map((entry: any, index: number) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      const itemUrl = isThread
        ? absoluteUrl(`/entries/threads/${tid}/`, lang)
        : absoluteUrl(`/entries/${entry.id}/`, lang);
      const itemName = isThread
        ? (threadTitles.get(tid!) || entry.data.title)
        : entry.data.title;
      return {
        "@type": "ListItem",
        "position": index + 1,
        "url": itemUrl,
        "name": itemName,
      };
    }),
  },
};
---

<BaseLayout
  title={`${t('nav.entries')} - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateEn={absoluteUrl('/entries/', 'en')}
  structuredData={structuredData}
>
  <div class="container-wide">
    <h1>{t('nav.entries')}</h1>
    <p class="page-lead">このアーカイブの全一次資料。入力すると本文を全文検索、種類・ソース・サトシで絞り込み、並べ替えも — すべてこのページの 1 つの一覧で行えます。</p>

    <div class="browse-toolbar">
      <form id="search-form" class="browse-searchform" role="search">
        <input
          type="search"
          id="entry-filter"
          class="browse-search"
          placeholder="本文を全文検索 — 人名・語句・本文中のことばで…"
          autocomplete="off"
          aria-label="全エントリーの本文を全文検索"
        />
      </form>
      <div class="browse-row">
        <div class="facet-group">
          <details class="facet">
            <summary>種類<span class="facet-badge" data-badge="type" hidden></span><span class="facet-chevron" aria-hidden="true">▾</span></summary>
            <div class="facet-menu">
              {typeFacets.map(([type, count]) => (
                <label class="facet-opt">
                  <input type="checkbox" class="facet-check" data-facet="type" value={type} />
                  <span class="facet-label">{t(`type.${type}` as any) || type}</span>
                  <span class="facet-count">{count}</span>
                </label>
              ))}
            </div>
          </details>
          <details class="facet">
            <summary>ソース<span class="facet-badge" data-badge="source" hidden></span><span class="facet-chevron" aria-hidden="true">▾</span></summary>
            <div class="facet-menu">
              {sourceFacets.map(([source, count]) => (
                <label class="facet-opt">
                  <input type="checkbox" class="facet-check" data-facet="source" value={source} />
                  <span class="facet-label">{t(`source.${source}` as any) || source}</span>
                  <span class="facet-count">{count}</span>
                </label>
              ))}
            </div>
          </details>
          <label class="facet-toggle">
            <input type="checkbox" id="satoshi-only" />
            <span>サトシのみ</span>
          </label>
        </div>
        <div class="sort-controls" id="sort-controls">
          <button class="sort-btn active" data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
          {hasGitDates && (
            <>
              <button class="sort-btn" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
              <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="browse-status">
      <p class="entry-count"><span id="result-count">{displayEntries.length}</span><span id="count-unit"> 件</span></p>
      <button type="button" id="clear-filters" class="clear-filters" hidden>絞り込みを解除</button>
    </div>

    <div id="entries-list">
      {displayEntries.map((entry: any) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        const gd = gitDates[entry.id]?.ja ?? gitDates[entry.id]?.en;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            entryType={entry.data.type}
            tags={entry.data.tags}
            createdAt={gd?.createdAt}
            updatedAt={gd?.updatedAt}
          />
        );
      })}
    </div>
    <!-- 検索結果 (Algolia 本文全文) はここに描画。一覧と同じカード見た目。 -->
    <div id="search-results"></div>
    <div class="browse-more">
      <button type="button" id="show-more" class="show-more" hidden>もっと見る</button>
      <p id="no-results" class="no-results" hidden>一致するものがありません。語数を減らすか絞り込みを解除してください。</p>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
<script is:inline define:vars={{ basePath: import.meta.env.BASE_URL.replace(/\/$/, ''), indexName: 'bitcoin_archive_ja', locale: 'ja', authorToSlug }}>
(function() {
  // ONE list, ONE set of controls — no modes, no seams.
  //   • Empty box  → browse the SSR cards (filter + sort + paginate, no Algolia).
  //   • Typing     → full-text search via Algolia: fetch ALL matches in one
  //                  request, then the SAME facets (sent as facetFilters) and the
  //                  SAME sort (applied client-side over the fetched hits) keep
  //                  working. So Type/Source/Satoshi AND sort affect the results
  //                  in both states; nothing visible is ever inert.
  var BROWSE_PAGE = 60;
  var FT_FETCH = 1000;
  var MIN = 2;
  var SORT_KEY = 'entries-sort';

  var list = document.getElementById('entries-list');
  var cards = list ? Array.prototype.slice.call(list.querySelectorAll('.entry-card')) : [];
  var input = document.getElementById('entry-filter');
  var form = document.getElementById('search-form');
  var facetChecks = Array.prototype.slice.call(document.querySelectorAll('.facet-check'));
  var satoshiOnly = document.getElementById('satoshi-only');
  var sortBtns = Array.prototype.slice.call(document.querySelectorAll('.sort-btn'));
  var resultCount = document.getElementById('result-count');
  var countUnit = document.getElementById('count-unit');
  var showMore = document.getElementById('show-more');
  var noResults = document.getElementById('no-results');
  var clearBtn = document.getElementById('clear-filters');
  var searchResults = document.getElementById('search-results');
  if (!list || !input) return;

  var L = locale === 'ja';
  var shown = BROWSE_PAGE;
  var sortState = { key: 'date', order: 'desc' };
  var algolia = (typeof algoliasearch !== 'undefined')
    ? algoliasearch('FI2GZVF3TY', 'c0328bda37db1cc886aacffb2aed5425') : null;
  var hits = null, nbHits = 0;
  var debounceTimer = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  function selectedFacet(facet) {
    var set = {};
    facetChecks.forEach(function(c) { if (c.dataset.facet === facet && c.checked) set[c.value] = true; });
    return set;
  }
  function isEmpty(o) { for (var k in o) { return false; } return true; }
  function anyRefinement() {
    return !isEmpty(selectedFacet('type')) || !isEmpty(selectedFacet('source')) || !!(satoshiOnly && satoshiOnly.checked);
  }

  function sortLabel(b) { return b.textContent.replace(/\s*[↑↓]$/, ''); }
  function valOf(rec, k) {
    if (k === 'created') return rec.createdTs || rec.dataset && rec.dataset.created || rec.date || '';
    if (k === 'updated') return rec.updatedTs || rec.dataset && rec.dataset.updated || rec.date || '';
    return (rec.dataset && rec.dataset.date) || rec.date || '';
  }
  function cmp(a, b) {
    var av = String(valOf(a, sortState.key)), bv = String(valOf(b, sortState.key));
    return sortState.order === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
  }

  function matchBrowse(card, types, sources, sat) {
    if (sat && card.dataset.satoshi !== '1') return false;
    if (!isEmpty(types) && !types[card.dataset.type]) return false;
    if (!isEmpty(sources) && !sources[card.dataset.source]) return false;
    return true;
  }
  function renderBrowse() {
    var types = selectedFacet('type'), sources = selectedFacet('source'), sat = !!(satoshiOnly && satoshiOnly.checked);
    var matching = [];
    cards.forEach(function(card) {
      var ok = matchBrowse(card, types, sources, sat);
      card.classList.toggle('filtered-out', !ok);
      if (ok) matching.push(card);
    });
    matching.sort(cmp);
    matching.forEach(function(c) { list.appendChild(c); });
    matching.forEach(function(c, i) { c.classList.toggle('paged-out', i >= shown); });
    resultCount.textContent = String(matching.length);
    if (countUnit) countUnit.textContent = L ? ' 件' : (matching.length === 1 ? ' entry' : ' entries');
    showMore.hidden = matching.length <= shown;
    noResults.hidden = matching.length !== 0;
  }

  function facetFilters() {
    var f = [];
    var tk = Object.keys(selectedFacet('type')); if (tk.length) f.push(tk.map(function(t) { return 'type:' + t; }));
    var sk = Object.keys(selectedFacet('source')); if (sk.length) f.push(sk.map(function(s) { return 'source:' + s; }));
    if (satoshiOnly && satoshiOnly.checked) f.push(['isSatoshi:true']);
    return f;
  }
  function hitCard(h) {
    var hr = h._highlightResult || {}, sr = h._snippetResult || {};
    // Merge adjacent <mark> runs (kuromoji wraps each Japanese morpheme in its
    // own <mark>) into one continuous highlight, so a matched phrase reads as a
    // single block instead of a string of fragmented marks.
    var title = ((hr.title && hr.title.value) || esc(h.title)).replace(/<\/mark>\s*<mark>/g, '');
    var snip = ((sr.body && sr.body.value) || '').replace(/<\/mark>\s*<mark>/g, '');
    var isSat = h.author && String(h.author).toLowerCase() === 'satoshi nakamoto';
    var meta = '<span class="ft-author' + (isSat ? ' satoshi' : '') + '">' + esc(h.author) + '</span>';
    if (h.date) meta += ' · ' + new Date(h.date).toLocaleDateString(L ? 'ja-JP' : 'en-US');
    var avSlug = (h.type === 'article' || h.type === 'analysis' || h.type === 'design')
      ? 'bitcoin-institute' : (authorToSlug[h.author] || '');
    var avatar = !avSlug ? ''
      : avSlug === 'satoshi-nakamoto'
        ? '<span class="avatar card-author-avatar satoshi-av" aria-hidden="true">SN</span>'
        : '<img class="avatar card-author-avatar" src="' + basePath + '/avatars/' + avSlug + '.png" alt="" width="24" height="24" loading="lazy" />';
    return '<a class="ft-hit" href="' + basePath + h.url + '">'
      + '<div class="ft-title-row">' + avatar + '<span class="ft-title">' + title + '</span></div>'
      + '<div class="ft-meta">' + meta + '</div>'
      + (snip ? '<div class="ft-snippet">' + snip + '</div>' : '')
      + '</a>';
  }
  function renderSearch() {
    if (!hits) return;
    var sorted = hits.slice().sort(cmp);
    var page = sorted.slice(0, shown);
    searchResults.innerHTML = page.length ? page.map(hitCard).join('') : '';
    resultCount.textContent = String(nbHits);
    var capped = nbHits > hits.length;
    if (countUnit) countUnit.textContent = L
      ? (capped ? ' 件（本文検索・上位 ' + hits.length + ' 件を表示）' : ' 件（本文検索）')
      : (capped ? ' results (showing first ' + hits.length + ')' : (nbHits === 1 ? ' full-text result' : ' full-text results'));
    showMore.hidden = hits.length <= shown;
    noResults.hidden = nbHits !== 0;
  }
  function fetchSearch(q) {
    var ff = JSON.stringify(facetFilters());
    // Serve from the per-tab cache when the same query + refinements were just
    // run — so Back from a result (or re-typing the same word) renders instantly
    // without spending another Algolia request.
    try {
      var c = JSON.parse(sessionStorage.getItem('ftcache:' + indexName) || 'null');
      if (c && c.q === q && c.ff === ff) { hits = c.hits; nbHits = c.nbHits; renderSearch(); return; }
    } catch (e) {}
    if (!algolia) { hits = []; renderSearch(); return; }
    algolia.search([{ indexName: indexName, query: q, params: {
      hitsPerPage: FT_FETCH, facetFilters: facetFilters(),
      attributesToSnippet: ['body:35'], highlightPreTag: '<mark>', highlightPostTag: '</mark>', snippetEllipsisText: '…'
    } }]).then(function(r) {
      hits = r.results[0].hits || [];
      nbHits = r.results[0].nbHits || hits.length;
      try { sessionStorage.setItem('ftcache:' + indexName, JSON.stringify({ q: q, ff: ff, hits: hits, nbHits: nbHits })); } catch (e) {}
      renderSearch();
    }).catch(function() {
      hits = [];
      searchResults.innerHTML = '<p class="no-results">' + (L ? '検索でエラーが発生しました。' : 'Search error.') + '</p>';
      resultCount.textContent = '0';
    });
  }

  function setMode(searching) {
    list.hidden = searching;
    searchResults.hidden = !searching;
  }
  function update() {
    var q = input.value.trim();
    // Keep the query in the URL so Back / refresh / bookmark restore the search.
    try { history.replaceState(null, '', q ? (location.pathname + '?q=' + encodeURIComponent(q)) : location.pathname); } catch (e) {}
    if (clearBtn) clearBtn.hidden = !(q || anyRefinement());
    document.querySelectorAll('[data-badge]').forEach(function(b) {
      var f = b.getAttribute('data-badge');
      var n = Object.keys(selectedFacet(f)).length;
      if (n > 0) { b.textContent = ' (' + n + ')'; b.hidden = false; } else b.hidden = true;
    });
    if (q.length >= MIN) {
      setMode(true);
      searchResults.innerHTML = '<p class="no-results">' + (L ? '検索中…' : 'Searching…') + '</p>';
      fetchSearch(q);
    } else {
      hits = null;
      setMode(false);
      renderBrowse();
    }
  }
  function resetAndUpdate() { shown = BROWSE_PAGE; update(); }
  function debounced() { clearTimeout(debounceTimer); debounceTimer = setTimeout(resetAndUpdate, 300); }

  input.addEventListener('input', debounced);
  if (form) form.addEventListener('submit', function(e) { e.preventDefault(); clearTimeout(debounceTimer); resetAndUpdate(); });
  facetChecks.forEach(function(c) { c.addEventListener('change', resetAndUpdate); });
  if (satoshiOnly) satoshiOnly.addEventListener('change', resetAndUpdate);
  if (showMore) showMore.addEventListener('click', function() {
    shown += BROWSE_PAGE;
    if (hits) renderSearch(); else renderBrowse();
  });
  if (clearBtn) clearBtn.addEventListener('click', function() {
    input.value = '';
    facetChecks.forEach(function(c) { c.checked = false; });
    if (satoshiOnly) satoshiOnly.checked = false;
    resetAndUpdate();
  });

  function activateSort(key, order) {
    sortState.key = key; sortState.order = order;
    sortBtns.forEach(function(b) {
      b.classList.remove('active');
      if (b.dataset.sort === key) {
        b.classList.add('active');
        b.dataset.order = order;
        b.textContent = sortLabel(b) + (order === 'asc' ? ' ↑' : ' ↓');
      } else {
        b.textContent = sortLabel(b) + (b.dataset.order === 'asc' ? ' ↑' : ' ↓');
      }
    });
  }
  sortBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.sort, order = btn.dataset.order;
      if (btn.classList.contains('active')) order = order === 'asc' ? 'desc' : 'asc';
      activateSort(key, order);
      try { sessionStorage.setItem(SORT_KEY, JSON.stringify({ key: key, order: order })); } catch (e) {}
      if (hits) renderSearch(); else renderBrowse();
    });
  });
  try { var saved = JSON.parse(sessionStorage.getItem(SORT_KEY)); if (saved && saved.key) activateSort(saved.key, saved.order); } catch (e) {}

  document.addEventListener('click', function(e) {
    document.querySelectorAll('details.facet[open]').forEach(function(d) {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });

  // Restore the query from the URL (Back / refresh / shared link).
  try { var q0 = new URLSearchParams(location.search).get('q'); if (q0) input.value = q0; } catch (e) {}
  update();
})();
</script>

<style>
  h1 { margin-bottom: 0.25rem; }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
  }

  .browse-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .browse-searchform { display: flex; }
  .browse-search {
    width: 100%;
    box-sizing: border-box;
    padding: 0.55rem 0.75rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }
  .browse-search::placeholder { color: var(--color-text-muted); opacity: 1; }
  .browse-search:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .browse-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .facet-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .facet { position: relative; }
  .facet > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    cursor: pointer;
    padding: 0.3em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    white-space: nowrap;
    list-style: none;
  }
  .facet > summary::-webkit-details-marker { display: none; }
  .facet > summary::marker { content: ''; }
  .facet > summary:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .facet[open] > summary { color: var(--color-text); border-color: var(--color-text-muted); }
  .facet-chevron { font-size: 0.7em; transition: transform 0.15s; }
  .facet[open] .facet-chevron { transform: rotate(180deg); }
  .facet-badge { color: var(--color-text); font-weight: 600; }

  .facet-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 30;
    min-width: 200px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.35rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .facet-opt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
    color: var(--color-text);
  }
  .facet-opt:hover { background: var(--color-bg-alt); }
  .facet-label { flex: 1 1 auto; }
  .facet-count { color: var(--color-text-muted); font-variant-numeric: tabular-nums; }

  .facet-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3em 0.6em;
    border: 1px solid var(--color-border);
