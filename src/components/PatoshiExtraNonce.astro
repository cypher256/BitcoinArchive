---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Illustrative reconstruction of Lerner's paper findings, not raw blockchain
// data -- generated once and frozen as static JSON (see
// src/scripts/extranonce-scatter.js's header comment) so this component and
// the in-body ChartEmbedRuntime drawer render the same fixed scatter,
// instead of a fresh Math.random() draw on every Astro build.
const scatterData = await import('../data/patoshi/extranonce-scatter.json').then(m => m.default);
const patoshiPoints = scatterData.patoshiPoints;
const nonPatoshiPoints = scatterData.nonPatoshiPoints;

const labels = {
  en: {
    title: 'ExtraNonce Pattern Across First Year of Mining',
    subtitle: 'Illustrative reconstruction of Lerner\'s ExtraNonce analysis across blocks 0–36,288. Patoshi blocks form consistent slope segments that restart every ~100 hours — a "slow realtime clock" fingerprint. Non-Patoshi blocks show a different linear progression.',
    xLabel: 'Block number',
    yLabel: 'ExtraNonce (normalized)',
    patoshi: 'Patoshi blocks (~22,000 blocks)',
    nonPatoshi: 'Non-Patoshi blocks',
    note: 'Illustrative reconstruction — based on paper findings, not raw blockchain data',
  },
  ja: {
    title: 'マイニング初年度の ExtraNonce パターン',
    subtitle: 'Lerner の ExtraNonce 解析（ブロック 0〜36,288）の概念的再現。Patoshi ブロックは一貫した傾き区間を形成し、約 100時間ごとに再開する — 「低速リアルタイムクロック」の指紋。非 Patoshi ブロックは別の線形進行を示す。',
    xLabel: 'ブロック番号',
    yLabel: 'ExtraNonce（正規化）',
    patoshi: 'Patoshi ブロック（約 22,000 ブロック）',
    nonPatoshi: '非 Patoshi ブロック',
    note: '概念図 — 論文の知見に基づく再現であり、生のブロックチェーンデータではない',
  },
};

const l = labels[lang];
---

<div class="patoshi-extranonce">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="extranonce-chart" class="chart-container"></div>
    <div class="legend">
      <span class="legend-item"><span class="legend-swatch swatch-patoshi"></span>{l.patoshi}</span>
      <span class="legend-item"><span class="legend-swatch swatch-non-patoshi"></span>{l.nonPatoshi}</span>
    </div>
    <p class="chart-note">{l.note}</p>
  </section>

  <script type="application/json" id="extranonce-data" set:html={JSON.stringify({ patoshiPoints, nonPatoshiPoints, labels: l })} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Drawing logic lives in src/scripts/extranonce-scatter.js (shared with the
// in-body embed via ChartEmbedRuntime). This script only wires the
// server-rendered JSON data block and DOM elements into that shared mount().
import { mount } from '../scripts/extranonce-scatter.js';

(function() {
  var dataEl = document.getElementById('extranonce-data') as HTMLElement | null;
  var container = document.getElementById('extranonce-chart') as HTMLElement | null;
  if (!dataEl || !container) return;
  var data = JSON.parse(dataEl.textContent as string);
  var replayBtn = document.querySelector('.patoshi-extranonce [data-replay]') as HTMLElement | null;
  mount(container, replayBtn, data.patoshiPoints, data.nonPatoshiPoints, data.labels);
})();
</script>

<style>
  .patoshi-extranonce {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .legend-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  /* Swatches mirror the runtime fill encoding (patoshi = accent,
     non-patoshi = neutral) so legend stays in sync on theme swap. */
  .swatch-patoshi { background: var(--color-accent); }
  .swatch-non-patoshi { background: var(--chart-color-6); }
  .chart-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.5rem;
  }
</style>
