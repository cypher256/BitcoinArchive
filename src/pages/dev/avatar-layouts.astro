---
// 開発用の人物アイコン レイアウト比較ページ (noindex・公開索引から除外)。
// 各案を「単一引用」と「多重引用 (ネスト + 発言者交代)」の両方で描画し、
// ブラウザで見比べて 1 案を選ぶための確認ページ。デザイン選定後に削除
// または dev 隔離する (todo/0606_人物アイコン導入プラン.md §7)。
//
// 引用はすべて実在の発言 (史実)。創作・捏造は使わない。
//  - 単一引用: サトシ最終メッセージ (STYLE_GUIDE_JA §I.4 確定訳)、ハル、ラズロ。
//  - 多重引用: 2009-11-03 linux-build メール (マルッティ・マルミ アーカイブ)。
//    実際の 4 段ネスト往復を文単位で抜粋短縮 (場面 A の許容範囲)。
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveAvatar } from '../../data/avatars';
import { participantDisplayNamesJaBySlug } from '../../i18n/participants';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const nameOf = (slug: string) => participantDisplayNamesJaBySlug[slug] ?? slug;
const avatarOf = (slug: string) => resolveAvatar(slug, base);

// 単一引用 (史実)。medium は §I.4 chip 文言種別 (correspondence→メール,
// 公開発信→投稿)。
const single = [
  {
    slug: 'satoshi-nakamoto',
    medium: 'メール',
    date: '2011年4月23日',
    text: '他のことに取り組むことにした。ギャビンたちに任せれば、安心だ',
    source: 'マイク・ハーン宛メール',
  },
  {
    slug: 'hal-finney',
    medium: '投稿',
    date: '2009年1月11日',
    text: 'Running bitcoin',
    source: 'X (旧 Twitter) @halfin',
  },
  {
    slug: 'laszlo-hanyecz',
    medium: '投稿',
    date: '2010年5月18日',
    text: 'ピザを何枚か、10,000 ビットコインで買いたい。大きいの 2 枚くらいで、次の日のぶんも残るといい',
    source: 'BitcoinTalk「Pizza for bitcoins?」',
  },
].map((q) => ({ ...q, name: nameOf(q.slug), avatar: avatarOf(q.slug) }));

// 多重引用 (史実)。2009-11-03 linux-build メールの 4 段ネスト往復。
// depth が深いほど古いメール。サトシ↔マルッティが交互に交代する。
const nested = [
  {
    slug: 'satoshi-nakamoto',
    depth: 0,
    date: '2009年11月3日',
    text: 'Linux ビルドに取り組むのを楽しみにしていたよ。',
  },
  {
    slug: 'martti-malmi',
    depth: 1,
    date: '2009年11月3日',
    text: 'ここまで移植した分を svn/branches にアップロードしました。Util、script、db とヘッダーは完全にコンパイルできるようになりました。',
  },
  {
    slug: 'satoshi-nakamoto',
    depth: 2,
    date: '2009年10月31日',
    text: 'heapchk() は MSVCRT のデバッグ用のもので使われていない。Linux では no-op にできる。',
  },
  {
    slug: 'martti-malmi',
    depth: 3,
    date: '2009年10月31日',
    text: 'util.h で QueryPerformanceCounter を Linux の gettimeofday に置き換える #ifdef を作りました。',
  },
  {
    slug: 'satoshi-nakamoto',
    depth: 4,
    date: '2009年10月30日',
    text: '見つけた移植性のないコードをいくつか修正した。他に修正すべきものを知っていたら教えてほしい。',
  },
].map((q) => ({ ...q, name: nameOf(q.slug), avatar: avatarOf(q.slug) }));

const layouts = [
  { id: 'a', name: '案 A: チップ横並び', desc: '発言者チップの左にアバター。既存に最も近い・最小改修。多重引用ではネスト深さでインデント' },
  { id: 'b', name: '案 B: 吹き出し型', desc: '左にアバター、右に発言の吹き出し。多重引用の応酬が一番読みやすい' },
  { id: 'c', name: '案 C: 縦積みカード', desc: 'アバター・名前・引用を縦に積む。多重引用ではカードが縦に連なり冗長になりやすい' },
  { id: 'd', name: '案 D: 罫線統合', desc: 'アバターを縦罫線の起点に。多重引用ではネスト罫線が深さを示す。本番表示に最も近い' },
];
---

<BaseLayout
  title="人物アイコン レイアウト比較 (開発用)"
  description="人物アイコンの引用レイアウト 4 案を単一・多重引用で見比べる開発用ページ。"
  lang="ja"
  noindex={true}
>
  <div class="container">
    <div class="layouts-intro">
      <h1>人物アイコン レイアウト比較</h1>
      <p>
        各案を「単一引用」と「多重引用 (ネスト + 発言者交代)」の両方で描画
        した開発用ページ。アバターは全員自動生成 (イニシャル + 決定的な
        背景色)。実写真はフェーズ 3 で収集予定で、収集後はこのページで
        実写真と自動生成の混在も確認する。
      </p>
      <p class="layouts-note">
        引用はすべて実在の発言 (史実)。多重引用は 2009 年 11 月のサトシ↔
        マルッティのメール往復 (4 段ネスト)。索引除外 (noindex) の確認専用ページ。
      </p>
    </div>

    {layouts.map((layout) => (
      <section class="layout-section">
        <div class="layout-head">
          <h2>{layout.name}</h2>
          <p>{layout.desc}</p>
        </div>

        <h3 class="sub-label">単一引用</h3>

        {layout.id === 'a' && (
          <div class="samples">
            {single.map((r) => (
              <div class="qa-a">
                <cite class="qa-a-chip">
                  <img class="av av-sm" src={r.avatar} alt="" width="26" height="26" />
                  <span>{r.name}の{r.medium} ({r.date})</span>
                </cite>
                <blockquote class="qa-a-bq" data-speaker={r.slug}>{r.text}</blockquote>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'b' && (
          <div class="samples">
            {single.map((r) => (
              <div class="qa-b">
                <img class="av av-md" src={r.avatar} alt="" width="38" height="38" />
                <div class="qa-b-body">
                  <div class="qa-b-name">{r.name}</div>
                  <div class="qa-b-bubble" data-speaker={r.slug}>{r.text}</div>
                  <div class="qa-b-meta">{r.date} ・ {r.source}</div>
                </div>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'c' && (
          <div class="samples qa-c-grid">
            {single.map((r) => (
              <div class="qa-c">
                <img class="av av-lg" src={r.avatar} alt="" width="64" height="64" />
                <div class="qa-c-name">{r.name}</div>
                <blockquote class="qa-c-bq">{r.text}</blockquote>
                <div class="qa-c-meta">{r.medium} ・ {r.date}</div>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'd' && (
          <div class="samples">
            {single.map((r) => (
              <div class="qa-d" data-speaker={r.slug}>
                <div class="qa-d-head">
                  <img class="av av-sm" src={r.avatar} alt="" width="26" height="26" />
                  <cite>{r.name}の{r.medium} ({r.date})</cite>
                </div>
                <blockquote class="qa-d-bq">{r.text}</blockquote>
              </div>
            ))}
          </div>
        )}

        <h3 class="sub-label">多重引用 (ネスト + 発言者交代)</h3>

        {layout.id === 'a' && (
          <div class="samples">
            {nested.map((n) => (
              <div class="qa-a" style={`margin-left:${n.depth * 1.4}rem`}>
                <cite class="qa-a-chip">
                  <img class="av av-sm" src={n.avatar} alt="" width="26" height="26" />
                  <span>{n.name}のメール ({n.date})</span>
                </cite>
                <blockquote class="qa-a-bq" data-speaker={n.slug}>{n.text}</blockquote>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'b' && (
          <div class="samples">
            {nested.map((n) => (
              <div class="qa-b" style={`margin-left:${n.depth * 1.4}rem`}>
                <img class="av av-md" src={n.avatar} alt="" width="38" height="38" />
                <div class="qa-b-body">
                  <div class="qa-b-name">{n.name}</div>
                  <div class="qa-b-bubble" data-speaker={n.slug}>{n.text}</div>
                  <div class="qa-b-meta">{n.date}</div>
                </div>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'c' && (
          <div class="samples">
            {nested.map((n) => (
              <div class="qa-c qa-c-inline" style={`margin-left:${n.depth * 1.4}rem`}>
                <img class="av av-md" src={n.avatar} alt="" width="38" height="38" />
                <div class="qa-c-name">{n.name}</div>
                <blockquote class="qa-c-bq">{n.text}</blockquote>
                <div class="qa-c-meta">メール ・ {n.date}</div>
              </div>
            ))}
          </div>
        )}
        {layout.id === 'd' && (
          <div class="samples">
            {nested.map((n) => (
              <div class="qa-d" data-speaker={n.slug} style={`margin-left:${n.depth * 1.4}rem`}>
                <div class="qa-d-head">
                  <img class="av av-sm" src={n.avatar} alt="" width="26" height="26" />
                  <cite>{n.name}のメール ({n.date})</cite>
                </div>
                <blockquote class="qa-d-bq">{n.text}</blockquote>
              </div>
            ))}
          </div>
        )}

        <p class="layout-sources">
          出典: 単一引用 — {single.map((r) => `${r.name} (${r.source})`).join(' / ')}。
          多重引用 — マルッティ・マルミ メールアーカイブ 2009-11-03 (サトシ↔マルッティ)。
        </p>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .layouts-intro {
    max-width: var(--max-width-prose);
    margin: 0 auto 2.5rem;
  }
  .layouts-intro h1 {
    margin: 0 0 0.6rem;
  }
  .layouts-intro p {
    margin: 0.4rem 0;
    line-height: 1.7;
  }
  .layouts-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .layout-section {
    margin: 3rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .layout-head {
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.4rem;
    margin-bottom: 1rem;
  }
  .layout-head h2 {
    margin: 0;
    font-size: 1.15rem;
  }
  .layout-head p {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .sub-label {
    margin: 1.4rem 0 0.8rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-hero-subtitle);
    letter-spacing: 0.02em;
  }
  .layout-sources {
    margin-top: 1.3rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* アバター共通 */
  .av {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--color-bg-alt);
  }
  .av-sm { width: 1.6rem; height: 1.6rem; }
  .av-md { width: 2.4rem; height: 2.4rem; }
  .av-lg { width: 4rem; height: 4rem; }

  /* 案 A: チップ横並び */
  .qa-a { margin: 1.1rem 0; }
  .qa-a-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }
  .qa-a-bq {
    margin: 0;
    padding: 0.6rem 1rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
    border-radius: 0 4px 4px 0;
  }
  .qa-a-bq[data-speaker="satoshi-nakamoto"] {
    border-left-color: var(--color-satoshi);
  }

  /* 案 B: 吹き出し型 */
  .qa-b {
    display: flex;
    gap: 0.7rem;
    margin: 1.1rem 0;
    align-items: flex-start;
  }
  .qa-b-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .qa-b-name {
    font-weight: 700;
    font-size: 0.9rem;
  }
  .qa-b-bubble {
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 0.15rem 0.7rem 0.7rem 0.7rem;
    max-width: 34rem;
    line-height: 1.65;
  }
  .qa-b-bubble[data-speaker="satoshi-nakamoto"] {
    border-color: var(--color-satoshi);
  }
  .qa-b-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  /* 案 C: 縦積みカード */
  .qa-c-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .qa-c {
    text-align: center;
    padding: 1.2rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
  }
  .qa-c-name {
    font-weight: 700;
    margin: 0.6rem 0;
  }
  .qa-c-bq {
    margin: 0.5rem 0;
    padding: 0;
    border: none;
    font-style: italic;
    line-height: 1.65;
  }
  .qa-c-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  /* 多重引用では縦積みカードを横長インラインに崩して連ねる (冗長さが分かる) */
  .qa-c-inline {
    text-align: left;
    margin: 0.5rem 0;
    padding: 0.7rem 0.9rem;
  }
  .qa-c-inline .av { display: inline-block; vertical-align: middle; }
  .qa-c-inline .qa-c-name { display: inline-block; margin: 0 0 0 0.5rem; vertical-align: middle; }
  .qa-c-inline .qa-c-bq { margin: 0.4rem 0 0.2rem; font-style: normal; }

  /* 案 D: 罫線統合 */
  .qa-d {
    margin: 1.1rem 0;
    border-left: 3px solid var(--color-accent);
    padding-left: 0.9rem;
  }
  .qa-d[data-speaker="satoshi-nakamoto"] {
    border-left-color: var(--color-satoshi);
  }
  .qa-d-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    margin-left: -1.7rem;
  }
  .qa-d-head cite {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .qa-d-bq {
    margin: 0;
    padding: 0;
    border: none;
    line-height: 1.7;
  }
</style>
