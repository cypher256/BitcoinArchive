---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { useTranslations, getDisplayEntries, getEntries, absoluteUrl, findAuthorParticipant, translateParticipantName } from '../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../data/threads';
import { existsSync, readFileSync } from 'fs';
import { join } from 'path';

const lang = 'en';
const t = useTranslations(lang);
const entries = await getDisplayEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);

// git dates (build-time generated). Loaded here because the browse list now
// defaults to "recently added" order — newest createdAt first — so opening
// /entries/ surfaces what was most recently added to the archive. Records are
// per language (en / ja); this page reads its own language's createdAt, falling
// back to the event date when a record is missing, and to plain event-date
// order when git-dates.json is absent entirely.
const gitDatesPath = join(process.cwd(), 'src/data/git-dates.json');
type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDates: Record<string, GitDateRecord> = existsSync(gitDatesPath)
  ? JSON.parse(readFileSync(gitDatesPath, 'utf-8'))
  : {};
const hasGitDates = Object.keys(gitDates).length > 0;

const createdKey = (e: any): string => gitDates[e.id]?.[lang]?.createdAt ?? e.data.date.toISOString();
const collapsed = collapseThreads(entries, threadCounts, threadStarters);
const displayEntries = hasGitDates
  ? collapsed.slice().sort((a, b) => createdKey(b).localeCompare(createdKey(a)))
  : collapsed.reverse();

// Facet counts over the cards actually rendered (one per thread/standalone).
// These drive the Type / Source filter menus; counts match the visible list.
const typeCounts = new Map<string, number>();
const sourceCounts = new Map<string, number>();
for (const entry of displayEntries) {
  typeCounts.set(entry.data.type, (typeCounts.get(entry.data.type) || 0) + 1);
  sourceCounts.set(entry.data.source, (sourceCounts.get(entry.data.source) || 0) + 1);
}
const typeFacets = Array.from(typeCounts.entries()).sort((a, b) => b[1] - a[1]);
const sourceFacets = Array.from(sourceCounts.entries()).sort((a, b) => b[1] - a[1]);

// Maps passed to the client so a full-text result card renders the SAME byline
// and badges as the browse EntryCard. The Algolia index stores raw EN-form
// author / participant names; katakana and localized labels are resolved here.
// Built over ALL entries — including biographies, which are indexed for
// full-text search even though they are excluded from the browse list.
const allEntries = await getEntries(lang);
// author string → { slug, name }. slug is the resolved participant (via the
// full findAuthorParticipant, incl. handle aliases); name is the display form
// (katakana on JA). Covers editorial entries too — the avatar forces Bitcoin
// Institute, but the byline still shows the subject's name (per EntryCard).
const authorMeta: Record<string, { slug: string; name: string }> = {};
// participant slug → display name (katakana on JA), for the "↔" co-participants.
const slugToName: Record<string, string> = {};
// entry type → localized badge label.
const typeLabels: Record<string, string> = {};
for (const e of allEntries) {
  const d = e.data as any;
  if (d.author && authorMeta[d.author] === undefined) {
    const ap = findAuthorParticipant(d.author, d.participants || []);
    authorMeta[d.author] = {
      slug: ap?.slug ?? '',
      name: translateParticipantName(ap?.name ?? d.author, ap?.slug, lang),
    };
  }
  for (const p of (d.participants || [])) {
    if (slugToName[p.slug] === undefined) slugToName[p.slug] = translateParticipantName(p.name, p.slug, lang);
  }
  if (d.type && typeLabels[d.type] === undefined) typeLabels[d.type] = t(`type.${d.type}` as any) || d.type;
}
const uiLabels = { event: t('entry.event' as any), created: t('entry.created' as any), updated: t('entry.updated' as any), biography: t('entry.biography' as any) };

const pageDescription = "Complete chronological archive of Satoshi Nakamoto and early Bitcoin contributors' communications — forum posts, mailing-list discussions, private correspondence, and primary historical records, all with original sources preserved.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.entries')} - ${t('site.title')}`,
  "url": absoluteUrl('/entries/', lang),
  "description": pageDescription,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.entries'),
    "numberOfItems": displayEntries.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": displayEntries.slice(0, 25).map((entry: any, index: number) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      const itemUrl = isThread
        ? absoluteUrl(`/entries/threads/${tid}/`, lang)
        : absoluteUrl(`/entries/${entry.id}/`, lang);
      const itemName = isThread
        ? (threadTitles.get(tid!) || entry.data.title)
        : entry.data.title;
      return {
        "@type": "ListItem",
        "position": index + 1,
        "url": itemUrl,
        "name": itemName,
      };
    }),
  },
};
---

<BaseLayout
  title={`${t('nav.entries')} - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateJa={absoluteUrl('/entries/', 'ja')}
  structuredData={structuredData}
>
  <div class="container-wide">
    <h1>{t('nav.entries')}</h1>
    <p class="page-lead">Every primary-source record of Satoshi Nakamoto and early Bitcoin — forum posts, mailing-list threads, private emails, BIPs, and aftermath, preserved verbatim from the original sources.</p>

    <div class="browse-toolbar">
      <form id="search-form" class="browse-searchform" role="search">
        <input
          type="search"
          id="entry-filter"
          class="browse-search"
          placeholder="Search the full text — a person, a phrase, anything in the body…"
          autocomplete="off"
          aria-label="Search the full text of every entry"
        />
      </form>
      <div class="browse-row">
        <div class="facet-group">
          <details class="facet">
            <summary>Type<span class="facet-badge" data-badge="type" hidden></span><span class="facet-chevron" aria-hidden="true">▾</span></summary>
            <div class="facet-menu">
              {typeFacets.map(([type, count]) => (
                <label class="facet-opt">
                  <input type="checkbox" class="facet-check" data-facet="type" value={type} />
                  <span class="facet-label">{t(`type.${type}` as any) || type}</span>
                  <span class="facet-count">{count}</span>
                </label>
              ))}
            </div>
          </details>
          <details class="facet">
            <summary>Source<span class="facet-badge" data-badge="source" hidden></span><span class="facet-chevron" aria-hidden="true">▾</span></summary>
            <div class="facet-menu">
              {sourceFacets.map(([source, count]) => (
                <label class="facet-opt">
                  <input type="checkbox" class="facet-check" data-facet="source" value={source} />
                  <span class="facet-label">{t(`source.${source}` as any) || source}</span>
                  <span class="facet-count">{count}</span>
                </label>
              ))}
            </div>
          </details>
          <label class="facet-toggle">
            <input type="checkbox" id="satoshi-only" />
            <span>Satoshi only</span>
          </label>
        </div>
        <div class="sort-controls" id="sort-controls">
          <button class:list={["sort-btn", { active: !hasGitDates }]} data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
          {hasGitDates && (
            <>
              <button class="sort-btn active" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
              <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="browse-status">
      <p class="entry-count"><span id="result-count">{displayEntries.length}</span><span id="count-unit"> entries</span></p>
      <button type="button" id="clear-filters" class="clear-filters" hidden>Clear</button>
      <a class="algolia-attribution" href="https://www.algolia.com/" target="_blank" rel="noopener" aria-label="Search by Algolia">
        <img class="algolia-logo algolia-logo--light" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/algolia/Algolia-logo-blue.svg`} alt="" width="79" height="18" loading="lazy" />
        <img class="algolia-logo algolia-logo--dark" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/algolia/Algolia-logo-white.svg`} alt="" width="79" height="18" loading="lazy" />
      </a>
    </div>

    <script is:inline>
      // Pre-paint hide: if we arrived with ?q= (Back / refresh / shared link),
      // hide the SSR browse list before it flashes. See `.entries-searching` CSS.
      try { if (new URLSearchParams(location.search).get('q')) document.documentElement.classList.add('entries-searching'); } catch (e) {}
      // Same idea for sort: a saved non-default sort is restored only after the
      // main script runs, so the SSR list (created-date order) would paint first
      // and then visibly jump. Hide it now; the main script reveals it again
      // right after the first sort+render. ('entries-sort' = SORT_KEY.)
      try { if (sessionStorage.getItem('entries-sort')) document.documentElement.classList.add('entries-presort'); } catch (e) {}
    </script>

    <div id="entries-list">
      {displayEntries.map((entry: any) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        const gd = gitDates[entry.id]?.en;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            entryType={entry.data.type}
            tags={entry.data.tags}
            createdAt={gd?.createdAt}
            updatedAt={gd?.updatedAt}
          />
        );
      })}
    </div>
    <!-- Search results (Algolia full text) render here; same card style as browse. -->
    <div id="search-results"></div>
    <div class="browse-more">
      <button type="button" id="show-more" class="show-more" hidden>Show more</button>
      <p id="no-results" class="no-results" hidden>Nothing matches. Try fewer words or clear the filters.</p>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
<script type="application/json" id="entries-config" is:inline set:html={JSON.stringify({ basePath: import.meta.env.BASE_URL.replace(/\/$/, ''), indexName: 'bitcoin_archive_en', locale: 'en', authorMeta, slugToName, typeLabels, uiLabels })}></script>
<script>
  import { initEntriesBrowse } from '../../scripts/entries-browse';
  initEntriesBrowse();
</script>

<style>
  h1 { margin-bottom: 0.25rem; }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
  }

  .browse-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .browse-searchform { display: flex; }
  .browse-search {
    width: 100%;
    box-sizing: border-box;
    padding: 0.55rem 0.75rem;
    font: inherit;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }
  .browse-search::placeholder { color: var(--color-text-muted); opacity: 1; }
  .browse-search:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }

  .browse-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .facet-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .facet { position: relative; }
  .facet > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    cursor: pointer;
    padding: 0.3em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    white-space: nowrap;
    list-style: none;
  }
  .facet > summary::-webkit-details-marker { display: none; }
  .facet > summary::marker { content: ''; }
  .facet > summary:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .facet[open] > summary { color: var(--color-text); border-color: var(--color-text-muted); }
  .facet-chevron { font-size: 0.7em; transition: transform 0.15s; }
  .facet[open] .facet-chevron { transform: rotate(180deg); }
  .facet-badge { color: var(--color-text); font-weight: 600; }

  .facet-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 0;
    z-index: 30;
    min-width: 200px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.35rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .facet-opt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
    color: var(--color-text);
  }
  .facet-opt:hover { background: var(--color-bg-alt); }
  .facet-label { flex: 1 1 auto; }
  .facet-count { color: var(--color-text-muted); font-variant-numeric: tabular-nums; }

  .facet-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .facet-toggle:hover { color: var(--color-text); border-color: var(--color-text-muted); }

  .sort-controls {
    display: flex;
    gap: 0.25rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
  }
  .sort-btn {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.2em 0.6em;
    color: var(--color-text-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    white-space: nowrap;
  }
  .sort-btn:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .sort-btn.active { color: var(--color-text); font-weight: 600; border-color: var(--color-text); }
  .sort-btn:focus-visible, .facet > summary:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .browse-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .clear-filters {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-link);
    cursor: pointer;
    text-decoration: underline;
  }
  .clear-filters:hover { color: var(--color-link-hover); }

  /* .entry-card belongs to EntryCard's scope, not this page's — so these
     must be :global() or the display:none never applies (filtered cards
     keep the class but stay visible: count changes, list doesn't). */
  :global(.entry-card.filtered-out), :global(.entry-card.paged-out) { display: none; }

  /* Pre-paint browse-list hide. The early inline script just above
     #entries-list adds `.entries-searching` to <html> when the page loads with
     ?q= (Back / refresh / shared link), so the SSR browse list is hidden before
     it can paint — the cached search results render in its place with no
     browse-list flash. The main controller then removes the class and governs
     visibility via list.hidden, so this rule only bites on the first paint. */
  :global(html.entries-searching #entries-list) { display: none; }

  /* Sort pre-paint guard: hide the list (keeping its layout box) until the first
     client sort, so a restored non-default sort never flashes the SSR order. The
     entries script removes this class right after the first render. visibility
     (not display) preserves height so Back/forward scroll restoration still works. */
  :global(html.entries-presort #entries-list) { visibility: hidden; }

  .browse-more { margin-top: 1rem; text-align: center; }
  .show-more {
    padding: 0.5em 1.4em;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
  }
  .show-more:hover { border-color: var(--color-text-muted); }
  .no-results { color: var(--color-text-muted); }

  /* Full-text result cards reuse EntryCard's markup + class names, so their
     look is the single shared source of truth — the `.entry-card` section in
     global.css (which styles both the SSR browse cards and these runtime-
     injected search cards). The only page-level hook still needed is for the
     injected "no results" message: the scoped `.no-results` below cannot reach
     runtime-injected nodes, so a :global() copy targets them. */
  :global(#search-results .no-results) { color: var(--color-text-muted); }

  @media (max-width: 600px) {
    .browse-row { flex-direction: column; align-items: stretch; }
    .sort-controls { flex-wrap: wrap; }
  }
</style>
