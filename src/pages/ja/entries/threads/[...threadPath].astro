---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, formatDate, localePath, translateParticipantName, absoluteUrl, findAuthorParticipant } from '../../../../i18n/utils';
import { deriveThreadTitle, resolveThreadId } from '../../../../data/threads';
import MessageBlock from '../../../../components/MessageBlock.astro';
import PrevNextNav from '../../../../components/PrevNextNav.astro';
import commentariesData from '../../../../data/derived-commentaries.json';
import ThreadTocNav from '../../../../components/ThreadTocNav.astro';
import CategoryWidget from '../../../../components/CategoryWidget.astro';

const commentariesMap = commentariesData as Record<string, { id: string }[]>;

export async function getStaticPaths() {
  const entries = await getCollection('entries_ja');
  const threadMap = new Map<string, typeof entries>();

  for (const entry of entries) {
    const tid = resolveThreadId(entry);
    if (tid) {
      const list = threadMap.get(tid) || [];
      list.push(entry);
      threadMap.set(tid, list);
    }
  }

  // 英語側に存在するスレッドIDを取得
  const enEntries = await getCollection('entries');
  const enThreadCounts = new Map<string, number>();
  for (const entry of enEntries) {
    const tid = resolveThreadId(entry);
    if (tid) {
      enThreadCounts.set(tid, (enThreadCounts.get(tid) || 0) + 1);
    }
  }

  // Build a chronologically sorted list of all threads so each thread page
  // can carry prev/next links pointing to adjacent threads, parallel to the
  // per-entry nav on individual pages. Anchor each thread to its first
  // message's date.
  const allThreads = [...threadMap.entries()]
    .filter(([_, msgs]) => msgs.length >= 2)
    .map(([threadId, msgs]) => {
      msgs.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
      return { threadId, msgs };
    })
    .sort((a, b) => a.msgs[0].data.date.getTime() - b.msgs[0].data.date.getTime());

  return allThreads.map(({ threadId, msgs }, idx) => {
    const prev = idx > 0 ? allThreads[idx - 1] : null;
    const next = idx < allThreads.length - 1 ? allThreads[idx + 1] : null;
    return {
      params: { threadPath: threadId },
      props: {
        messages: msgs,
        threadTitle: deriveThreadTitle(threadId, msgs, 'ja'),
        hasEn: (enThreadCounts.get(threadId) || 0) >= 2,
        prevThread: prev ? { id: prev.threadId, title: deriveThreadTitle(prev.threadId, prev.msgs, 'ja') } : null,
        nextThread: next ? { id: next.threadId, title: deriveThreadTitle(next.threadId, next.msgs, 'ja') } : null,
      },
    };
  });
}

const lang = 'ja';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const t = useTranslations(lang);
const { messages, threadTitle, hasEn, prevThread, nextThread } = Astro.props;

const rendered = await Promise.all(
  messages.map(async (msg: any) => {
    const { Content } = await render(msg);
    // Same id MessageBlock renders onto .message[id] below and the
    // in-body link-rewriting script (bottom of this file) targets --
    // computed once here so the sidebar nav and the actual anchor can
    // never drift apart.
    const msgId = msg.data.sourceUrl?.match(/msg(\d+)#/)?.[0]?.replace('#', '') || ('entry-' + (msg.id.split('/').pop() || ''));
    return { entry: msg, Content, msgId };
  })
);
const threadTocItems = rendered.map(({ entry, msgId }) => {
  // Same name resolution MessageBlock.astro uses for its own on-page
  // author label (findAuthorParticipant + translateParticipantName) --
  // the sidebar must show the same name each message body already
  // does, not the raw frontmatter handle.
  const ap = findAuthorParticipant(entry.data.author, entry.data.participants);
  return {
    id: msgId,
    author: translateParticipantName(ap?.name ?? entry.data.author, ap?.slug, lang),
    date: entry.data.date,
    isSatoshi: entry.data.isSatoshi,
  };
});

const participantMap = new Map<string, { name: string; slug: string }>();
for (const m of messages) {
  for (const p of m.data.participants) {
    if (!participantMap.has(p.slug)) {
      participantMap.set(p.slug, p);
    }
  }
}
const participants = Array.from(participantMap.values());
const dateRange = `${formatDate(messages[0].data.date, lang)} — ${formatDate(messages[messages.length - 1].data.date, lang)}`;
const source = messages[0].data.source;
const sourceLabel = t(`source.${source}` as any) || source;
const breadcrumbs = [
  { name: t('nav.home'), url: localePath('/', lang) },
  { name: t('nav.entries'), url: localePath('/entries/', lang) },
  { name: threadTitle, url: localePath(`/entries/threads/${Astro.params.threadPath}/`, lang) },
];
---

<BaseLayout
  title={`${threadTitle} — スレッド - ${t('site.title')}`}
  description={`会話スレッド: ${threadTitle}（${messages.length}件）`}
  lang={lang}
  alternateEn={hasEn ? absoluteUrl(`/entries/threads/${Astro.params.threadPath}/`, 'en') : undefined}
  ogImage={`/og/ja/threads/${Astro.params.threadPath}.png`}
  breadcrumbs={breadcrumbs}
>
  <article class="container has-2col-sidebar">
    <aside class="entry-sidebar">
      <ThreadTocNav lang={lang} items={threadTocItems} />
      <CategoryWidget lang={lang} />
    </aside>
    <div class="entry-main-col">
    <PrevNextNav
      top
      prev={prevThread && { href: localePath(`/entries/threads/${prevThread.id}/`, lang), label: prevThread.title }}
      next={nextThread && { href: localePath(`/entries/threads/${nextThread.id}/`, lang), label: nextThread.title }}
    />
    <header class="thread-header">
      <h1>{threadTitle}</h1>
      <div class="thread-meta">
        <span class="thread-count">{messages.length} 件のメッセージ</span>
        <a href={localePath(`/sources/${source}/`, lang)} class="source-badge">{sourceLabel}</a>
        <span class="thread-participants">
          {participants.map((p, i) => (
            <>
              <a href={localePath(`/participants/${p.slug}/`, lang)} class:list={["participant-link", { satoshi: p.name === 'Satoshi Nakamoto' }]}>{translateParticipantName(p.name, p.slug, lang)}</a>{i < participants.length - 1 && ', '}
            </>
          ))}
        </span>
        <span class="thread-dates">{dateRange}</span>
      </div>
    </header>

    <div class="conversation-thread">
      {rendered.map(({ entry, Content }: any, i: number) => (
        <>
          {i > 0 && <div class="thread-connector" />}
          <MessageBlock
            lang={lang}
            base={base}
            author={entry.data.author}
            participants={entry.data.participants}
            date={entry.data.date}
            isSatoshi={entry.data.isSatoshi}
            id={entry.data.sourceUrl?.match(/msg(\d+)#/)?.[0]?.replace('#', '') || ('entry-' + (entry.id.split('/').pop() || ''))}
          >
            <Fragment slot="source">
              <a class="permalink" href={localePath(`/entries/${entry.id}/`, lang)}>個別</a>
              {(() => {
                const commentaries = commentariesMap[entry.id] ?? [];
                const cN = commentaries.length;
                if (cN === 0) return null;
                const label = cN === 1
                  ? t('commentary.threadLink' as any)
                  : t('commentary.count' as any).replace('{n}', String(cN));
                const href = cN === 1
                  ? localePath(`/entries/${commentaries[0].id}/`, lang)
                  : localePath(`/entries/${entry.id}/#commentaries`, lang);
                return (
                  <>
                    {' · '}
                    <a href={href}>{label}</a>
                  </>
                );
              })()}
            </Fragment>
            <Content />
          </MessageBlock>
        </>
      ))}
    </div>

    <PrevNextNav
      prev={prevThread && { href: localePath(`/entries/threads/${prevThread.id}/`, lang), label: prevThread.title }}
      next={nextThread && { href: localePath(`/entries/threads/${nextThread.id}/`, lang), label: nextThread.title }}
    />
    </div>
  </article>
</BaseLayout>

<style>
  .thread-header {
    padding-top: 2rem;
    margin-bottom: 2rem;
  }
  .thread-header h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
  }
  .thread-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .thread-count {
    font-weight: 600;
    color: var(--color-text);
  }
  .source-badge {
    display: inline-block;
    padding: 0.1em 0.5em;
    background: var(--color-source-bg);
    border-radius: 3px;
    font-size: 0.8rem;
    text-decoration: none;
    color: inherit;
  }
  .source-badge:hover {
    opacity: 0.85;
  }
  .participant-link {
    text-decoration: none;
    color: var(--color-link);
  }
  .participant-link:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }
  .participant-link.satoshi {
    color: var(--color-satoshi);
    font-weight: 600;
  }
  .author-name {
    text-decoration: none;
    color: var(--color-link);
  }
  .author-name:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }
  .author-name.satoshi {
    color: var(--color-satoshi);
    font-weight: 600;
  }
  .author-handle {
    font-weight: 400;
    font-size: 0.85em;
    color: var(--color-text-muted);
  }
</style>

<script is:inline>
// Rewrite in-thread links to anchor links
(function() {
  // Build msgId set and path-to-anchor mapping
  var msgIds = new Set();
  var pathToAnchor = {};
  document.querySelectorAll('.message[id]').forEach(function(el) {
    if (!el.id) return;
    msgIds.add(el.id);
    // Find the permalink (個別ページ) link inside this message to map path -> anchor
    var permalink = el.querySelector('.message-source a.permalink');
    if (permalink) {
      var path = permalink.getAttribute('href');
      if (path) pathToAnchor[path.replace(/\/$/, '')] = '#' + el.id;
    }
  });
  document.querySelectorAll('.message-body a[href]').forEach(function(a) {
    var href = a.getAttribute('href');
    if (!href || href.startsWith('http')) return;
    // Match by msgID in URL
    var m = href.match(/msg(\d+)\/?$/);
    if (m && msgIds.has('msg' + m[1])) {
      a.setAttribute('href', '#msg' + m[1]);
      return;
    }
    // Match by entry path (for links without msgID)
    var normalized = href.replace(/\/$/, '');
    if (pathToAnchor[normalized]) {
      a.setAttribute('href', pathToAnchor[normalized]);
    }
  });
})();
</script>
