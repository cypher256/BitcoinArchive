---
/**
 * DesignSeriesNav.astro
 *
 * Tree-style table of contents for the 12-page design-document
 * series. Renders at the top of every `type: "design"` entry.
 *
 * Highlights the current page (resolved from the `slug` prop = the
 * Astro content collection `entry.id`).
 *
 * Wired in via:
 *   src/pages/entries/[...slug].astro
 *   src/pages/ja/entries/[...slug].astro
 * as `{entry.data.type === 'design' && <DesignSeriesNav lang={lang}
 * slug={entry.id} />}` immediately before `<Content />`.
 *
 * The series order itself lives in ../data/design-series.ts (shared with
 * the prev/next logic in both [...slug].astro pages) -- add new pages
 * there, not here.
 *
 * The component is `<details>` by default to keep mobile compact;
 * the `<summary>` always shows the current location so the user
 * can identify their position even while collapsed.
 */
import { localePath } from '../i18n/utils';
import { DESIGN_SERIES, type SeriesEntry } from '../data/design-series';

interface Props {
  lang: 'en' | 'ja';
  slug: string;
}

const { lang, slug } = Astro.props;

const SERIES = DESIGN_SERIES;

const L0 = SERIES.find((e) => e.level === 'L0')!;
const L1 = SERIES.filter((e) => e.level === 'L1');
const L2 = SERIES.filter((e) => e.level === 'L2');

// `slug` is the Astro content-collection `entry.id`, which carries the
// type prefix (`design/2009-01-03-...`). Strip the prefix before
// comparing so the SERIES list can stay slug-only.
const bareSlug = slug.replace(/^design\//, '');
const current = SERIES.find((e) => e.slug === bareSlug);

function titleOf(e: SeriesEntry) {
  return lang === 'ja' ? e.titleJa : e.titleEn;
}

function locationLabel(e: SeriesEntry) {
  if (e.level === 'L0') return lang === 'ja' ? 'L0 全体俯瞰' : 'L0 Overview';
  return `${e.level} #${e.index}`;
}

function summaryText() {
  if (!current) return lang === 'ja' ? '設計文書シリーズ' : 'Design-document series';
  return `${locationLabel(current)} — ${titleOf(current)}`;
}

function hrefFor(e: SeriesEntry) {
  return localePath(`/entries/design/${e.slug}/`, lang);
}

const seriesLabel = lang === 'ja' ? '設計文書シリーズ' : 'Design-document series';
const l1Label = lang === 'ja' ? 'L1 — ドメイン別' : 'L1 — Domain pages';
const l2Label = lang === 'ja' ? 'L2 — 横断・比較' : 'L2 — Cross-cutting';
---

<nav class="design-series-nav" aria-label={seriesLabel}>
  <details open>
    <summary>
      <span class="series-label">{seriesLabel}</span>
      <span class="series-current">{summaryText()}</span>
    </summary>
    <div class="series-body">
      <ul class="series-l0">
        <li class:list={[{ 'is-current': current?.slug === L0.slug }]}>
          <span class="loc">{locationLabel(L0)}</span>
          {current?.slug === L0.slug
            ? <span class="title">{titleOf(L0)}</span>
            : <a href={hrefFor(L0)} class="title">{titleOf(L0)}</a>}
        </li>
      </ul>
      <div class="series-group">
        <div class="series-group-label">{l1Label}</div>
        <ol class="series-l1">
          {L1.map((e) => (
            <li class:list={[{ 'is-current': current?.slug === e.slug }]}>
              <span class="loc">{`#${e.index}`}</span>
              {current?.slug === e.slug
                ? <span class="title">{titleOf(e)}</span>
                : <a href={hrefFor(e)} class="title">{titleOf(e)}</a>}
            </li>
          ))}
        </ol>
      </div>
      <div class="series-group">
        <div class="series-group-label">{l2Label}</div>
        <ol class="series-l2" start={9}>
          {L2.map((e) => (
            <li class:list={[{ 'is-current': current?.slug === e.slug }]}>
              <span class="loc">{`#${e.index}`}</span>
              {current?.slug === e.slug
                ? <span class="title">{titleOf(e)}</span>
                : <a href={hrefFor(e)} class="title">{titleOf(e)}</a>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </details>
</nav>

<style>
  .design-series-nav {
    /* Top side uses --gap-header-to-body, the same fixed gap
       entry-content/biography-content/hero-hoisted-wrap use below the
       header on every other entry type -- this nav plays that same
       "first thing below the header" role on design entries. It
       originally shipped at a literal 1.5rem (fdfc59cca) but was swept
       into --rhythm-block (5rem) by a later, broader refactor
       (9b8670038) meant for end-of-article component spacing, which
       this isn't -- that produced a visibly oversized gap above the nav
       (confirmed via Playwright, 2026-09-04) that no other entry type had.
       Bottom side keeps --rhythm-cluster, not --rhythm-block: every
       design entry's body opens with a hero image (see STYLE_GUIDE_CORE.md
       "Hero Images"), itself a boxed visual block rather than prose, so
       this follows the same tightened-adjacency rule as
       .thread-banner + .thread-banner etc. in global.css. */
    margin: var(--gap-header-to-body) 0 var(--rhythm-cluster);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-alt);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text);
  }
  .design-series-nav details > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    border-radius: 6px;
  }
  .design-series-nav details > summary::-webkit-details-marker { display: none; }
  .design-series-nav details > summary::after {
    content: '▾';
    margin-left: auto;
    color: var(--color-text-muted);
    transition: transform 0.15s ease;
  }
  .design-series-nav details:not([open]) > summary::after {
    transform: rotate(-90deg);
  }
  .series-label {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }
  .series-current {
    color: var(--color-text);
    font-weight: 500;
  }
  .series-body {
    padding: 0.25rem 1rem 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .design-series-nav ul,
  .design-series-nav ol {
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }
  .design-series-nav li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.2rem 0;
    line-height: 1.5;
  }
  .design-series-nav .loc {
    flex-shrink: 0;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    min-width: 3.25rem;
  }
  .design-series-nav .title {
    color: inherit;
  }
  .design-series-nav a.title {
    color: var(--color-link);
    text-decoration: none;
  }
  .design-series-nav a.title:hover {
    text-decoration: underline;
  }
  .design-series-nav li.is-current {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    padding-left: 0.5rem;
    margin-left: -0.5rem;
    border-radius: 3px;
  }
  .design-series-nav li.is-current .loc,
  .design-series-nav li.is-current .title {
    color: var(--color-text);
    font-weight: 600;
  }
  .series-group {
    margin-top: 0.5rem;
  }
  .series-group-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0.25rem;
  }
  @media (max-width: 640px) {
    .design-series-nav { font-size: 0.85rem; }
    .design-series-nav .loc { min-width: 2.5rem; }
  }
</style>
