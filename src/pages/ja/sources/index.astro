---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getDisplayEntries, localePath, absoluteUrl } from '../../../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
const entries = await getDisplayEntries('en');

const sourceCounts = new Map<string, number>();
for (const entry of entries) {
  sourceCounts.set(entry.data.source, (sourceCounts.get(entry.data.source) || 0) + 1);
}
const sources = Array.from(sourceCounts.entries()).sort((a, b) => b[1] - a[1]);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.sources')} - ${t('site.title')}`,
  "url": absoluteUrl('/sources/', lang),
  "description": t('sources.description'),
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.sources'),
    "numberOfItems": sources.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": sources.map(([source], index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": absoluteUrl(`/sources/${source}/`, lang),
      "name": t(`source.${source}` as any) || source,
    })),
  },
};
---

<BaseLayout
  title={`${t('nav.sources')} - ${t('site.title')}`}
  description={t('sources.description')}
  lang={lang}
  alternateEn={absoluteUrl('/sources/', 'en')}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentCategory="sources"
>
    <h1>{t('nav.sources')}</h1>
    <div class="list-header">
      <input type="text" id="filter-input" class="filter-input" placeholder="フィルター..." autocomplete="off" />
      <div class="sort-controls">
        <button class="sort-btn active" data-sort="count" data-order="desc">{t('sort.count' as any)} ↓</button>
        <button class="sort-btn" data-sort="name" data-order="asc">{t('sort.name' as any)} ↑</button>
      </div>
    </div>
    <ul class="source-list" id="sort-list">
      {sources.map(([source, count]) => {
        const sourceLabel = t(`source.${source}` as any) || source;
        const sourceDescription = t(`source.${source}.description` as any);
        return (
        <li data-name={sourceLabel} data-count={count} data-filter={`${sourceLabel} ${sourceDescription}`.toLowerCase()}>
          <a href={localePath(`/sources/${source}/`, lang)}>
            {sourceLabel}
          </a>
          <span class="count">({count})</span>
          <p class="source-description">{sourceDescription}</p>
        </li>
        );
      })}
    </ul>
</BaseLayout>

<script>
  import { initCategoryList } from '../../../scripts/list-sort';
  initCategoryList('sort-list', 'sources-sort');
</script>

<style>
  .source-list { list-style: none; padding: 0; }
  .source-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.1rem;
  }
  .count { color: var(--color-text-muted); font-size: 0.9rem; }
  .source-description {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
