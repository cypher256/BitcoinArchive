---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Halving schedule (same as halvings.json). Eras past 2032 are synthesized client-side out to ~2140.
const halvings = [
  { date: '2009-01-03', reward: 50,      label: { en: 'Issuance begins', ja: '発行開始' } },
  { date: '2012-11-28', reward: 25,      label: { en: '1st halving',     ja: '第1回半減期' } },
  { date: '2016-07-09', reward: 12.5,    label: { en: '2nd halving',     ja: '第2回半減期' } },
  { date: '2020-05-11', reward: 6.25,    label: { en: '3rd halving',     ja: '第3回半減期' } },
  { date: '2024-04-20', reward: 3.125,   label: { en: '4th halving',     ja: '第4回半減期' } },
  { date: '2028-04-17', reward: 1.5625,  label: { en: '5th halving',     ja: '第5回半減期' } },
  { date: '2032-04-14', reward: 0.78125, label: { en: '6th halving',     ja: '第6回半減期' } },
];

const labels = {
  en: {
    title: 'Bitcoin’s issuance until it reaches 21 million',
    subtitle: 'Issuance halves every four years and effectively ends around 2140 at the 21M cap. The x-axis stretches as time advances so the long flat tail stays legible.',
    cap: '21,000,000 BTC (cap)',
    replay: 'Replay',
  },
  ja: {
    title: 'ビットコインの発行が 2,100 万枚に達するまで',
    subtitle: '発行は 4 年ごとに半減し、2140 年ごろ 2,100 万枚で実質止まる。時間が進むと x 軸が伸びて、後半の平らな尾も読めるようにしている。',
    cap: '21,000,000 BTC（上限）',
    replay: 'リプレイ',
  },
};

const l = labels[lang];
const localized = {
  cap: 21000000,
  blocks: 210000,
  capLabel: l.cap,
  halvings: halvings.map((h) => ({ date: h.date, reward: h.reward, label: h.label[lang] })),
};
---

<div class="supply-curve-animated">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>

    <div class="chart-controls">
      <button id="supply-anim-replay" class="replay-btn" type="button">↻ {l.replay}</button>
    </div>

    <div id="supply-anim-chart" class="chart-container"></div>
  </section>

  <script is:inline type="application/json" id="supply-anim-data" set:html={JSON.stringify(localized)} />
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
</div>

<script is:inline>
(function () {
  function init() {
    if (typeof d3 === 'undefined') { setTimeout(init, 50); return; }

    var container = document.getElementById('supply-anim-chart');
    var dataEl = document.getElementById('supply-anim-data');
    var replayBtn = document.getElementById('supply-anim-replay');
    if (!container || !dataEl) return;

    var D = JSON.parse(dataEl.textContent);
    var CAP = D.cap, BLOCKS = D.blocks, CAP_LABEL = D.capLabel;

    // Cumulative-supply table. Past 2032, synthesize a halving every ~4 years out to 2140.
    var eras = [], cum = 0, dataCount = D.halvings.length;
    D.halvings.forEach(function (h) { eras.push({ t: new Date(h.date), cumStart: cum, reward: h.reward, n: eras.length, named: true, label: h.label }); cum += BLOCKS * h.reward; });
    var rew = eras[eras.length - 1].reward, d = new Date(eras[eras.length - 1].t);
    while (true) {
      rew = rew / 2;
      d = new Date(d.getFullYear() + 4, d.getMonth(), d.getDate());
      eras.push({ t: d, cumStart: cum, reward: rew, n: eras.length, named: false });
      cum += BLOCKS * rew;
      if (rew < 1e-8 || d.getFullYear() >= 2140) break;
    }
    var startDate = eras[0].t, endDate = eras[eras.length - 1].t;

    function supplyAt(dt) {
      for (var i = eras.length - 1; i >= 0; i--) {
        if (dt >= eras[i].t) {
          var next = eras[i + 1];
          if (!next) return eras[i].cumStart;
          var frac = (dt - eras[i].t) / (next.t - eras[i].t);
          return eras[i].cumStart + frac * (next.cumStart - eras[i].cumStart);
        }
      }
      return 0;
    }

    function token(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
    function T() {
      return {
        text: token('--color-text') || '#222', muted: token('--color-text-muted') || '#777',
        grid: token('--chart-grid') || '#ccc', orange: token('--color-satoshi') || '#c2410c',
        gold: token('--color-hero-subtitle') || '#a78347', bg: token('--color-bg') || '#fff',
      };
    }

    var fmt = d3.format(',.0f');
    var H = 440, margin = { top: 54, right: 24, bottom: 34, left: 56 };
    var W, iw, ih, x, y, svg, g, gAxis, gDyn, counter, pct, yearT, area, line, col;

    function build() {
      container.innerHTML = '';
      col = T();
      var rect = container.getBoundingClientRect();
      W = Math.max(320, rect.width || 720);
      iw = W - margin.left - margin.right; ih = H - margin.top - margin.bottom;

      x = d3.scaleTime().range([0, iw]);
      y = d3.scaleLinear().domain([0, CAP]).range([ih, 0]);

      svg = d3.select(container).append('svg').attr('width', W).attr('height', H).attr('viewBox', '0 0 ' + W + ' ' + H);
      var grad = svg.append('defs').append('linearGradient').attr('id', 'sa-grad').attr('x1', 0).attr('y1', 0).attr('x2', 0).attr('y2', 1);
      grad.append('stop').attr('offset', '0%').attr('stop-color', col.orange).attr('stop-opacity', 0.45);
      grad.append('stop').attr('offset', '100%').attr('stop-color', col.orange).attr('stop-opacity', 0.04);

      g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      // y axis (fixed)
      g.append('g').call(d3.axisLeft(y).tickValues([0, 5e6, 10e6, 15e6, 20e6]).tickFormat(function (d) { return d === 0 ? '0' : (d / 1e6) + 'M'; }))
        .call(function (s) { s.selectAll('text').attr('fill', col.muted).attr('font-size', '11px'); s.selectAll('line,path').attr('stroke', col.grid); });

      // cap line (fixed)
      g.append('line').attr('x1', 0).attr('x2', iw).attr('y1', y(CAP)).attr('y2', y(CAP)).attr('stroke', col.gold).attr('stroke-width', 1.5).attr('stroke-dasharray', '6 5').attr('opacity', 0.85);
      g.append('text').attr('x', 4).attr('y', y(CAP) + 16).attr('fill', col.gold).attr('font-size', '12px').attr('font-weight', 600).text(CAP_LABEL);

      gAxis = g.append('g').attr('transform', 'translate(0,' + ih + ')'); // x axis (redrawn each frame)
      gDyn = g.append('g'); // halving lines, area, line, tip (redrawn each frame)

      var narrow = W < 430;
      counter = svg.append('text').attr('x', margin.left).attr('y', 30).attr('fill', col.orange).attr('font-size', narrow ? '17px' : '24px').attr('font-weight', 800).style('font-variant-numeric', 'tabular-nums');
      yearT = svg.append('text').attr('x', W - margin.right).attr('y', 30).attr('text-anchor', 'end').attr('fill', col.text).attr('font-size', narrow ? '17px' : '22px').attr('font-weight', 800).style('font-variant-numeric', 'tabular-nums');
      pct = svg.append('text').attr('x', W - margin.right).attr('y', narrow ? 47 : 49).attr('text-anchor', 'end').attr('fill', col.gold).attr('font-size', narrow ? '12px' : '15px').attr('font-weight', 700);

      area = d3.area().x(function (p) { return x(p.t); }).y0(ih).y1(function (p) { return y(p.s); }).curve(d3.curveMonotoneX);
      line = d3.line().x(function (p) { return x(p.t); }).y(function (p) { return y(p.s); }).curve(d3.curveMonotoneX);
    }

    function render(cur) {
      // Stretching x axis: the domain end follows the current point (full range at 2140)
      var look = Math.max(365 * 86400000 * 1.2, (+cur - +startDate) * 0.05);
      var domEnd = new Date(Math.min(+endDate, +cur + look));
      if (+domEnd <= +startDate) domEnd = new Date(+startDate + 86400000 * 400);
      x.domain([startDate, domEnd]);

      gAxis.call(d3.axisBottom(x).ticks(W < 430 ? 4 : (W < 640 ? 5 : 7)).tickFormat(d3.timeFormat('%Y')))
        .call(function (s) { s.selectAll('text').attr('fill', col.muted).attr('font-size', '11px'); s.selectAll('line,path').attr('stroke', col.grid); });

      gDyn.selectAll('*').remove();

      // Only the named halvings (1-6) get a dashed line; synthesized eras are omitted (too many, cluttered)
      eras.forEach(function (e) {
        if (e.named && e.n > 0 && e.t <= cur && e.t <= domEnd) {
          var hx = x(e.t);
          gDyn.append('line').attr('x1', hx).attr('x2', hx).attr('y1', 0).attr('y2', ih).attr('stroke', col.muted).attr('stroke-width', 1).attr('stroke-dasharray', '3 4').attr('opacity', 0.4);
        }
      });

      // area + line (quarterly sampling + the current point)
      var dataPts = [], dd = new Date(startDate);
      while (dd <= cur) { dataPts.push({ t: new Date(dd), s: supplyAt(dd) }); dd = new Date(dd.getFullYear(), dd.getMonth() + 3, 1); }
      dataPts.push({ t: new Date(cur), s: supplyAt(cur) });
      gDyn.append('path').attr('fill', 'url(#sa-grad)').attr('d', area(dataPts));
      gDyn.append('path').attr('fill', 'none').attr('stroke', col.orange).attr('stroke-width', 2.5).attr('d', line(dataPts));
      var last = dataPts[dataPts.length - 1];
      gDyn.append('circle').attr('r', 5).attr('fill', col.orange).attr('stroke', col.bg).attr('stroke-width', 2).attr('cx', x(last.t)).attr('cy', y(last.s));

      counter.text(fmt(last.s) + ' BTC');
      pct.text((last.s / CAP * 100).toFixed(1) + '% / 21M');
      yearT.text(cur.getFullYear());
    }

    var DUR = 7200, running = false;
    function play() {
      if (running) return;
      running = true;
      var t = d3.timer(function (el) {
        var p = Math.min(1, el / DUR);
        // spend more time on the early steep rise (2009-2040); faster afterward
        var yp = Math.pow(p, 1.8);
        render(new Date(+startDate + yp * (+endDate - +startDate)));
        if (p >= 1) { t.stop(); running = false; }
      });
    }

    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function showFinal() { build(); render(endDate); }
    showFinal();

    if (!reduced && 'IntersectionObserver' in window) {
      var played = false;
      new IntersectionObserver(function (es) {
        es.forEach(function (en) { if (en.isIntersecting && !played) { played = true; render(startDate); play(); } });
      }, { threshold: 0.4 }).observe(container);
    }
    if (replayBtn) replayBtn.addEventListener('click', function () { if (reduced) { render(endDate); return; } render(startDate); play(); });

    var timer;
    window.addEventListener('resize', function () { clearTimeout(timer); timer = setTimeout(showFinal, 250); });
    if (typeof MutationObserver === 'function') new MutationObserver(showFinal).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode', 'data-theme'] });
  }
  init();
})();
</script>

<style>
  .supply-curve-animated { margin: 2rem 0; }
  .supply-curve-animated .analysis-section h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .supply-curve-animated .analysis-desc { font-size: 0.88rem; color: var(--color-text-muted); margin-top: 0; margin-bottom: 0.85rem; }
  .supply-curve-animated .chart-controls { display: flex; justify-content: flex-end; margin-bottom: 0.4rem; }
  .supply-curve-animated .replay-btn {
    padding: 3px 12px; font-size: 0.78rem; background: var(--color-bg);
    color: var(--color-text-muted); border: 1px solid var(--color-border); border-radius: 4px; cursor: pointer;
  }
  .supply-curve-animated .replay-btn:hover { color: var(--color-text); }
  .supply-curve-animated .chart-container {
    position: relative; border: 1px solid var(--color-border); border-radius: 4px; background: var(--color-bg); overflow: hidden;
  }
  .supply-curve-animated .chart-container :global(svg) { display: block; width: 100%; height: auto; }
</style>
