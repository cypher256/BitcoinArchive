---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import { useTranslations, getDisplayEntries, localePath, absoluteUrl } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const entries = await getDisplayEntries(lang);

const participantCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const entry of entries) {
  for (const p of entry.data.participants) {
    const existing = participantCounts.get(p.slug);
    if (existing) {
      existing.count++;
    } else {
      participantCounts.set(p.slug, { name: p.name, slug: p.slug, count: 1 });
    }
  }
}
const participants = Array.from(participantCounts.values()).sort((a, b) => b.count - a.count);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.participants')} - ${t('site.title')}`,
  "url": absoluteUrl('/participants/', lang),
  "description": t('participants.description'),
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.participants'),
    "numberOfItems": participants.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": participants.slice(0, 50).map((p, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": absoluteUrl(`/participants/${p.slug}/`, lang),
      "name": p.name,
    })),
  },
};
---

<BaseLayout
  title={`${t('nav.participants')} - ${t('site.title')}`}
  description={t('participants.description')}
  lang={lang}
  alternateJa={absoluteUrl('/participants/', 'ja')}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentCategory="participants"
>
    <h1>{t('nav.participants')}</h1>
    <div class="list-header">
      <input type="text" id="filter-input" class="filter-input" placeholder="Filter..." autocomplete="off" />
      <div class="sort-controls">
        <button class="sort-btn active" data-sort="count" data-order="desc">{t('sort.count' as any)} ↓</button>
        <button class="sort-btn" data-sort="name" data-order="asc">{t('sort.name' as any)} ↑</button>
      </div>
    </div>
    <ul class="participant-list" id="sort-list">
      {participants.map((p) => (
        <li data-name={p.name} data-count={p.count}>
          <a href={localePath(`/participants/${p.slug}/`, lang)} class="participant-link">
            <Avatar slug={p.slug} sizeClass="character-avatar" base={base} />
            <span class="participant-name">{p.name}</span>
          </a>
          <span class="count">({p.count})</span>
        </li>
      ))}
    </ul>
</BaseLayout>

<script>
  import { initCategoryList } from '../../scripts/list-sort';
  initCategoryList('sort-list', 'participants-sort');
</script>

<style>
  .participant-list {
    list-style: none;
    padding: 0;
  }
  .participant-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.1rem;
  }
  .participant-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }
  .count {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
