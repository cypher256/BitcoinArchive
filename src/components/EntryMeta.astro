---
import { useTranslations, localePath, translateParticipantName, findAuthorParticipant, translateTag } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { keywordCounts, keywordSlugs } from '../lib/keyword-index';
import EntryDates from './EntryDates.astro';
import TypeIcon from './TypeIcon.astro';

// Backlink-count lookup for `inlineLinkKeywords` display, sourced from
// the shared `src/lib/keyword-index.ts` helper (which Vite resolves at
// bundle time so the data lands in both `astro dev` and `astro build`).
// `keywordCounts` shape: `{ [locale]: { [keyword]: entryCount } }`.
// Absent entries imply 0 backlinks and the UI skips the "(N)" suffix.

interface Participant {
  name: string;
  slug: string;
}

interface Props {
  date: Date;
  author: string;
  entryType: string;
  source: string;
  sourceUrl?: string;
  isSatoshi: boolean;
  lang: Lang;
  participants?: Participant[];
  tags?: string[];
  /**
   * Concept keywords this entry claims as definition target. Sourced
   * from `inlineLinkKeywords` frontmatter. Rendered as a "Defines:"
   * row when the entry is editorial (analysis / article / design /
   * currency — biography is excluded since the page title already
   * names the participant, making the keyword display redundant). Each keyword is plain
   * text (not a link to itself). The actual auto-linking from other
   * entries is handled by `rehype-auto-link-keywords.mjs`.
   */
  inlineLinkKeywords?: string[];
  /**
   * X (Twitter) handle for type: tweet entries. Bare handle without
   * the leading "@" (e.g. "halfin", "CobraBitcoin"). Rendered next to
   * the byline as a linked "@handle" badge when present. The
   * check-tweet-metadata.mjs script enforces this field on every
   * type=tweet entry and verifies it agrees with sourceUrl.
   */
  xHandle?: string;
  /**
   * Content last-updated date, derived from git history (see
   * scripts/generate-git-dates.mjs and src/data/git-dates.json).
   * Conceptually distinct from `date`: `date` is the entry's historical
   * anchor, while `updatedAt` is the date of the most recent body edit.
   * Missing git metadata falls back to `date` in the shared date display.
   */
  updatedAt?: Date;
  /**
   * Content first-registered date, derived from git history. It is shown
   * together with the historical anchor and last update date.
   */
  createdAt?: Date;
  /**
   * Whether to show the byline label + author name here. Defaults to
   * true. The single-entry page sets this to false for the
   * primary-source types it renders inside `MessageBlock.astro` —
   * that component's own header already shows the avatar, name, and
   * date, so repeating the plain-text author here would be the same
   * "who wrote this" fact shown a second time on the same page.
   */
  showAuthor?: boolean;
}

const { date, author, entryType, source, lang, participants = [], tags = [], inlineLinkKeywords = [], xHandle, updatedAt, createdAt, showAuthor = true } = Astro.props;
// Keywords with 0 backlinks are dropped entirely from this row, and (per
// 2026-09-01 decision) the keyword page itself is not treated as a real
// destination either -- both a "definitely not useful" pair, decided
// together rather than the row alone. See the 0-backlink handling in
// src/pages/keywords/[keyword].astro and its JA mirror.
const isDefinesEligibleType = entryType === 'analysis' || entryType === 'article' || entryType === 'design' || entryType === 'currency';
const definedKeywords = isDefinesEligibleType
  ? inlineLinkKeywords
      .map((kw, originalIndex) => ({ kw, n: keywordCounts[lang]?.[kw] ?? 0, originalIndex }))
      .filter(({ n }) => n > 0)
      .sort((a, b) => b.n - a.n || a.originalIndex - b.originalIndex)
  : [];
const showDefinesRow = definedKeywords.length > 0;
const t = useTranslations(lang);
const typeLabel = t(`type.${entryType}` as any) || entryType;
const sourceLabel = t(`source.${source}` as any) || source;
const authorParticipant = findAuthorParticipant(author, participants);
// Editorial types `article`, `analysis`, `design`, and `currency` are
// written by Bitcoin Institute regardless of which figure or protocol
// the entry covers, so the byline forces "Bitcoin Institute". Per
// STYLE_GUIDE_CORE.md § Editorial Entries, the frontmatter `author` field
// on these types names the *subject* the entry is about (e.g. an
// article on Satoshi's alert key handover has `author: "Satoshi
// Nakamoto"`), not the editorial writer, so reflecting that raw value
// here would mislabel the page. The same forcing is mirrored at the
// OG / JSON-LD layer in pages/entries/[...slug].astro. Primary-source
// types (mailing-list, forum-post, correspondence, bip, whitepaper,
// court-document) keep the frontmatter author and pick a verb-shaped
// label per type; biography never reaches EntryMeta (it has no
// /entries/{id}/ page and is mounted in the participant page
// instead), so its author is not displayed at all.
const isEditorialType = entryType === 'article' || entryType === 'analysis' || entryType === 'design' || entryType === 'currency';
const displayAuthor = isEditorialType
  ? 'Bitcoin Institute'
  : translateParticipantName(authorParticipant?.name ?? author, authorParticipant?.slug, lang);
const bylineLabel = isEditorialType
  ? t('byline.default' as any)
  : (t(`byline.${entryType}` as any) || t('byline.default' as any));

// Color the author name in the Satoshi accent only when the author
// actually is Satoshi. The `isSatoshi` frontmatter flag means "this
// entry is about / by Satoshi" — for editorial types (article /
// analysis) the displayed author is forced to Bitcoin Institute even
// when isSatoshi is true, so the flag must not drive the author
// color. Same logic as EntryCard.
const isSatoshiAuthor =
  authorParticipant?.slug === 'satoshi-nakamoto' ||
  author.toLowerCase() === 'satoshi nakamoto';
---

<div class="entry-meta">
  <a href={localePath(`/types/${entryType}/`, lang)} class="type-badge"><TypeIcon />{typeLabel}</a>
  <a href={localePath(`/sources/${source}/`, lang)} class="type-badge source-badge"><TypeIcon />{sourceLabel}</a>
  <span class="meta-sep">&middot;</span>
  <EntryDates date={date} createdAt={createdAt} updatedAt={updatedAt} lang={lang} variant="meta" eventTime />
  {showAuthor && (
    <>
      <span class="meta-sep">&middot;</span>
      <span class="byline-label">{bylineLabel}</span>
      <span class:list={['author', { satoshi: isSatoshiAuthor }]}>{displayAuthor}</span>
      {entryType === 'tweet' && xHandle && (
        <a href={`https://x.com/${xHandle}`} class="x-handle" target="_blank" rel="noopener">@{xHandle}</a>
      )}
    </>
  )}
</div>

{participants.length > 0 && (
  <div class="participants-row">
    <span class="participants-label">{lang === 'ja' ? '人物：' : 'Figures:'}</span>
    {participants.map((p, i) => (
      <>
        <a href={localePath(`/participants/${p.slug}/`, lang)} class:list={["participant-link", { satoshi: p.name === 'Satoshi Nakamoto' }]}>{translateParticipantName(p.name, p.slug, lang)}</a>
        {i < participants.length - 1 && <span class="participant-sep">,&nbsp;</span>}
      </>
    ))}
  </div>
)}

{showDefinesRow && (
  <div class="defines-row">
    <span class="defines-label">{lang === 'ja' ? '定義：' : 'Defines:'}</span>
    {definedKeywords.map(({ kw, n }, i) => {
      const slug = keywordSlugs[lang]?.[kw];
      return (
        <>
          {slug && <a class="defines-keyword" href={localePath(`/keywords/${slug}/`, lang)}>{kw}<span class="defines-count"> ({n})</span></a>}
          {i < definedKeywords.length - 1 && <span class="defines-sep">&middot;</span>}
        </>
      );
    })}
  </div>
)}

{tags.length > 0 && (
  <div class="tags-row">
    {tags.map((tag) => (
      <a href={localePath(`/tags/${tag}/`, lang)} class="tag-link">{translateTag(tag, lang)}</a>
    ))}
  </div>
)}

<style>
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    /* Kept in sync with .participants-row / .tags-row / .defines-row --
       see the comment on .tags-row. This is the fallback that leaks
       through on the rare entry with none of those three optional rows
       (bare date/author/type line only). */
    margin-bottom: 0.25rem;
  }
  .byline-label {
    font-weight: 600;
    margin-right: -0.15rem;
  }
  .meta-sep {
    color: var(--color-border);
  }
  /* Author shown in the first meta row is non-clickable text. Tinting
     it with --color-satoshi previously made it look identical to the
     Satoshi-coloured *links* in the participants row right below, so a
     Satoshi-authored entry's header had a yellow word that wasn't a
     link sitting next to a yellow word that was. The participants row
     keeps the Satoshi accent (where it actually marks a link); the
     author label stays in the default meta text colour. */
  /* .type-badge lives in global.css -- shared with the participant
     pages' biography meta row, see the comment there. source-badge
     reuses that exact same class in the markup below (identical look,
     not just a matching shape) rather than a second CSS rule. */
  .participants-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    /* Kept in sync with .tags-row / .defines-row margin-bottom (see the
       comment on .tags-row): whichever of the three rows is last inside
       .entry-header is the one whose margin actually reaches the body
       below, so all three must carry the same value or the gap would
       depend on which optional rows a given entry happens to render. */
    margin-bottom: 0.25rem;
    gap: 0.15rem;
  }
  .participants-label {
    margin-right: 0.3rem;
    font-weight: 600;
  }
  .participant-link {
    text-decoration: none;
    color: var(--color-link);
  }
  .participant-link:hover {
    text-decoration: underline;
  }
  .participant-link.satoshi {
    color: var(--color-satoshi);
    font-weight: 600;
  }
  .participant-sep {
    color: var(--color-text-muted);
  }
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    /* .entry-header itself has no bottom padding/border, so whichever
       of .entry-meta / .participants-row / .defines-row / .tags-row
       ends up as the header's last child (depends on which optional
       rows this entry renders -- see the template above) is the one
       whose margin-bottom wins the collapse and actually reaches the
       body below, not .entry-header's own smaller margin-bottom. All
       four share this same value (and match .entry-header's
       margin-bottom in entries/[...slug].astro, both locales) so the
       visible gap stays the same regardless of which row is last. */
    margin-bottom: 0.25rem;
  }
  .tag-link {
    display: inline-block;
    padding: 0.15em 0.55em;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .tag-link:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    text-decoration: none;
  }
  .defines-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    /* Kept in sync with .tags-row / .participants-row -- see the
       comment on .tags-row for why. */
    margin-bottom: 0.25rem;
  }
  .defines-label {
    font-weight: 600;
  }
  .defines-keyword {
    color: var(--color-link);
    text-decoration: none;
  }
  .defines-keyword:hover {
    text-decoration: underline;
  }
  .defines-count {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .defines-sep {
    color: var(--color-border);
  }
</style>
