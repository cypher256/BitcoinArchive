---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import { useTranslations, getEntries, localePath, absoluteUrl } from '../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../data/threads';
import { keywordIndex } from '../../lib/keyword-index';
import { defaultSortAxis, dominantType, byDateAxisDesc } from '../../lib/dateAxis';
import { siblingPrevNext } from '../../lib/siblingNav';
import gitDates from '../../data/git-dates.json';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

export async function getStaticPaths() {
  type SiblingRef = { slug: string; label: string };
  const out: Array<{ params: { keyword: string }; props: { keyword: string; jaSlug?: string; prevKeyword: SiblingRef | null; nextKeyword: SiblingRef | null } }> = [];
  // Only keywords with at least one backlink get a page (2026-09-01
  // decision): a 0-backlink keyword's dedicated page has nothing to show
  // beyond a pre-filled search link -- the underlying Algolia full-text
  // search at /entries/ already finds any keyword's occurrences on demand
  // regardless of whether a landing page exists, so the page itself
  // wasn't adding search capability, just a shortcut to it. The original
  // "every declared keyword is browsable" rationale (commit d5dd4005d)
  // was reversed once dead-page/dead-link cascades kept surfacing through
  // it this session. Every consumer of the slug map -- this loop, the
  // JA-alternate lookup below, sibling ordering, and
  // /keywords/index.astro's listing -- must apply the same filter or a
  // 0-backlink keyword's absence here still leaves dangling links
  // elsewhere.
  const enSlugs: Record<string, string> = Object.fromEntries(
    Object.entries(keywordIndex.en?.slugs ?? {}).filter(([, kw]) => (keywordIndex.en?.counts?.[kw] ?? 0) > 0)
  );
  const jaSlugs: Record<string, string> = Object.fromEntries(
    Object.entries(keywordIndex.ja?.slugs ?? {}).filter(([, kw]) => (keywordIndex.ja?.counts?.[kw] ?? 0) > 0)
  );
  // Build target -> JA slug index so we can locate the JA mirror page.
  const jaSlugByTarget = new Map<string, string>();
  for (const [s, kw] of Object.entries(jaSlugs)) {
    const target = (keywordIndex.ja?.concept ?? {})[kw] ||
      (keywordIndex.ja?.person ?? {})[kw];
    if (target && !jaSlugByTarget.has(target)) jaSlugByTarget.set(target, s);
  }
  // Prev/next siblings, ordered alphabetically by keyword text -- see
  // src/pages/sources/[source].astro for the rationale.
  const sortedSlugs = Object.keys(enSlugs).sort((a, b) => enSlugs[a].localeCompare(enSlugs[b]));
  for (const [slug, keyword] of Object.entries(enSlugs)) {
    const target = (keywordIndex.en?.concept ?? {})[keyword] ||
      (keywordIndex.en?.person ?? {})[keyword];
    const jaSlug = target ? jaSlugByTarget.get(target) : undefined;
    const { prev: prevSlug, next: nextSlug } = siblingPrevNext(sortedSlugs, slug);
    out.push({
      params: { keyword: slug },
      props: {
        keyword,
        jaSlug,
        prevKeyword: prevSlug ? { slug: prevSlug, label: enSlugs[prevSlug] } : null,
        nextKeyword: nextSlug ? { slug: nextSlug, label: enSlugs[nextSlug] } : null,
      },
    });
  }
  return out;
}

const lang = 'en';
const t = useTranslations(lang);
const { keyword, jaSlug, prevKeyword, nextKeyword } = Astro.props;

const localeData = keywordIndex.en;
const conceptTarget = localeData.concept[keyword];
const personTarget = localeData.person[keyword];
const definitionKind: 'concept' | 'person' | null = conceptTarget
  ? 'concept'
  : (personTarget ? 'person' : null);
const definitionTarget = conceptTarget || personTarget || null;
const backlinkIds = localeData.backlinks[keyword] ?? [];

const entries = await getEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);
const backlinks = entries.filter((e) => backlinkIds.includes(e.id));
// Default axis from this keyword's dominant backlink type — see
// dateAxis.ts. (Unlike /types, /sources, /tags this can't be resolved in
// getStaticPaths: keywordIndex only carries slugs/targets, not entry
// types, so the backlink type distribution is only known here.)
const sortAxis = defaultSortAxis(dominantType(backlinks.map((e) => e.data.type)));
const displayBacklinks = collapseThreads(backlinks, threadCounts, threadStarters)
  .sort(byDateAxisDesc(sortAxis, (id) => gitDateMap[id]?.en?.createdAt));

const definitionEntry = definitionKind === 'concept' && definitionTarget
  ? entries.find((e) => e.id === definitionTarget)
  : undefined;

const searchHref = `${localePath('/entries/', lang)}?q=${encodeURIComponent(keyword)}`;

const pageDescription =
  `Backlinks and search results for the keyword "${keyword}" — ` +
  `a per-keyword view onto where this term is referenced across the archive.`;
---

<BaseLayout
  title={`${keyword} — keyword backlinks - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateJa={jaSlug ? absoluteUrl(`/keywords/${jaSlug}/`, 'ja') : null}
  pageWidth="wide"
  sidebarCurrentCategory="keywords"
>
    <PrevNextNav
      top
      prev={prevKeyword && { href: localePath(`/keywords/${prevKeyword.slug}/`, lang), label: prevKeyword.label }}
      next={nextKeyword && { href: localePath(`/keywords/${nextKeyword.slug}/`, lang), label: nextKeyword.label }}
    />
    <h1>{keyword}</h1>
    <p class="page-lead">
      Keyword reference — entries that mention this term in body prose.
    </p>

    {definitionKind === 'concept' && definitionEntry && (
      <div class="definition-callout">
        <span class="definition-label">Defined in:</span>
        <a href={localePath(`/entries/${definitionEntry.id}/`, lang)}>{definitionEntry.data.title}</a>
      </div>
    )}
    {definitionKind === 'person' && definitionTarget && (
      <div class="definition-callout">
        <span class="definition-label">Person:</span>
        <a href={localePath(`/participants/${definitionTarget}/`, lang)}>{keyword}</a>
      </div>
    )}

    <div class="filter-row">
      <input type="text" id="filter-input" class="filter-input" placeholder="Filter..." aria-label="Filter" autocomplete="off" />
    </div>
    <div class="list-header">
      <p class="entry-count">
        <span id="entry-count-num">{displayBacklinks.length}</span> entries reference this keyword in body prose.
      </p>
      <div class="sort-controls">
        <button class:list={['sort-btn', { active: sortAxis === 'date' }]} data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
        <button class:list={['sort-btn', { active: sortAxis === 'created' }]} data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
        <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
      </div>
    </div>

    <div id="keyword-entries-list">
    {displayBacklinks.map((entry) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      return (
        <EntryCard
          id={entry.id}
          title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
          date={entry.data.date}
          author={entry.data.author}
          entryType={entry.data.type}
          source={entry.data.source}
          description={entry.data.description}
          isSatoshi={entry.data.isSatoshi}
          lang={lang}
          threadId={isThread ? tid : undefined}
          threadCount={isThread ? msgCount : undefined}
          participants={entry.data.participants}
          createdAt={gitDateMap[entry.id]?.en?.createdAt}
          updatedAt={gitDateMap[entry.id]?.en?.updatedAt}
        />
      );
    })}
    </div>
    <script>
      import { initListSort, initListFilter } from '../../scripts/list-sort';
      initListSort('keyword-entries-list');
      initListFilter('keyword-entries-list', 'filter-input');
    </script>

    <aside class="search-cta">
      <p>
        Looking for related entries that don't directly reference this term?
      </p>
      <a class="search-cta-link" href={searchHref}>
        Search "{keyword}" across the archive (fuzzy)
        &rarr;
      </a>
      <p class="search-cta-note">
        Search is typo-tolerant and matches partial words; it surfaces
        loosely-related material that the structural backlink list above
        cannot.
      </p>
    </aside>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; word-break: break-word; }
  .filter-row {
    max-width: 28rem;
    margin-bottom: 0.75rem;
  }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }
  .definition-callout {
    margin: 0.75rem 0 1rem 0;
    padding: 0.6rem 0.9rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 3px 3px 0;
    font-size: 0.9rem;
  }
  .definition-label {
    font-weight: 600;
    margin-right: 0.4rem;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 0;
  }
  .search-cta {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .search-cta p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .search-cta-link {
    display: inline-block;
    margin: 0.5rem 0;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-link);
  }
  .search-cta-link:hover {
    text-decoration: underline;
  }
  .search-cta-note {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }
</style>
