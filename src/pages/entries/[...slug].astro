---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import SourceCitation from '../../components/SourceCitation.astro';
import RelatedEntries from '../../components/RelatedEntries.astro';
import CommentaryLinks from '../../components/CommentaryLinks.astro';
import SatoshiCodeAnalysis from '../../components/SatoshiCodeAnalysis.astro';
import SatoshiActivityTimeline from '../../components/SatoshiActivityTimeline.astro';
import PatoshiNonceLsb from '../../components/PatoshiNonceLsb.astro';
import SvnCommitters from '../../components/SvnCommitters.astro';
import PatoshiMiningMachine from '../../components/PatoshiMiningMachine.astro';
import ValueOverflowTimeline from '../../components/ValueOverflowTimeline.astro';
import GenesisBlockGap from '../../components/GenesisBlockGap.astro';
import LoppHashrateAnalysis from '../../components/LoppHashrateAnalysis.astro';
import PatoshiExtraNonce from '../../components/PatoshiExtraNonce.astro';
import PlosPatoshiAnomaly from '../../components/PlosPatoshiAnomaly.astro';
import GitHubMigrationTimeline from '../../components/GitHubMigrationTimeline.astro';
import SatoshiHoldingsComparison from '../../components/SatoshiHoldingsComparison.astro';
import WhaleAlertFortune from '../../components/WhaleAlertFortune.astro';
import NlsExchangeRate from '../../components/NlsExchangeRate.astro';
import StylometricDistanceHistogram from '../../components/StylometricDistanceHistogram.astro';
import BitcoinForkGenealogy from '../../components/BitcoinForkGenealogy.astro';
import SupplyCurveComparison from '../../components/SupplyCurveComparison.astro';
import DesignSeriesNav from '../../components/DesignSeriesNav.astro';
import ParentLink from '../../components/ParentLink.astro';
import BarChartRace from '../../components/BarChartRace.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, localePath, absoluteUrl, findAuthorParticipant } from '../../i18n/utils';
import Avatar from '../../components/Avatar.astro';
import { resolveThreadId } from '../../data/threads';
import { renderEditorNote } from '../../lib/editor-note';
import { heroBannerPosition } from '../../lib/heroBanner';
import { LABELS as EDITORIAL_LABELS } from '../../lib/remark-editorial-marker.mjs';
import gitDates from '../../data/git-dates.json';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const jaEntries = await getCollection('entries_ja');
  const jaIds = new Set(jaEntries.filter((e) => e.data.type !== 'biography').map((e) => e.id));
  return entries.filter((e) => e.data.type !== 'biography').map((entry) => ({
    params: { slug: entry.id },
    props: { entry, hasJa: jaIds.has(entry.id) },
  }));
}

const lang = 'en';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const { entry, hasJa } = Astro.props;
const { Content } = await render(entry);

const allEntries = await getCollection('entries');
const sorted = allEntries.filter((e) => e.data.type !== 'biography').sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const currentIndex = sorted.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const next = currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;

const threadId = resolveThreadId(entry);
const threadMessages = threadId
  ? allEntries.filter((e) => resolveThreadId(e) === threadId).length
  : 0;
const entryById = new Map(allEntries.map((e) => [e.id, e]));
const commentaryThreadLinks = new Map<string, { id: string; messages: number }>();
if (entry.data.type === 'article' || entry.data.type === 'analysis' || entry.data.type === 'design') {
  for (const q of entry.data.quotes ?? []) {
    if (!q.sourceEntryId) continue;
    const sourceEntry = entryById.get(q.sourceEntryId);
    if (!sourceEntry) continue;
    const sourceThreadId = resolveThreadId(sourceEntry);
    if (!sourceThreadId || commentaryThreadLinks.has(sourceThreadId)) continue;
    const sourceThreadMessages = allEntries.filter((e) => resolveThreadId(e) === sourceThreadId).length;
    if (sourceThreadMessages >= 2) {
      commentaryThreadLinks.set(sourceThreadId, {
        id: sourceThreadId,
        messages: sourceThreadMessages,
      });
    }
  }
}
const breadcrumbs = [
  { name: t('nav.home'), url: localePath('/', lang) },
  { name: t('nav.entries'), url: localePath('/entries/', lang) },
  { name: entry.data.title, url: localePath(`/entries/${entry.id}/`, lang) },
];

// Content last-updated date from git history (separate axis from
// frontmatter.date which is the entry's anchor to the historical event).
// git-dates.json keys per-language records (en / ja). EN and JA are usually
// edited together so the two updatedAt values are typically identical, but they
// diverge legitimately when only one side is touched (e.g. a JA-only translation
// pass). Each language page reads its own record.
type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateRecord = (gitDates as Record<string, GitDateRecord>)[entry.id]?.en;
const createdAt = gitDateRecord?.createdAt ? new Date(gitDateRecord.createdAt) : undefined;
const updatedAt = gitDateRecord?.updatedAt ? new Date(gitDateRecord.updatedAt) : undefined;
// OGP / structured-data dates. For analysis entries the editorial
// creation date is the meaningful published time (frontmatter.date
// is the date of the underlying event being analysed, not of the
// analysis writing). Other types keep frontmatter.date as the
// published time. modifiedTime is the git-history updatedAt for all
// types when available.
const isAnalysis = entry.data.type === 'analysis' || entry.data.type === 'design';
const ogPublishedTime = isAnalysis ? (createdAt ?? updatedAt ?? entry.data.date) : entry.data.date;
const ogModifiedTime = updatedAt ?? entry.data.date;
// OG / JSON-LD author. For editorial types the frontmatter `author`
// names the subject the entry is about (per STYLE_GUIDE.md § Editorial
// Entries → Frontmatter author semantics), not the editorial writer.
// The on-page byline in EntryMeta forces "Bitcoin Institute" for the
// same reason; mirror that forcing here so structured-data and OGP
// metadata cite the actual writer of the content, not the subject.
const isEditorialType = entry.data.type === 'article' || entry.data.type === 'analysis' || entry.data.type === 'design';
const ogAuthor = isEditorialType ? 'Bitcoin Institute' : entry.data.author;
// Title avatar: Bitcoin Institute for editorial types (article /
// analysis / design), else the byline participant. null when no
// participant resolves (then no avatar shows before the title).
const titleAvatarParticipant = findAuthorParticipant(entry.data.author, entry.data.participants);
const titleAvatarSlug = isEditorialType ? 'bitcoin-institute' : titleAvatarParticipant?.slug;
const heroBannerOffset = heroBannerPosition(entry.id);
---

<BaseLayout
  title={`${entry.data.title} - ${t('site.title')}`}
  description={entry.data.description}
  lang={lang}
  alternateJa={hasJa ? absoluteUrl(`/entries/${entry.id}/`, 'ja') : undefined}
  ogType="article"
  publishedTime={ogPublishedTime}
  modifiedTime={ogModifiedTime}
  author={ogAuthor}
  ogImage={`/og/${entry.id}.png`}
  breadcrumbs={breadcrumbs}
>
  <article class="container">
    <nav class="entry-nav entry-nav-top">
      {prev && (
        <a href={localePath(`/entries/${prev.id}/`, lang)} class="nav-prev">
          &larr; {prev.data.title}
        </a>
      )}
      {next && (
        <a href={localePath(`/entries/${next.id}/`, lang)} class="nav-next">
          {next.data.title} &rarr;
        </a>
      )}
    </nav>
    <header class="entry-header">
      <div class="entry-title-row" style={`background-image: url(${base}images/hero-banners/atmosphere.jpg); background-position: ${heroBannerOffset}% center;`}>
        {titleAvatarSlug && <Avatar slug={titleAvatarSlug} sizeClass="entry-author-avatar" base={base} />}
        <h1>{entry.data.title}</h1>
      </div>
      <EntryMeta
        date={entry.data.date}
        author={entry.data.author}
        entryType={entry.data.type}
        source={entry.data.source}
        sourceUrl={entry.data.sourceUrl}
        isSatoshi={entry.data.isSatoshi}
        lang={lang}
        participants={entry.data.participants}
        tags={entry.data.tags}
        inlineLinkKeywords={entry.data.inlineLinkKeywords}
        xHandle={entry.data.xHandle}
        updatedAt={updatedAt}
        createdAt={createdAt}
      />
    </header>

    <ParentLink lang={lang} partOf={entry.data.partOf} />

    {['correspondence', 'mailing-list', 'forum-post', 'bip', 'whitepaper', 'court-document', 'tweet', 'blog-post'].includes(entry.data.type) && (
      <CommentaryLinks lang={lang} entryId={entry.id} entryType={entry.data.type} />
    )}

    {entry.data.editorNote && (
      <aside class="editorial-note editorial-note--editor">
        <span class="editorial-note-label">{EDITORIAL_LABELS['editor:en']}</span>
        <span class="editorial-note-body" set:html={renderEditorNote(entry.data.editorNote)}></span>
      </aside>
    )}

    {entry.id.includes('value-overflow-incident') && (
      <ValueOverflowTimeline lang={lang} />
    )}

    {entry.id.includes('genesis-block-5-day-mystery') && (
      <GenesisBlockGap lang={lang} />
    )}

    {entry.id.includes('van-dorst-corpus-reanalysis-named-candidates') && (
      <StylometricDistanceHistogram lang={lang} />
    )}

    {entry.id.includes('bitcoin-fork-and-altcoin-genealogy') && (
      <BitcoinForkGenealogy lang={lang} />
    )}

    {entry.id.includes('satoshi-design-vs-current-reality') && (
      <BitcoinForkGenealogy lang={lang} />
    )}

    {entry.id.includes('fixed-supply-vs-adjustable-money') && (
      <SupplyCurveComparison lang={lang} />
    )}

    {entry.data.type === 'design' && (
      <DesignSeriesNav lang={lang} slug={entry.id} />
    )}

    <div class:list={["entry-content", { "conversation-thread": entry.data.isConversation }]}>
      <Content />
    </div>

    {entry.data.type === 'analysis' && entry.id.includes('satoshi-code') && (
      <SatoshiCodeAnalysis lang={lang} />
    )}

    {entry.data.type === 'analysis' && entry.id.includes('satoshi-activity-timeline') && (
      <SatoshiActivityTimeline lang={lang} />
    )}

    {entry.id.includes('sergio-lerner-nonce-lsb') && (
      <PatoshiNonceLsb lang={lang} />
    )}

    {entry.id.includes('bitcoin-svn-repository-committers') && (
      <SvnCommitters lang={lang} />
    )}

    {entry.id.includes('sergio-lerner-patoshi-mining-machine') && (
      <PatoshiMiningMachine lang={lang} />
    )}

    {entry.id.includes('lopp-was-satoshi-greedy-miner') && (
      <LoppHashrateAnalysis lang={lang} />
    )}

    {entry.id.includes('satoshi-design-vs-current-reality') && (
      <LoppHashrateAnalysis lang={lang} />
    )}

    {entry.id.includes('sergio-lerner-patoshi-analysis') && (
      <PatoshiExtraNonce lang={lang} />
    )}

    {entry.id.includes('plos-one-patoshi-anomaly-study') && (
      <PlosPatoshiAnomaly lang={lang} />
    )}

    {entry.id.includes('bitcoin-github-migration-committers') && (
      <GitHubMigrationTimeline lang={lang} />
    )}

    {entry.id.includes('satoshi-bitcoin-holdings-analysis') && (
      <SatoshiHoldingsComparison lang={lang} />
    )}

    {entry.id.includes('whale-alert-satoshi-fortune') && (
      <WhaleAlertFortune lang={lang} />
    )}

    {entry.id.includes('newlibertystandard-first-exchange-rate') && (
      <NlsExchangeRate lang={lang} />
    )}

    {entry.id.includes('bitcoin-fork-and-altcoin-genealogy') && (
      <BarChartRace lang={lang} raceId="crypto" />
    )}

    {entry.id.includes('bitcoin-digital-gold-structural-features') && (
      <BarChartRace lang={lang} raceId="assets" />
    )}

    {entry.id.includes('whale-alert-satoshi-fortune') && (
      <BarChartRace lang={lang} raceId="wealth" />
    )}

    {threadId && threadMessages >= 2 && (
      <div class="thread-banner">
        <a href={localePath(`/entries/threads/${threadId}/`, lang)}>
          View full thread ({threadMessages} messages) &rarr;
        </a>
      </div>
    )}

    {[...commentaryThreadLinks.values()].map((thread) => (
      <div class="thread-banner">
        <a href={localePath(`/entries/threads/${thread.id}/`, lang)}>
          View full thread ({thread.messages} messages) &rarr;
        </a>
      </div>
    ))}

    <RelatedEntries lang={lang} entryId={entry.id} relatedIds={entry.data.relatedEntries ?? []} />

    <SourceCitation
      sourceUrl={entry.data.sourceUrl}
      sourceNote={entry.data.sourceNote}
      secondarySources={entry.data.secondarySources}
      pdfMetadata={entry.data.pdfMetadata}
      lang={lang}
      entryType={entry.data.type}
    />

    <nav class="entry-nav">
      {prev && (
        <a href={localePath(`/entries/${prev.id}/`, lang)} class="nav-prev">
          &larr; {prev.data.title}
        </a>
      )}
      {next && (
        <a href={localePath(`/entries/${next.id}/`, lang)} class="nav-next">
          {next.data.title} &rarr;
        </a>
      )}
    </nav>
  </article>

  {isEditorialType && (
    <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-embeds.js'}></script>
  )}
</BaseLayout>

<style>
  .entry-header {
    padding-top: 2rem;
    margin-bottom: 2rem;
  }
  .entry-header h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
  }
  /* The h1 renders as real text directly on the atmosphere banner
     (dark gradient + grain, see generate-hero-banners.mjs) instead of a
     separate decorative image above the header — one hero moment, not
     two stacked ones. Colors are fixed regardless of site theme since
     the backdrop is always dark. */
  .entry-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-size: cover;
    background-position: center;
    border-radius: 10px;
    padding: 2.25rem 2rem;
    margin-bottom: 0.75rem;
  }
  .entry-title-row h1 {
    margin: 0;
    color: #f5f4f1;
    /* Prevents a lone trailing word stranded alone on the last line —
       the browser rebalances line breaks across the whole heading
       instead of wrapping greedily. */
    text-wrap: balance;
  }
  /* .entry-title-row .avatar background override lives in global.css —
     a scoped rule here can't reach Avatar.astro's rendered <img>. */
  @media (max-width: 767px) {
    /* Narrow screens: the row's own padding was eating enough width to
       force 3-4 line wraps on long titles. Shrink it, and let the
       banner itself bleed to the viewport edges (cancel .container's
       1rem padding here) instead of staying inset as a rounded card —
       both changes free up the same horizontal space the title needs. */
    .entry-title-row {
      margin-inline: -1rem;
      border-radius: 0;
      padding: 1.5rem 1rem;
    }
  }
  .entry-content {
    line-height: 1.8;
  }
  /* blockquote styling lives in global.css (`blockquote` + the
     speaker-tagged variant `blockquote[data-speaker="satoshi"]`).
     Re-declaring the base rule here as `.entry-content :global(blockquote)`
     used to silently override the global Satoshi accent because the
     scoped parent class bumped specificity above the data-speaker
     selector. Removed to let global.css win unchanged. */
  .entry-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .nav-prev, .nav-next {
    max-width: 45%;
  }
  .entry-nav-top {
    margin-top: 0;
    padding-top: 1rem;
    border-top: none;
    margin-bottom: 0;
  }
  .nav-next {
    margin-left: auto;
    text-align: right;
  }
  .thread-banner {
    margin: 1.5rem 0;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .thread-banner a {
    font-weight: 600;
  }
</style>
