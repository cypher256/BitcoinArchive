---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import EntryDates from '../../components/EntryDates.astro';
import { render } from 'astro:content';
import { useTranslations, getEntries, getBiographyForParticipant, localePath, absoluteUrl } from '../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../data/threads';
import Avatar from '../../components/Avatar.astro';
import TypeIcon from '../../components/TypeIcon.astro';
import gitDates from '../../data/git-dates.json';
import ChartEmbedRuntime from '../../components/ChartEmbedRuntime.astro';
import VisualEmbedRuntime from '../../components/VisualEmbedRuntime.astro';
import { PARTICIPANT_NOTES } from '../../data/participant-notes';
import TocNav from '../../components/TocNav.astro';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

export async function getStaticPaths() {
  const { getEntries, getDisplayEntries } = await import('../../i18n/utils');
  const entries = await getEntries('en');
  const displayEntries = await getDisplayEntries('en');
  const slugs = new Set<string>();
  const nameMap = new Map<string, string>();
  for (const entry of entries) {
    for (const p of entry.data.participants) {
      slugs.add(p.slug);
      nameMap.set(p.slug, p.name);
    }
  }
  const countMap = new Map<string, number>();
  for (const entry of displayEntries) {
    for (const p of entry.data.participants) {
      countMap.set(p.slug, (countMap.get(p.slug) || 0) + 1);
    }
  }
  // 日本語側に存在する参加者 slug を取得
  const jaEntries = await getEntries('ja');
  const jaSlugs = new Set<string>();
  for (const entry of jaEntries) {
    for (const p of entry.data.participants) {
      jaSlugs.add(p.slug);
    }
  }

  const sorted = Array.from(slugs).sort((a, b) => (countMap.get(b) || 0) - (countMap.get(a) || 0));
  return sorted.map((slug, i) => ({
    params: { participant: slug },
    props: {
      participantSlug: slug,
      participantName: nameMap.get(slug)!,
      prevParticipant: i > 0 ? { slug: sorted[i - 1], name: nameMap.get(sorted[i - 1])! } : null,
      nextParticipant: i < sorted.length - 1 ? { slug: sorted[i + 1], name: nameMap.get(sorted[i + 1])! } : null,
      hasJa: jaSlugs.has(slug),
    },
  }));
}

const lang = 'en';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const { participantSlug, participantName, prevParticipant, nextParticipant, hasJa } = Astro.props;
const entries = await getEntries(lang);
const filtered = entries.filter((e) =>
  e.data.participants.some((p) => p.slug === participantSlug)
);

const allEntries = await getEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(allEntries, lang);
const biographyEntry = await getBiographyForParticipant(lang, participantSlug);
const biographyContent = biographyEntry ? await render(biographyEntry) : null;
const biographyGitDate = biographyEntry ? gitDateMap[biographyEntry.id]?.en : undefined;
// Recommended-analysis callout. The biography frontmatter declares
// `callout: { entry, label }` if a single analysis page should be
// surfaced near the top of the participant page. No callout when
// the field is unset.
const calloutSpec = biographyEntry?.data.callout;
const calloutTarget = calloutSpec
  ? allEntries.find((e) => e.id === calloutSpec.entry)
  : undefined;
const nonBio = filtered.filter((e) => e.data.type !== 'biography');
// Default order is "recently added" (created desc), same axis as /entries.
const createdKey = (id: string, fallback: Date): string => gitDateMap[id]?.en?.createdAt ?? fallback.toISOString();
const displayEntries = collapseThreads(nonBio, threadCounts, threadStarters)
  .slice()
  .sort((a, b) => createdKey(b.id, b.data.date).localeCompare(createdKey(a.id, a.data.date)));
const lifeDatesMatch = biographyEntry?.data.title.match(/[（(]([^)）]+)[)）]/);
const lifeDatesRaw = lifeDatesMatch ? lifeDatesMatch[0] : null;
const lifeDates = lifeDatesRaw && !/生没年不明|dates unknown/.test(lifeDatesRaw) ? lifeDatesRaw : null;
// Fallback for participants with no biography entry: a short, individually
// researched and sourced note (see src/data/participant-notes.ts). Only
// used when there is no biography entry at all — a biography's own title
// always wins, even if its role suffix fails to parse.
const bioSubtitle = biographyEntry
  ? (biographyEntry.data.title.match(/—\s*(.+)/)?.[1] ?? null)
  : (PARTICIPANT_NOTES[participantSlug]?.hookEn ?? null);
const biographyDescription = biographyEntry?.data.description?.replace(/^[^：:]+[：:]\s*/, '') ?? '';
const canonicalUrl = absoluteUrl(`/participants/${participantSlug}/`, lang);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": `${participantName} - ${t('site.title')}`,
    "url": canonicalUrl,
    "inLanguage": lang,
    "mainEntity": {
      "@id": `${canonicalUrl}#person`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${canonicalUrl}#person`,
    "name": participantName,
    ...(biographyDescription ? { "description": biographyDescription } : {}),
    "url": canonicalUrl,
    "subjectOf": {
      "@type": "ItemList",
      "name": `Entries involving ${participantName}`,
      "numberOfItems": displayEntries.length,
    },
  },
];

// og:image — prefer the biography's hero illustration when one exists
// (embedded as the body's first image, see STYLE_GUIDE_CORE.md "Hero
// Images"); the generated /og/participants/ text card stays the
// fallback for the ~337 participants without a biography. Captured
// without the MIRROR_BASE prefix — BaseHead prepends PRIMARY_ORIGIN.
const heroOgMatch = (biographyEntry?.body ?? '').match(
  /!\[[^\]]*\]\((?:\/BitcoinArchive)?(\/images\/analysis\/[^)\s]+-hero\.png)\)/,
);
const heroOgImage = heroOgMatch ? heroOgMatch[1] : null;
---

<BaseLayout
  title={`${participantName}${bioSubtitle ? ` — ${bioSubtitle}` : ''} - ${t('site.title')}`}
  description={biographyEntry?.data.description ?? `Archive of ${participantName}'s communications in Bitcoin's early history — forum posts, emails, and technical discussions`}
  lang={lang}
  alternateJa={hasJa ? absoluteUrl(`/participants/${participantSlug}/`, 'ja') : undefined}
  ogImage={heroOgImage ?? `/og/participants/${participantSlug}.png`}
  ogImageWidth={heroOgImage ? 1600 : undefined}
  ogImageHeight={heroOgImage ? 900 : undefined}
  structuredData={structuredData}
  pageWidth="read"
>
  <TocNav slot="sidebar-extra" lang={lang} contentSelector=".biography-content" />
    <nav class="participant-nav participant-nav-top">
      {prevParticipant ? (
        <a href={localePath(`/participants/${prevParticipant.slug}/`, lang)} class="nav-prev">&larr; {prevParticipant.name}</a>
      ) : <span />}
      {nextParticipant ? (
        <a href={localePath(`/participants/${nextParticipant.slug}/`, lang)} class="nav-next">{nextParticipant.name} &rarr;</a>
      ) : <span />}
    </nav>
    <div class:list={['participant-head', !biographyEntry && 'participant-head--no-dates']}>
      <Avatar slug={participantSlug} sizeClass="participant-avatar" base={base} />
      <div class="participant-head-text">
        <h1>{participantName}{lifeDates && <span class="life-dates"> {lifeDates}</span>}</h1>
        {bioSubtitle && <p class="bio-subtitle">{bioSubtitle}</p>}
      </div>
    </div>
    {biographyEntry && (
      <div class="bio-meta-row">
        <a href={localePath('/participants/', lang)} class="type-badge"><TypeIcon />{t('nav.participants' as any)}</a>
        <EntryDates
          date={biographyEntry.data.date}
          createdAt={biographyGitDate?.createdAt}
          updatedAt={biographyGitDate?.updatedAt}
          lang={lang}
          variant="biography"
        />
      </div>
    )}

    {calloutTarget && calloutSpec && (
      <a class="hypothesis-callout" href={localePath(`/entries/${calloutTarget.id}/`, lang)}>
        <span class="hypothesis-icon">🔍</span>
        <span class="hypothesis-label">{calloutSpec.label}</span>
        <span class="hypothesis-arrow">&rarr;</span>
      </a>
    )}

    {biographyContent && (
      <section class="biography-section">
        <div class="biography-content">
          <biographyContent.Content />
        </div>
      </section>
    )}

    {biographyContent ? (
      <div class="entries-header">
        <h2 class="entries-heading">{t('participant.relatedEntries' as any)}</h2>
        {displayEntries.length > 0 && (
          <div class="sort-controls">
            <button class="sort-btn" data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
            <button class="sort-btn active" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
            <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
          </div>
        )}
      </div>
    ) : null}
    <div class="list-header">
      <p class="entry-count">{displayEntries.length} entries</p>
      {!biographyContent && displayEntries.length > 0 && (
        <div class="sort-controls">
          <button class="sort-btn" data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
          <button class="sort-btn active" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
          <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
        </div>
      )}
    </div>
    <div id="participant-entries-list">
      {displayEntries.map((entry) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            entryType={entry.data.type}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            createdAt={gitDateMap[entry.id]?.en?.createdAt}
            updatedAt={gitDateMap[entry.id]?.en?.updatedAt}
          />
        );
      })}
    </div>
    <script>
      import { initListSort } from '../../scripts/list-sort';
      initListSort('participant-entries-list');
    </script>

    <nav class="participant-nav">
      {prevParticipant ? (
        <a href={localePath(`/participants/${prevParticipant.slug}/`, lang)} class="nav-prev">&larr; {prevParticipant.name}</a>
      ) : <span />}
      {nextParticipant ? (
        <a href={localePath(`/participants/${nextParticipant.slug}/`, lang)} class="nav-next">{nextParticipant.name} &rarr;</a>
      ) : <span />}
    </nav>

  {biographyContent && <ChartEmbedRuntime />}
  {biographyContent && <VisualEmbedRuntime />}
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .life-dates {
    font-weight: normal;
    font-size: 0.6em;
    color: var(--color-text-muted);
  }
  .bio-subtitle {
    /* No bottom margin here: the gap below the title block is owned by
       .entry-dates--biography's margin-top (or .participant-head--no-dates's
       margin-bottom when there's no biography) -- see .participant-head's
       comment. A margin here would grow .participant-head-text's own
       height, which align-items: center on .participant-head uses to
       centre the avatar, shifting it off-centre again. */
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    font-weight: normal;
  }
  .hypothesis-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 3px 3px 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-link);
  }
  .hypothesis-callout:hover {
    text-decoration: underline;
  }
  .hypothesis-callout .hypothesis-arrow {
    color: var(--color-text-muted);
  }
  .biography-section {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
  }
  .biography-content {
    line-height: 1.8;
  }
  /* Same shape as .section-header on the home page: a heading with a
     trailing action (sort buttons here, "view all" there) shares one
     row, and the border sits on that row so the line reaches under
     the action too — not on the heading alone. .biography-section's
     own bottom spacing already separates this row from the prose
     above, so no extra margin-top is needed here. */
  .entries-header {
    display: flex;
    justify-content: space-between;
    /* center, not baseline: the sort buttons are a padded 40px-tall box,
       not text — baseline-aligning them against the h2's text baseline
       left the buttons sitting visibly lower than the heading. */
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: var(--heading-underline-gap);
    border-bottom: 1px solid var(--color-border-strong);
  }
  /* Optical correction on top of align-items:center: the heading
     glyphs sit higher within their own line box than a button's
     padded box sits within its box, so mathematically-centered still
     reads as the buttons being slightly low. Nudge up a few px. */
  .entries-header .sort-controls {
    transform: translateY(-2px);
  }
  .entries-heading {
    margin: 0;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
  }
  .participant-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .participant-nav-top {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: none;
    /* 0, not a value of its own: .participant-head's margin-top is the
       single owner of the gap to this nav (see its comment). A nonzero
       value here would only matter if it exceeded that margin-top and
       won the collapse, which would silently make this the real owner
       instead. */
    margin-bottom: 0;
  }
  .nav-next {
    margin-left: auto;
  }
  .participant-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    /* No padding on this element, ever: align-items: center centers the
       avatar against whichever sibling (avatar or .participant-head-text)
       is taller, using their own content height only. Asymmetric padding
       (more on one side than the other) on either sibling shifts that
       sibling's visual content off the centre of its own box without
       moving the other sibling, so the two go out of alignment (this
       broke once already -- see git blame/history on this rule before
       adding padding back here or on .participant-head-text).

       margin-top is the single source of the gap above this block (from
       the prev/next nav). The gap below is likewise owned by exactly one
       declaration elsewhere: .entry-dates--biography's own margin-top
       (global.css) when a biography follows, or the modifier class below
       when it doesn't -- margin-bottom stays 0 here so this element is
       never a second source of that gap. */
    margin-top: 3rem;
    margin-bottom: 0;
  }
  /* Participants with no biography entry never render <EntryDates>
     below this block (see the template), so nothing else provides the
     gap before whatever follows (callout or entries list). */
  .participant-head--no-dates {
    margin-bottom: 3rem;
  }
  .participant-head-text {
    min-width: 0;
  }
  .participant-head-text h1 {
    margin: 0;
  }
</style>
