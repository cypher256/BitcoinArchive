---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import PrevNextNav from '../../components/PrevNextNav.astro';
import { useTranslations, getDisplayEntries, absoluteUrl, localePath } from '../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../data/threads';
import { defaultSortAxis, dominantType, byDateAxisDesc } from '../../lib/dateAxis';
import { siblingPrevNext } from '../../lib/siblingNav';
import gitDates from '../../data/git-dates.json';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

export async function getStaticPaths() {
  const { getDisplayEntries } = await import('../../i18n/utils');
  const entries = await getDisplayEntries('en');
  const tags = new Set<string>();
  // Collect each tag's entry types alongside membership, so the default
  // sort axis (dominant type -> defaultSortAxis) can be resolved per tag
  // without a second pass over the corpus — see dateAxis.ts.
  const typesByTag = new Map<string, string[]>();
  for (const entry of entries) {
    for (const tag of entry.data.tags ?? []) {
      tags.add(tag);
      if (!typesByTag.has(tag)) typesByTag.set(tag, []);
      typesByTag.get(tag)!.push(entry.data.type);
    }
  }
  // 日本語側に存在するタグを取得
  const jaEntries = await getDisplayEntries('ja');
  const jaTags = new Set<string>();
  for (const entry of jaEntries) {
    for (const tag of entry.data.tags ?? []) {
      jaTags.add(tag);
    }
  }
  // Prev/next siblings, ordered alphabetically by tag text -- see
  // src/pages/sources/[source].astro for the rationale.
  const sortedTags = Array.from(tags).sort((a, b) => a.localeCompare(b));
  return Array.from(tags).map((tag) => {
    const { prev: prevTag, next: nextTag } = siblingPrevNext(sortedTags, tag);
    return {
      params: { tag },
      props: { tag, hasJa: jaTags.has(tag), sortAxis: defaultSortAxis(dominantType(typesByTag.get(tag) ?? [])), prevTag, nextTag },
    };
  });
}

const lang = 'en';
const t = useTranslations(lang);
const { tag, hasJa, sortAxis, prevTag, nextTag } = Astro.props;
const entries = await getDisplayEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);
const filtered = entries.filter((e) => (e.data.tags ?? []).includes(tag));
// sortAxis was resolved in getStaticPaths from this tag's dominant type.
const displayEntries = collapseThreads(filtered, threadCounts, threadStarters)
  .slice()
  .sort(byDateAxisDesc(sortAxis, (id) => gitDateMap[id]?.en?.createdAt));

const searchHref = `${localePath('/entries/', lang)}?q=${encodeURIComponent(tag.replace(/-/g, ' '))}`;

const pageDescription = `Entries tagged "${tag}" — Satoshi Nakamoto's posts, emails, and related historical records from Bitcoin's earliest days, surfaced under this topic.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tag} - ${t('site.title')}`,
  "url": absoluteUrl(`/tags/${tag}/`, lang),
  "description": pageDescription,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": tag,
    "numberOfItems": displayEntries.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": displayEntries.slice(0, 25).map((entry: any, index: number) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      const itemUrl = isThread
        ? absoluteUrl(`/entries/threads/${tid}/`, lang)
        : absoluteUrl(`/entries/${entry.id}/`, lang);
      const itemName = isThread
        ? (threadTitles.get(tid!) || entry.data.title)
        : entry.data.title;
      return {
        "@type": "ListItem",
        "position": index + 1,
        "url": itemUrl,
        "name": itemName,
      };
    }),
  },
};
---

<BaseLayout
  title={`${tag} - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateJa={hasJa ? absoluteUrl(`/tags/${tag}/`, 'ja') : undefined}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentCategory="tags"
>
    <PrevNextNav
      top
      prev={prevTag ? { href: localePath(`/tags/${prevTag}/`, lang), label: prevTag } : null}
      next={nextTag ? { href: localePath(`/tags/${nextTag}/`, lang), label: nextTag } : null}
    />
    <h1>{tag}</h1>
    <p class="page-lead">Entries tagged with this topic. Spans across types and sources — explore connections between people, events, and themes.</p>
    <div class="filter-row">
      <input type="text" id="filter-input" class="filter-input" placeholder="Filter..." aria-label="Filter" autocomplete="off" />
    </div>
    <div class="list-header">
      <p class="entry-count"><span id="entry-count-num">{displayEntries.length}</span> entries</p>
      <div class="sort-controls">
        <button class:list={['sort-btn', { active: sortAxis === 'date' }]} data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
        <button class:list={['sort-btn', { active: sortAxis === 'created' }]} data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
        <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
      </div>
    </div>
    <div id="tag-entries-list">
      {displayEntries.map((entry) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            entryType={entry.data.type}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            createdAt={gitDateMap[entry.id]?.en?.createdAt}
            updatedAt={gitDateMap[entry.id]?.en?.updatedAt}
          />
        );
      })}
    </div>
    <script>
      import { initListSort, initListFilter } from '../../scripts/list-sort';
      initListSort('tag-entries-list');
      initListFilter('tag-entries-list', 'filter-input');
    </script>

    <aside class="search-cta">
      <p>
        Looking for entries that don't carry this tag explicitly but
        mention the term?
      </p>
      <a class="search-cta-link" href={searchHref}>
        Search "{tag.replace(/-/g, ' ')}" across the archive (fuzzy) &rarr;
      </a>
      <p class="search-cta-note">
        Search is typo-tolerant and matches partial words; it surfaces
        loosely-related material that the tag list above cannot.
      </p>
    </aside>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .filter-row {
    max-width: 28rem;
    margin-bottom: 0.75rem;
  }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 0;
  }
  .search-cta {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .search-cta p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .search-cta-link {
    display: inline-block;
    margin: 0.5rem 0;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-link);
  }
  .search-cta-link:hover {
    text-decoration: underline;
  }
  .search-cta-note {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }
</style>
