---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const svnData = await import('../data/patoshi/svn-committers.json').then(m => m.default);

// Derive headline figures from the JSON so the subtitle stays in sync if the
// data is regenerated.
const totalRevisions: number = svnData.totalRevisions;
const committerCount: number = svnData.committers.length;
const satoshiCommits: number = svnData.committers.find((c: any) => c.isSatoshi)?.commits ?? 0;
const satoshiPct = Math.round((satoshiCommits / totalRevisions) * 100);

const labels = {
  en: {
    barTitle: 'SVN Commit Distribution by Developer',
    barSub: `${totalRevisions.toLocaleString('en-US')} total revisions across ${committerCount} committers. Satoshi authored ${satoshiPct}% of all commits.`,
    timeTitle: 'Commit Access Timeline',
    timeSub: 'Active period for each developer on the SourceForge SVN repository (2009–2011).',
    commits: 'commits',
    revisions: 'revisions',
    of: 'of',
    tooltipFirst: 'First commit',
    tooltipLast: 'Last commit',
  },
  ja: {
    barTitle: 'SVN コミット数の分布（開発者別）',
    barSub: `${committerCount}人のコミッターによる全${totalRevisions.toLocaleString('ja-JP')}リビジョン。全コミットの${satoshiPct}%をサトシが占める。`,
    timeTitle: 'コミットアクセスのタイムライン',
    timeSub: 'SourceForge SVN リポジトリにおける各開発者の活動期間（2009〜2011年）。',
    commits: 'コミット',
    revisions: 'リビジョン',
    of: '/',
    tooltipFirst: '最初のコミット',
    tooltipLast: '最後のコミット',
  },
};

const l = labels[lang];
---

<div class="svn-committers">
  <section class="analysis-section">
    <h3>{l.barTitle}</h3>
    <p class="analysis-desc">{l.barSub}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="svn-bar-chart" class="chart-container"></div>
  </section>

  <section class="analysis-section">
    <h3>{l.timeTitle}</h3>
    <p class="analysis-desc">{l.timeSub}</p>
    <div id="svn-timeline-chart" class="chart-container"></div>
  </section>

  <script type="application/json" id="svn-committers-data" set:html={JSON.stringify({ ...svnData, labels: l })} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Drawing logic lives in src/scripts/svn-committers.js (shared with the
// in-body embed via ChartEmbedRuntime). This script only wires the
// server-rendered JSON data block and DOM elements into that shared mount().
import { mount } from '../scripts/svn-committers.js';

(function() {
  var dataEl = document.getElementById('svn-committers-data') as HTMLElement | null;
  if (!dataEl) return;
  var data = JSON.parse(dataEl.textContent as string);
  var barEl = document.getElementById('svn-bar-chart') as HTMLElement;
  var timelineEl = document.getElementById('svn-timeline-chart') as HTMLElement;
  var replayBtn = document.querySelector('.svn-committers [data-replay]') as HTMLElement | null;
  mount(barEl, timelineEl, replayBtn, data.committers, data.labels, data.totalRevisions);
})();
</script>

<style>
  .svn-committers {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section {
    margin-bottom: 2rem;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
  }
</style>
