---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const labels = {
  en: {
    title: 'Incident Timeline',
    subtitle: 'From discovery to resolution — the most serious crisis in Bitcoin\'s early history, resolved in under 19 hours.',
    hours: 'h',
    events: [
      { time: '18:08', offset: 0, label: 'Jeff Garzik discovers anomaly in Block 74638', type: 'alert' },
      { time: '~18:30', offset: 0.4, label: '184,467,440,737 BTC confirmed — 9,000× total supply', type: 'crisis' },
      { time: '~23:00', offset: 4.9, label: 'Satoshi publishes Bitcoin v0.3.10 with fix', type: 'fix' },
      { time: '~09:00+1', offset: 14.9, label: 'Corrected chain overtakes invalid chain at Block 74691', type: 'resolved' },
    ],
    blockReorg: '53 blocks reorganized',
    duration: '~19 hours total',
  },
  ja: {
    title: 'インシデントのタイムライン',
    subtitle: '発見から解決まで — ビットコイン初期史上最も深刻な危機が 19時間以内に解決された。',
    hours: '時間',
    events: [
      { time: '18:08', offset: 0, label: 'ジェフ・ガージックがブロック 74638 の異常を発見', type: 'alert' },
      { time: '~18:30', offset: 0.4, label: '184,467,440,737 BTC 確認 — 総供給量の 9,000倍', type: 'crisis' },
      { time: '~23:00', offset: 4.9, label: 'サトシが Bitcoin v0.3.10（修正版）を公開', type: 'fix' },
      { time: '~09:00+1', offset: 14.9, label: '修正チェーンがブロック 74691 で不正チェーンを追い越す', type: 'resolved' },
    ],
    blockReorg: '53 ブロックが再編成',
    duration: '合計約 19時間',
  },
};

const l = labels[lang];
---

<div class="value-overflow-timeline">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="overflow-timeline" class="chart-container"></div>
  </section>

  <script type="application/json" id="overflow-timeline-data" set:html={JSON.stringify(l)} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Real ES-module script (no is:inline) so Vite bundles it and tree-shakes
// d3 down to the three submodules actually used here, instead of shipping
// the ~92KB full d3 CDN bundle for a handful of calls.
import { select } from 'd3-selection';
import { scaleLinear } from 'd3-scale';
import { axisBottom } from 'd3-axis';

// The astro frontmatter above serializes `labels[lang]` into the
// #overflow-timeline-data JSON script tag; this interface describes
// that same shape so JSON.parse's result is properly typed below.
interface TimelineEvent {
  time: string;
  offset: number;
  label: string;
  type: 'alert' | 'crisis' | 'fix' | 'resolved';
}

interface TimelineData {
  title: string;
  subtitle: string;
  hours: string;
  events: TimelineEvent[];
  blockReorg: string;
  duration: string;
}

(function() {
  function init() {
    // Asserted non-null at declaration (not just after the runtime
    // guard right below): draw() is defined further down in this same
    // scope and reads `container`, but a plain `if (!x) return` doesn't
    // narrow the type inside a function declared later in the same
    // scope — the type itself has to already say "non-null" for
    // draw()'s body to type-check. The runtime check stays as the
    // actual safety net.
    var dataEl = document.getElementById('overflow-timeline-data') as HTMLElement;
    var container = document.getElementById('overflow-timeline') as HTMLElement;
    if (!dataEl || !container) return;

    var l = JSON.parse(dataEl.textContent as string) as TimelineData;
    var events = l.events;

    function token(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function readTokens() {
      // Incident encoding: warning -> negative -> blue (fix) -> positive (resolved).
      // The two timeline-band tints (faded red for crisis window, faded
      // blue for fix-to-resolved window) use accent-bg-style overlays
      // with semantic hue alignment to the marker color.
      return {
        alert: token('--chart-warning'),
        crisis: token('--chart-negative'),
        fix: token('--chart-color-2'),
        resolved: token('--chart-positive'),
        track: token('--color-divider'),
        muted: token('--color-text-muted'),
        text: token('--color-text'),
        bg: token('--color-bg'),
      };
    }

    function draw() {
      container.innerHTML = '';
      var T = readTokens();
      var typeColors: Record<TimelineEvent['type'], string> = { alert: T.alert, crisis: T.crisis, fix: T.fix, resolved: T.resolved };
      var rect = container.getBoundingClientRect();
      var W = rect.width || 600;
      var margin = { top: 50, right: 80, bottom: 40, left: 80 };
      var H = 260;
      var w = W - margin.left - margin.right;
      var h = H - margin.top - margin.bottom;

      var svg = select(container).append('svg').attr('width', W).attr('height', H);
      var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      var maxOffset = 19;
      var x = scaleLinear().domain([0, maxOffset]).range([0, w]);

      // Axis
      g.append('g').attr('transform', 'translate(0,' + (h - 10) + ')')
        .call(axisBottom(x).ticks(6).tickFormat(function(d) { return '+' + d + l.hours; }))
        .selectAll('text').attr('font-size', '10px').style('fill', T.text);

      // Timeline bar
      g.append('rect')
        .attr('x', 0).attr('y', h / 2 - 3)
        .attr('width', w).attr('height', 6)
        .attr('fill', T.track).attr('rx', 3);

      // Crisis period — same hue as the crisis marker, faded.
      g.append('rect')
        .attr('x', x(0)).attr('y', h / 2 - 3)
        .attr('width', x(4.9) - x(0)).attr('height', 6)
        .attr('fill', T.crisis).attr('opacity', 0.25).attr('rx', 3);

      // Fix → resolved period — same hue as the fix marker, faded.
      g.append('rect')
        .attr('x', x(4.9)).attr('y', h / 2 - 3)
        .attr('width', x(14.9) - x(4.9)).attr('height', 6)
        .attr('fill', T.fix).attr('opacity', 0.25).attr('rx', 3);

      // Events
      events.forEach(function(ev, i) {
        var cx = x(ev.offset);
        var color = typeColors[ev.type];
        var above = i % 2 === 0;
        var yText = above ? h / 2 - 28 : h / 2 + 35;
        var yLine = above ? h / 2 - 12 : h / 2 + 12;

        g.append('circle')
          .attr('cx', cx).attr('cy', h / 2)
          .attr('r', 7).attr('fill', color).attr('stroke', T.bg).attr('stroke-width', 2);

        g.append('line')
          .attr('x1', cx).attr('x2', cx)
          .attr('y1', h / 2 + (above ? -8 : 8)).attr('y2', yLine)
          .attr('stroke', color).attr('stroke-width', 1).attr('stroke-dasharray', '2,2');

        g.append('text')
          .attr('x', cx).attr('y', yText)
          .attr('text-anchor', 'middle').attr('font-size', '10px')
          .attr('fill', color).attr('font-weight', '600')
          .text(ev.time);

        g.append('text')
          .attr('x', cx).attr('y', yText + 13)
          .attr('text-anchor', 'middle').attr('font-size', '9px')
          .attr('fill', T.muted)
          .each(function() {
            var text = select(this);
            var words = ev.label.split(' ');
            var maxChars = 25;
            var line1 = '';
            var line2 = '';
            words.forEach(function(word) {
              if ((line1 + ' ' + word).trim().length <= maxChars && !line2) {
                line1 = (line1 + ' ' + word).trim();
              } else {
                line2 = (line2 + ' ' + word).trim();
              }
            });
            text.text('');
            text.append('tspan').attr('x', cx).attr('dy', 0).text(line1);
            if (line2) text.append('tspan').attr('x', cx).attr('dy', '1.1em').text(line2);
          });
      });
    }
    draw();

    // Reveal: time-cursor wipe on scroll-in (chart-anim.js wipeReveal).
    var replayFn: (() => void) | null = null;
    (function arm(n?: number) {
      if (window.BAChartAnim) {
        replayFn = window.BAChartAnim.wipeReveal(['overflow-timeline'], { duration: 4600 });
      } else if ((n || 0) < 40) { setTimeout(function() { arm((n || 0) + 1); }, 50); }
    })();
    var rb = document.querySelector('.value-overflow-timeline [data-replay]');
    if (rb) rb.addEventListener('click', function() { if (replayFn) replayFn(); });

    var timer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', function() { clearTimeout(timer); timer = setTimeout(draw, 250); });

    if (typeof window.matchMedia === 'function') {
      var mql = window.matchMedia('(prefers-color-scheme: dark)');
      if (mql.addEventListener) mql.addEventListener('change', draw);
      else if (mql.addListener) mql.addListener(draw);
    }
    if (typeof MutationObserver === 'function') {
      new MutationObserver(draw).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-mode', 'data-theme'],
      });
    }
  }
  init();
})();
</script>

<style>
  .value-overflow-timeline {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
    padding: 0.5rem 0;
  }
  .chart-container :global(svg) {
    display: block;
  }
</style>
