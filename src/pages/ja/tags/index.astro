---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getDisplayEntries, localePath, translateTag, absoluteUrl } from '../../../i18n/utils';

const lang = 'ja';
const t = useTranslations(lang);
const entries = await getDisplayEntries('en');

const tagCounts = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.tags')} - ${t('site.title')}`,
  "url": absoluteUrl('/tags/', lang),
  "description": t('tags.description'),
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.tags'),
    "numberOfItems": tags.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": tags.slice(0, 50).map(([tag], index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": absoluteUrl(`/tags/${tag}/`, lang),
      "name": translateTag(tag, lang),
    })),
  },
};
---

<BaseLayout
  title={`${t('nav.tags')} - ${t('site.title')}`}
  description={t('tags.description')}
  lang={lang}
  alternateEn={absoluteUrl('/tags/', 'en')}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentCategory="tags"
>
    <h1>{t('nav.tags')}</h1>
    <div class="list-header">
      <input type="text" id="filter-input" class="filter-input" placeholder="フィルター..." autocomplete="off" />
      <div class="sort-controls">
        <button class="sort-btn active" data-sort="count" data-order="desc">{t('sort.count' as any)} ↓</button>
        <button class="sort-btn" data-sort="name" data-order="asc">{t('sort.name' as any)} ↑</button>
      </div>
    </div>
    <ul class="tag-list" id="sort-list">
      {tags.map(([tag, count]) => (
        <li data-name={`${translateTag(tag, lang)} ${tag}`} data-count={count}>
          <a href={localePath(`/tags/${tag}/`, lang)}>
            {translateTag(tag, lang)}
          </a>
          <span class="count">({count})</span>
        </li>
      ))}
    </ul>
</BaseLayout>

<script>
  import { initCategoryList } from '../../../scripts/list-sort';
  initCategoryList('sort-list', 'tags-sort');
</script>

<style>
  .tag-list { list-style: none; padding: 0; }
  .tag-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.1rem;
  }
  .count { color: var(--color-text-muted); font-size: 0.9rem; }
</style>
