---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import EntryDates from '../../../components/EntryDates.astro';
import { render } from 'astro:content';
import { useTranslations, getEntries, getBiographyForParticipant, localePath, translateParticipantName, absoluteUrl } from '../../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../../data/threads';
import Avatar from '../../../components/Avatar.astro';
import gitDates from '../../../data/git-dates.json';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

export async function getStaticPaths() {
  const { getEntries, getDisplayEntries } = await import('../../../i18n/utils');
  const entries = await getEntries('ja');
  const displayEntries = await getDisplayEntries('en');
  const slugs = new Set<string>();
  const nameMap = new Map<string, string>();
  for (const entry of entries) {
    for (const p of entry.data.participants) {
      slugs.add(p.slug);
      nameMap.set(p.slug, p.name);
    }
  }
  const countMap = new Map<string, number>();
  for (const entry of displayEntries) {
    for (const p of entry.data.participants) {
      countMap.set(p.slug, (countMap.get(p.slug) || 0) + 1);
    }
  }
  // 英語側に存在する参加者 slug を取得
  const enEntries = await getEntries('en');
  const enSlugs = new Set<string>();
  for (const entry of enEntries) {
    for (const p of entry.data.participants) {
      enSlugs.add(p.slug);
    }
  }

  const sorted = Array.from(slugs).sort((a, b) => (countMap.get(b) || 0) - (countMap.get(a) || 0));
  return sorted.map((slug, i) => ({
    params: { participant: slug },
    props: {
      participantSlug: slug,
      participantName: translateParticipantName(nameMap.get(slug)!, slug, 'ja'),
      prevParticipant: i > 0 ? { slug: sorted[i - 1], name: translateParticipantName(nameMap.get(sorted[i - 1])!, sorted[i - 1], 'ja') } : null,
      nextParticipant: i < sorted.length - 1 ? { slug: sorted[i + 1], name: translateParticipantName(nameMap.get(sorted[i + 1])!, sorted[i + 1], 'ja') } : null,
      hasEn: enSlugs.has(slug),
    },
  }));
}

const lang = 'ja';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const { participantSlug, participantName, prevParticipant, nextParticipant, hasEn } = Astro.props;
const entries = await getEntries(lang);
const filtered = entries.filter((e) =>
  e.data.participants.some((p) => p.slug === participantSlug)
);

const allEntries = await getEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(allEntries, lang);
const biographyEntry = await getBiographyForParticipant(lang, participantSlug);
const biographyContent = biographyEntry ? await render(biographyEntry) : null;
const biographyGitDate = biographyEntry ? gitDateMap[biographyEntry.id]?.ja : undefined;
// Recommended-analysis callout. The biography frontmatter declares
// `callout: { entry, label }` if a single analysis page should be
// surfaced near the top of the participant page. No callout when
// the field is unset.
const calloutSpec = biographyEntry?.data.callout;
const calloutTarget = calloutSpec
  ? allEntries.find((e) => e.id === calloutSpec.entry)
  : undefined;
const nonBio = filtered.filter((e) => e.data.type !== 'biography');
// Default order is "recently added" (created desc), same axis as /entries.
// See NovelBitCoin src/archive/todo/20260701_日付メタデータとソートUI_体系再設計.md.
const createdKey = (id: string, fallback: Date): string => gitDateMap[id]?.ja?.createdAt ?? fallback.toISOString();
const displayEntries = collapseThreads(nonBio, threadCounts, threadStarters)
  .slice()
  .sort((a, b) => createdKey(b.id, b.data.date).localeCompare(createdKey(a.id, a.data.date)));
const lifeDatesMatch = biographyEntry?.data.title.match(/[（(]([^)）]+)[)）]/);
const lifeDatesRaw = lifeDatesMatch ? lifeDatesMatch[0] : null;
const lifeDates = lifeDatesRaw && !/生没年不明|dates unknown/.test(lifeDatesRaw) ? lifeDatesRaw : null;
const bioSubtitle = biographyEntry?.data.title.match(/—\s*(.+)/)?.[1] ?? null;
const biographyDescription = biographyEntry?.data.description?.replace(/^[^：:]+[：:]\s*/, '') ?? '';
const canonicalUrl = absoluteUrl(`/participants/${participantSlug}/`, lang);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": `${participantName} - ${t('site.title')}`,
    "url": canonicalUrl,
    "inLanguage": lang,
    "mainEntity": {
      "@id": `${canonicalUrl}#person`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${canonicalUrl}#person`,
    "name": participantName,
    ...(biographyDescription ? { "description": biographyDescription } : {}),
    "url": canonicalUrl,
    "subjectOf": {
      "@type": "ItemList",
      "name": `${participantName}に関するエントリー`,
      "numberOfItems": displayEntries.length,
    },
  },
];

// og:image — prefer the biography's hero illustration when one exists
// (embedded as the body's first image, see STYLE_GUIDE.md "Hero
// Images"); the generated /og/ja/participants/ text card stays the
// fallback for the ~337 participants without a biography. Captured
// without the MIRROR_BASE prefix — BaseHead prepends PRIMARY_ORIGIN.
const heroOgMatch = (biographyEntry?.body ?? '').match(
  /!\[[^\]]*\]\((?:\/BitcoinArchive)?(\/images\/analysis\/[^)\s]+-hero\.png)\)/,
);
const heroOgImage = heroOgMatch ? heroOgMatch[1] : null;
---

<BaseLayout
  title={`${participantName}${bioSubtitle ? ` — ${bioSubtitle}` : ''} - ${t('site.title')}`}
  description={biographyEntry?.data.description ?? `${participantName}のビットコイン初期における投稿・メール・技術的議論のアーカイブ`}
  lang={lang}
  alternateEn={hasEn ? absoluteUrl(`/participants/${participantSlug}/`, 'en') : undefined}
  ogImage={heroOgImage ?? `/og/ja/participants/${participantSlug}.png`}
  ogImageWidth={heroOgImage ? 1600 : undefined}
  ogImageHeight={heroOgImage ? 900 : undefined}
  structuredData={structuredData}
>
  <div class="container">
    <nav class="participant-nav participant-nav-top">
      {prevParticipant ? (
        <a href={localePath(`/participants/${prevParticipant.slug}/`, lang)} class="nav-prev">&larr; {prevParticipant.name}</a>
      ) : <span />}
      {nextParticipant ? (
        <a href={localePath(`/participants/${nextParticipant.slug}/`, lang)} class="nav-next">{nextParticipant.name} &rarr;</a>
      ) : <span />}
    </nav>
    <div class="participant-head">
      <Avatar slug={participantSlug} sizeClass="participant-avatar" base={base} />
      <div class="participant-head-text">
        <h1>{participantName}{lifeDates && <span class="life-dates"> {lifeDates}</span>}</h1>
        {bioSubtitle && <p class="bio-subtitle">{bioSubtitle}</p>}
        {biographyEntry && (
          <EntryDates
            date={biographyEntry.data.date}
            createdAt={biographyGitDate?.createdAt}
            updatedAt={biographyGitDate?.updatedAt}
            lang={lang}
            variant="biography"
          />
        )}
      </div>
    </div>

    {calloutTarget && calloutSpec && (
      <a class="hypothesis-callout" href={localePath(`/entries/${calloutTarget.id}/`, lang)}>
        <span class="hypothesis-icon">🔍</span>
        <span class="hypothesis-label">{calloutSpec.label}</span>
        <span class="hypothesis-arrow">&rarr;</span>
      </a>
    )}

    {biographyContent && (
      <section class="biography-section">
        <div class="biography-content">
          <biographyContent.Content />
        </div>
      </section>
    )}

    {biographyContent ? (
      <div class="entries-header">
        <h2 class="entries-heading">{t('participant.relatedEntries' as any)}</h2>
        {displayEntries.length > 0 && (
          <div class="sort-controls">
            <button class="sort-btn" data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
            <button class="sort-btn active" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
            <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
          </div>
        )}
      </div>
    ) : null}
    <div class="list-header">
      <p class="entry-count">{displayEntries.length} エントリー</p>
      {!biographyContent && displayEntries.length > 0 && (
        <div class="sort-controls">
          <button class="sort-btn" data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
          <button class="sort-btn active" data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
          <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
        </div>
      )}
    </div>
    <div id="participant-entries-list">
      {displayEntries.map((entry) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            entryType={entry.data.type}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            createdAt={gitDateMap[entry.id]?.ja?.createdAt}
            updatedAt={gitDateMap[entry.id]?.ja?.updatedAt}
          />
        );
      })}
    </div>
    <script>
      import { initListSort } from '../../../scripts/list-sort';
      initListSort('participant-entries-list');
    </script>

    <nav class="participant-nav">
      {prevParticipant ? (
        <a href={localePath(`/participants/${prevParticipant.slug}/`, lang)} class="nav-prev">&larr; {prevParticipant.name}</a>
      ) : <span />}
      {nextParticipant ? (
        <a href={localePath(`/participants/${nextParticipant.slug}/`, lang)} class="nav-next">{nextParticipant.name} &rarr;</a>
      ) : <span />}
    </nav>
  </div>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .life-dates {
    font-weight: normal;
    font-size: 0.6em;
    color: var(--color-text-muted);
  }
  .bio-subtitle {
    /* No bottom margin here — it lives on .participant-head so it does
       not shift the avatar's vertical centre (see .participant-head). */
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    font-weight: normal;
  }
  .hypothesis-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 3px 3px 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-link);
  }
  .hypothesis-callout:hover {
    text-decoration: underline;
  }
  .hypothesis-callout .hypothesis-arrow {
    color: var(--color-text-muted);
  }
  .biography-section {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
  }
  .biography-content {
    line-height: 1.8;
  }
  .biography-content :global(p:first-child) {
    margin-top: 0;
  }
  /* Same shape as .section-header on the home page: a heading with a
     trailing action (sort buttons here, "view all" there) shares one
     row, and the border sits on that row so the line reaches under
     the action too — not on the heading alone. .biography-section's
     own bottom spacing already separates this row from the prose
     above, so no extra margin-top is needed here. */
  .entries-header {
    display: flex;
    justify-content: space-between;
    /* center, not baseline: the sort buttons are a padded 40px-tall box,
       not text — baseline-aligning them against the h2's text baseline
       left the buttons sitting visibly lower than the heading. */
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: var(--heading-underline-gap);
    border-bottom: 1px solid var(--color-border-strong);
  }
  /* Optical correction on top of align-items:center: the heading
     glyphs sit higher within their own line box than a button's
     padded box sits within its box, so mathematically-centered still
     reads as the buttons being slightly low. Nudge up a few px. */
  .entries-header .sort-controls {
    transform: translateY(-2px);
  }
  .entries-heading {
    margin: 0;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
  }
  .participant-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 0;
    font-family: var(--font-heading);
    font-size: 0.9rem;
  }
  .participant-nav-top {
    margin-top: 1.5rem;
    padding-top: 0;
    border-top: none;
    margin-bottom: 0.5rem;
  }
  .nav-next {
    margin-left: auto;
  }
  .participant-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    /* Vertical breathing room around the whole name+subtitle block:
       above it (gap from the prev/next nav) and below it (gap from the
       body that follows). The avatar is centred against the name +
       subtitle block; keeping the bottom gap here (rather than on
       .bio-subtitle) avoids shifting that vertical centre. */
    margin-top: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .participant-head-text {
    min-width: 0;
  }
  .participant-head-text h1 {
    margin: 0;
  }
</style>
