---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Generate illustrative scatter data based on paper's description
// Patoshi pattern: consistent slope segments that restart every ~100 hours (~14000 blocks)
// Non-Patoshi: different linear progression
const patoshiPoints: Array<{ x: number; y: number }> = [];
const nonPatoshiPoints: Array<{ x: number; y: number }> = [];

// Patoshi segments (restart every ~14000 blocks)
const segments = [
  { startBlock: 0, endBlock: 14000, slope: 0.00012, intercept: 1 },
  { startBlock: 14500, endBlock: 28500, slope: 0.00013, intercept: 1 },
  { startBlock: 29000, endBlock: 36288, slope: 0.00015, intercept: 1 },
];

for (const seg of segments) {
  const step = Math.max(1, Math.floor((seg.endBlock - seg.startBlock) / 80));
  for (let b = seg.startBlock; b <= seg.endBlock; b += step) {
    const rel = b - seg.startBlock;
    const y = seg.intercept + seg.slope * rel + (Math.random() - 0.5) * 0.08;
    patoshiPoints.push({ x: b, y: Math.max(0, y) });
  }
}

// Non-Patoshi: sparser, different slope starting from block ~12
const nonPatoshiSegs = [
  { startBlock: 12, endBlock: 36288, slope: 0.00004, intercept: 0.3 },
];
for (const seg of nonPatoshiSegs) {
  const step = Math.max(1, Math.floor((seg.endBlock - seg.startBlock) / 120));
  for (let b = seg.startBlock; b <= seg.endBlock; b += step) {
    const rel = b - seg.startBlock;
    const y = seg.intercept + seg.slope * rel + (Math.random() - 0.5) * 0.15;
    nonPatoshiPoints.push({ x: b, y: Math.max(0, y) });
  }
}

const labels = {
  en: {
    title: 'ExtraNonce Pattern Across First Year of Mining',
    subtitle: 'Illustrative reconstruction of Lerner\'s ExtraNonce analysis across blocks 0–36,288. Patoshi blocks form consistent slope segments that restart every ~100 hours — a "slow realtime clock" fingerprint. Non-Patoshi blocks show a different linear progression.',
    xLabel: 'Block number',
    yLabel: 'ExtraNonce (normalized)',
    patoshi: 'Patoshi blocks (~22,000 blocks)',
    nonPatoshi: 'Non-Patoshi blocks',
    note: 'Illustrative reconstruction — based on paper findings, not raw blockchain data',
  },
  ja: {
    title: 'マイニング初年度の ExtraNonce パターン',
    subtitle: 'Lerner の ExtraNonce 解析（ブロック 0〜36,288）の概念的再現。Patoshi ブロックは一貫した傾き区間を形成し、約 100時間ごとに再開する — 「低速リアルタイムクロック」の指紋。非 Patoshi ブロックは別の線形進行を示す。',
    xLabel: 'ブロック番号',
    yLabel: 'ExtraNonce（正規化）',
    patoshi: 'Patoshi ブロック（約 22,000 ブロック）',
    nonPatoshi: '非 Patoshi ブロック',
    note: '概念図 — 論文の知見に基づく再現であり、生のブロックチェーンデータではない',
  },
};

const l = labels[lang];
---

<div class="patoshi-extranonce">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="extranonce-chart" class="chart-container"></div>
    <div class="legend">
      <span class="legend-item"><span class="legend-swatch swatch-patoshi"></span>{l.patoshi}</span>
      <span class="legend-item"><span class="legend-swatch swatch-non-patoshi"></span>{l.nonPatoshi}</span>
    </div>
    <p class="chart-note">{l.note}</p>
  </section>

  <script type="application/json" id="extranonce-data" set:html={JSON.stringify({ patoshiPoints, nonPatoshiPoints, labels: l })} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Real ES-module script (no define:vars, no is:inline) so Vite bundles it
// and tree-shakes d3 down to the submodules actually used here, instead of
// shipping the ~92KB full d3 CDN bundle for a handful of calls.
import { select } from 'd3-selection';
import { max } from 'd3-array';
import { scaleLinear } from 'd3-scale';
import { axisBottom, axisLeft } from 'd3-axis';

// Shape of the JSON blob written by the server-side JSON.stringify above
// (patoshiPoints / nonPatoshiPoints / labels for the current lang).
interface ScatterPoint {
  x: number;
  y: number;
}
interface ChartLabels {
  title: string;
  subtitle: string;
  xLabel: string;
  yLabel: string;
  patoshi: string;
  nonPatoshi: string;
  note: string;
}
interface ChartData {
  patoshiPoints: ScatterPoint[];
  nonPatoshiPoints: ScatterPoint[];
  labels: ChartLabels;
}

(function() {
  function init() {
    var dataEl = document.getElementById('extranonce-data');
    if (!dataEl) return;
    var data = JSON.parse(dataEl.textContent as string) as ChartData;
    var l = data.labels;
    var patoshi = data.patoshiPoints;
    var nonPatoshi = data.nonPatoshiPoints;

    // Asserted non-null: the runtime check right below returns early if the
    // lookup failed, but that guard doesn't narrow the type inside the
    // nested draw() function declared further down, so the type itself has
    // to already say "non-null" for those call sites to type-check.
    var container = document.getElementById('extranonce-chart') as HTMLElement;
    if (!container) return;

    function token(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function readTokens() {
      // Same encoding as PatoshiNonceLsb / PlosPatoshiAnomaly:
      //   patoshi = --color-accent (the focus signal)
      //   non-patoshi = --chart-color-6 (background noise)
      return {
        patoshi: token('--color-accent'),
        nonPatoshi: token('--chart-color-6'),
        muted: token('--color-text-muted'),
        text: token('--color-text'),
      };
    }

    function draw() {
      container.innerHTML = '';
      var T = readTokens();
      var rect = container.getBoundingClientRect();
      var W = rect.width || 700;
      var margin = { top: 20, right: 30, bottom: 50, left: 60 };
      var H = 360;
      var w = W - margin.left - margin.right;
      var h = H - margin.top - margin.bottom;

      var svg = select(container).append('svg').attr('width', W).attr('height', H);
      var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      var x = scaleLinear().domain([0, 36288]).range([0, w]);
      var maxY = max(patoshi.concat(nonPatoshi), function(d) { return d.y; });
      var y = scaleLinear().domain([0, maxY ?? 1]).nice().range([h, 0]);

      // Axes
      // axisBottom(x)'s domain type is d3's NumberValue (number | { valueOf(): number }),
      // not a plain number, so the tick value needs an explicit numeric conversion
      // before the arithmetic below.
      g.append('g').attr('transform', 'translate(0,' + h + ')')
        .call(axisBottom(x).ticks(6).tickFormat(function(d) { return (Number(d) / 1000) + 'k'; }))
        .selectAll('text').attr('font-size', '10px').style('fill', T.text);
      g.append('text').attr('x', w / 2).attr('y', h + 40)
        .attr('text-anchor', 'middle').attr('font-size', '11px')
        .attr('fill', T.muted).text(l.xLabel);

      g.append('g').call(axisLeft(y).ticks(5))
        .selectAll('text').attr('font-size', '10px').style('fill', T.text);
      g.append('text').attr('transform', 'rotate(-90)')
        .attr('x', -h / 2).attr('y', -45)
        .attr('text-anchor', 'middle').attr('font-size', '11px')
        .attr('fill', T.muted).text(l.yLabel);

      // Non-Patoshi points (draw first, below)
      g.selectAll('.non-patoshi')
        .data(nonPatoshi)
        .enter().append('circle')
        .attr('cx', function(d) { return x(d.x); })
        .attr('cy', function(d) { return y(d.y); })
        .attr('r', 2).attr('fill', T.nonPatoshi).attr('opacity', 0.5);

      // Patoshi points
      g.selectAll('.patoshi')
        .data(patoshi)
        .enter().append('circle')
        .attr('cx', function(d) { return x(d.x); })
        .attr('cy', function(d) { return y(d.y); })
        .attr('r', 2.5).attr('fill', T.patoshi).attr('opacity', 0.75);
    }
    draw();

    // Reveal: block-order wipe on scroll-in (chart-anim.js wipeReveal); block
    // height is monotonic in time, so points surface in mining order.
    var replayFn: (() => void) | null = null;
    (function arm(n?: number) {
      if (window.BAChartAnim) {
        replayFn = window.BAChartAnim.wipeReveal(['extranonce-chart'], { duration: 5000 });
      } else if ((n || 0) < 40) { setTimeout(function() { arm((n || 0) + 1); }, 50); }
    })();
    var rb = document.querySelector('.patoshi-extranonce [data-replay]');
    if (rb) rb.addEventListener('click', function() { if (replayFn) replayFn(); });

    var timer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', function() { clearTimeout(timer); timer = setTimeout(draw, 250); });

    if (typeof window.matchMedia === 'function') {
      var mql = window.matchMedia('(prefers-color-scheme: dark)');
      if (mql.addEventListener) mql.addEventListener('change', draw);
      else if (mql.addListener) mql.addListener(draw);
    }
    if (typeof MutationObserver === 'function') {
      new MutationObserver(draw).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-mode', 'data-theme'],
      });
    }
  }
  init();
})();
</script>

<style>
  .patoshi-extranonce {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .legend-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  /* Swatches mirror the runtime fill encoding (patoshi = accent,
     non-patoshi = neutral) so legend stays in sync on theme swap. */
  .swatch-patoshi { background: var(--color-accent); }
  .swatch-non-patoshi { background: var(--chart-color-6); }
  .chart-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 0.5rem;
  }
</style>
