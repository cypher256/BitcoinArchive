---
import { formatDate, localePath, translateParticipantName, findAuthorParticipant, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import Avatar from './Avatar.astro';
import { resolveDateAxis, resolveDateValues } from '../lib/dateAxis';

interface Participant {
  name: string;
  slug: string;
}

interface Props {
  id: string;
  title: string;
  date: Date;
  author: string;
  source: string;
  description: string;
  isSatoshi: boolean;
  lang: Lang;
  threadId?: string;
  threadCount?: number;
  participants?: Participant[];
  entryType?: string;
  createdAt?: string;
  updatedAt?: string;
  showDateDetails?: boolean;
  tags?: string[];
}

const { id, title, date, author, source, description, isSatoshi, lang, threadId, threadCount, participants = [], entryType, createdAt, updatedAt, showDateDetails = false, tags = [] } = Astro.props;
// Avatar base (trailing slash so resolveAvatar can append `avatars/...`).
// Derived here so the 16 listing callers don't each have to pass it.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const isBiography = entryType === 'biography';
const t = useTranslations(lang);
const dateAxis = resolveDateAxis({ dateIso: date.toISOString(), createdAtIso: createdAt, updatedAtIso: updatedAt });
const cardDate = new Date(dateAxis.iso);
const cardDateLabel = t(`entry.${dateAxis.labelKey}` as any);
const dateValues = resolveDateValues({ dateIso: date.toISOString(), createdAtIso: createdAt, updatedAtIso: updatedAt });
const typeLabel = entryType ? (t(`type.${entryType}` as any) || entryType) : (t(`source.${source}` as any) || source);
const href = threadId
  ? localePath(`/entries/threads/${threadId}/`, lang)
  : localePath(`/entries/${id}/`, lang);
const authorParticipant = findAuthorParticipant(author, participants);
const otherParticipants = authorParticipant
  ? participants.filter((p) => p.slug !== authorParticipant.slug)
  : participants.filter((p) => p.name !== author);
const displayAuthor = translateParticipantName(authorParticipant?.name ?? author, authorParticipant?.slug, lang);

// The `isSatoshi` frontmatter flag means "this entry is about or by
// Satoshi" (used for featured highlighting site-wide). It must not be
// used to color the author name in the card byline, because for
// editorial types (article / analysis / biography / design) the frontmatter
// `author` is the subject (per STYLE_GUIDE.md § Editorial Entries) —
// for Satoshi-subject entries that flag is true while the actual
// editorial writer is Bitcoin Institute. Color the author slot only
// when the specific author string matches Satoshi.
const isSatoshiAuthor =
  authorParticipant?.slug === 'satoshi-nakamoto' ||
  author.toLowerCase() === 'satoshi nakamoto';
// Card avatar mirrors the entry-detail title avatar (entries/[...slug].astro):
// Bitcoin Institute for editorial types (article / analysis / design /
// currency), else the byline participant. Decorative — the name beside it
// carries the link.
const isEditorialType = entryType === 'article' || entryType === 'analysis' || entryType === 'design' || entryType === 'currency';
const cardAvatarSlug = isEditorialType ? 'bitcoin-institute' : authorParticipant?.slug;
// Lowercased haystack for the client-side quick-filter on /entries. Covers
// the title, byline, description, and co-participant display names so a
// reader typing a person or keyword narrows the visible list instantly,
// without an Algolia round-trip. Full-text body search stays on Algolia.
const filterText = [title, displayAuthor, description, ...participants.map((p) => translateParticipantName(p.name, p.slug, lang))]
  .join(' ')
  .toLowerCase();
---

<article
  class:list={["entry-card", { "entry-card-thread": !!threadId }]}
  data-date={date.toISOString()}
  data-created={createdAt ?? ''}
  data-updated={updatedAt ?? ''}
  data-type={entryType ?? ''}
  data-source={source}
  data-satoshi={isSatoshi ? '1' : '0'}
  data-tags={tags.join('|')}
  data-filter={filterText}
>
  <a href={href} class="card-link">
    <div class="card-header">
      {showDateDetails && (
        <span class="card-dates">
          <span class="card-date">
            <span class="card-date-label">{t('entry.event' as any)}</span>
            <time datetime={dateValues.eventIso}>{formatDate(new Date(dateValues.eventIso), lang)}</time>
          </span>
          <span class="card-date">
            <span class="card-date-label">{t('entry.added' as any)}</span>
            <time datetime={dateValues.createdAtIso}>{formatDate(new Date(dateValues.createdAtIso), lang)}</time>
          </span>
          <span class="card-date">
            <span class="card-date-label">{t('entry.updated' as any)}</span>
            <time datetime={dateValues.updatedAtIso}>{formatDate(new Date(dateValues.updatedAtIso), lang)}</time>
          </span>
        </span>
      )}
      {!showDateDetails && <span class="card-date-label">{cardDateLabel}</span>}
      {!showDateDetails && <time datetime={cardDate.toISOString()}>{formatDate(cardDate, lang)}</time>}
      <span class="source-badge">{typeLabel}</span>
      {threadCount && threadCount >= 2 && (
        <span class="thread-badge">{threadCount} {t('entry.messages' as any)}</span>
      )}
      {isBiography && (
        <span class="biography-badge">{t('entry.biography' as any)}</span>
      )}
    </div>
    <div class="card-title-row">
      {cardAvatarSlug && <Avatar slug={cardAvatarSlug} sizeClass="card-author-avatar" base={base} />}
      <h3 class="card-title">{title}</h3>
    </div>
  </a>
  <p class="card-author">
    {authorParticipant ? (
      <a href={localePath(`/participants/${authorParticipant.slug}/`, lang)} class:list={["author-link", { satoshi: isSatoshiAuthor }]}>{displayAuthor}</a>
    ) : (
      <span class:list={[{ satoshi: isSatoshiAuthor }]}>{displayAuthor}</span>
    )}
    {otherParticipants.length > 0 && (
      <span class="participants-with">
        &harr; {otherParticipants.map((p, i) => (
          <><a href={localePath(`/participants/${p.slug}/`, lang)} class="participant-link">{translateParticipantName(p.name, p.slug, lang)}</a>{i < otherParticipants.length - 1 && ', '}</>
        ))}
      </span>
    )}
  </p>
  <a href={href} class="card-link">
    <p class="card-description">{description}</p>
  </a>
</article>

<!--
  No scoped <style> here. The entry-card look is the single source of truth in
  src/styles/global.css (the "Entry card (browse list + full-text search
  results)" section), so the runtime-injected full-text result cards on
  /entries can reuse the exact same rules by emitting the same markup and class
  names. Astro would scope a component <style> to these SSR elements only,
  leaving the JS-injected search cards unstyled — hence the shared global home.
-->
