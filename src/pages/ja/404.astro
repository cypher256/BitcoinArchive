---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildSuggestionsLocaleMeta } from '../../i18n/utils';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Byline/label metadata so the 404 page's "you might be looking for"
// suggestions can reuse EntryCard's own look via hitCard() (see
// entries-browse.ts) instead of a bare link list. Cloudflare Pages resolves
// 404s by walking up the directory tree, so this file (dist/ja/404.html) is
// served for any unmatched path under /ja/ -- we are certain of the locale
// here, unlike the root 404 (see its comment for why that one has to sniff
// the path client-side). Both locales are still built: every archive URL
// slug is English regardless of locale, so a broken /ja/ URL's slug-derived
// query routinely finds nothing in the JA index; init404Suggestions() falls
// back to the EN index in that case rather than showing no suggestions.
const suggestionsConfig = {
  basePath,
  ja: await buildSuggestionsLocaleMeta('ja'),
  en: await buildSuggestionsLocaleMeta('en'),
};
---

<BaseLayout
  title="ページが見つかりません - Bitcoin Institute"
  description="お探しのページが見つかりませんでした。"
  lang="ja"
>
  <div class="container not-found">
    <h1>404</h1>
    <p>お探しのページは存在しません。</p>
    <a href={`${basePath}/ja/`}>トップへ戻る</a>

    <div id="suggestions" class="suggestions" hidden>
      <p class="suggestions-label">こちらのページもご覧ください：</p>
      <div id="suggestions-list"></div>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="suggestions-config" is:inline set:html={JSON.stringify(suggestionsConfig)}></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
<script>
  import { init404Suggestions } from '../../scripts/entries-browse';
  init404Suggestions();
</script>

<style>
  .not-found {
    text-align: center;
    padding: 5rem 0;
  }
  .not-found h1 {
    /* --color-text, not --color-accent: same link-color confusion
       fix as f3a449325 / 8643cca36 / 76d336eef -- this heading is
       not a link. */
    font-size: 5rem;
    color: var(--color-text);
    margin: 0 0 1rem;
  }
  .not-found p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
  .not-found a {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .suggestions {
    max-width: 40rem;
    margin: 3rem auto 0;
    text-align: left;
  }
  .suggestions-label {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
</style>
