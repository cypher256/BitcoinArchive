---
/**
 * RelatedEntries.astro — Renders the "Related entries" section on entry pages.
 *
 * Selection policy (manual-first, no data-side cap):
 *   1. Start from manual frontmatter.relatedEntries (editor-curated,
 *      priority-ordered — see STYLE_GUIDE "Related Entries").
 *   2. Append auto-derived candidates from src/data/derived-related.json
 *      (computed by scripts/generate-derived-related.mjs from inline-link
 *      structure) that are not already in the manual list.
 *
 * Display policy (cap is at the display layer, not the data layer):
 *   - The first MAX_VISIBLE items (after chronological sort) are shown
 *     immediately.
 *   - Any remainder is rendered inside a <details> block ("Show N more")
 *     so the data layer keeps the full graph while the UI stays compact.
 *   - <details> is HTML-standard, requires no JS, and is keyboard /
 *     screen-reader accessible.
 *
 * Display order: analysis-type entries first, then chronological by
 * entry date among each group. Analysis pages typically carry the
 * editorially-strongest reading of the surrounding primary record, so
 * surfacing them above source posts in the related list keeps them out
 * of the chronological middle where they would otherwise be buried.
 * Selection priority controls *what gets in*; the analysis-first sort
 * controls *what gets read first*. Rules for the manual list are
 * documented in STYLE_GUIDE.md and the bidirectional / EN-JA-mirror
 * constraints are enforced by scripts/check-internal-links.mjs.
 */
import { getCollection } from 'astro:content';
import { useTranslations, localePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import EntryDates from './EntryDates.astro';
import derivedData from '../data/derived-related.json';
import commentariesData from '../data/derived-commentaries.json';
import gitDates from '../data/git-dates.json';

const MAX_VISIBLE = 6;
// Hero thumbnail: same body-markdown extraction used on the home page
// cards (see src/pages/index.astro) and the entry detail page's own
// og:image logic. Only 3 editorial entries in the whole archive lack a
// hero image (audited 2026-08-13); for those, fall back to the same
// generated /og/{id}.png card already used as the entry page's own
// og:image fallback -- never a blank thumbnail.
const HERO_IMAGE_RE = /!\[[^\]]*\]\((?:\/BitcoinArchive)?(\/images\/analysis\/[^)\s]+-hero\.png)\)/;
const imgBase = import.meta.env.BASE_URL.replace(/\/$/, '');
function heroThumb(body: string | undefined, ogPath: string): string {
  const match = (body ?? '').match(HERO_IMAGE_RE);
  return match ? imgBase + match[1] : `${imgBase}/og/${ogPath}.png`;
}
const derivedMap = derivedData as Record<string, { id: string; score: number }[]>;
const commentariesMap = commentariesData as Record<string, { id: string }[]>;
type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;

interface Props {
  lang: Lang;
  entryId: string;
  relatedIds: string[];
}

const { lang, entryId, relatedIds } = Astro.props;
const t = useTranslations(lang);

// Build the selection set in priority order: manual first (priority-ordered
// per STYLE_GUIDE), then derived candidates (already score-sorted, with
// deterministic tiebreakers). No data-side cap — the cap is at the display
// layer below, where the priority-top MAX_VISIBLE items are always shown
// and the remainder is rendered inside a <details> ("Show N more") block.
//
// Exclude any entry already shown by CommentaryLinks (at the top of
// the page). The commentary section uses a stronger "this article is
// the editorial reading of this message" framing and is intentionally
// surfaced above the body; duplicating those same article ids in the
// generic "Related entries" block at the bottom adds noise.
const commentaryIds = new Set((commentariesMap[entryId] ?? []).map((c) => c.id));
const seen = new Set([...relatedIds, ...commentaryIds]);
const derivedIds = (derivedMap[entryId] ?? [])
  .map((d) => d.id)
  .filter((id) => !seen.has(id));
const filteredRelatedIds = relatedIds.filter((id) => !commentaryIds.has(id));
const mergedIds = [...filteredRelatedIds, ...derivedIds];

interface Target {
  id: string;
  title: string;
  date: Date;
  createdAt?: string;
  updatedAt?: string;
  href: string;
  type: string;
  thumb: string;
}

let visibleTargets: Target[] = [];
let hiddenTargets: Target[] = [];

if (mergedIds.length > 0) {
  const collectionName = lang === 'ja' ? 'entries_ja' : 'entries';
  const all = await getCollection(collectionName as 'entries');
  const byId = new Map(all.map((e) => [e.id, e]));

  // Biography entries are not routed at /entries/{id}/ — they live at
  // /participants/{slug}/. Use the primary participant slug from the
  // biography frontmatter.
  const buildTarget = (id: string): Target | null => {
    const entry = byId.get(id);
    if (!entry) return null;

    // OG-fallback path mirrors src/pages/og/[...slug].png.ts's own
    // getStaticPaths param shape: JA entries are generated under a
    // `ja/` prefix, and biographies have no /og/{id}.png of their own
    // (excluded from that route) -- their OG image lives at
    // /og/participants/{slug}.png instead.
    let href: string;
    let ogPath: string;
    if (entry.data.type === 'biography') {
      const primarySlug = entry.data.participants?.[0]?.slug;
      if (!primarySlug) return null;
      href = localePath(`/participants/${primarySlug}/`, lang);
      ogPath = lang === 'ja' ? `ja/participants/${primarySlug}` : `participants/${primarySlug}`;
    } else {
      href = localePath(`/entries/${entry.id}/`, lang);
      ogPath = lang === 'ja' ? `ja/${entry.id}` : entry.id;
    }

    return {
      id: entry.id,
      title: entry.data.title,
      date: entry.data.date,
      createdAt: gitDateMap[entry.id]?.[lang]?.createdAt ?? gitDateMap[entry.id]?.en?.createdAt,
      updatedAt: gitDateMap[entry.id]?.[lang]?.updatedAt ?? gitDateMap[entry.id]?.en?.updatedAt,
      href,
      type: entry.data.type,
      thumb: heroThumb(entry.body, ogPath),
    };
  };

  // Two-stage sort: analysis entries float to the top (editorial weight),
  // then chronological within each group (analysis-first, then
  // non-analysis-first). Two analysis entries on the same bio sort
  // chronologically among themselves; the analysis-first rule only
  // applies across the analysis/non-analysis boundary.
  const byAnalysisFirstThenDate = (a: Target, b: Target) => {
    const aIsAnalysis = a.type === 'analysis';
    const bIsAnalysis = b.type === 'analysis';
    if (aIsAnalysis !== bIsAnalysis) return aIsAnalysis ? -1 : 1;
    return a.date.getTime() - b.date.getTime();
  };

  // Resolve the entire merged list to targets and sort once across the
  // whole set, then split into visible/hidden. Sorting must precede the
  // slice — otherwise analysis entries that arrived via the derived
  // candidate stream (always appended after the manual list) would
  // never reach the visible top, even when they are the editorially
  // strongest reading available.
  const allTargets = mergedIds
    .map(buildTarget)
    .filter((x): x is Target => x !== null)
    .sort(byAnalysisFirstThenDate);

  visibleTargets = allTargets.slice(0, MAX_VISIBLE);
  hiddenTargets = allTargets.slice(MAX_VISIBLE);
}

const showMoreLabel = t('related.showMore' as any).replace('{n}', String(hiddenTargets.length));
---

{visibleTargets.length > 0 && (
  <section class="related-entries">
    <h2>{t('related.heading' as any)}</h2>
    <ul>
      {visibleTargets.map((entry) => (
        <li>
          <a href={entry.href}>
            <div class="related-thumb"><img src={entry.thumb} alt="" loading="lazy" width="1600" height="900" /></div>
            <div class="related-body">
              <EntryDates date={entry.date} createdAt={entry.createdAt} updatedAt={entry.updatedAt} lang={lang} variant="related" dateFields={['event']} />
              <span class="related-title">{entry.title}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
    {hiddenTargets.length > 0 && (
      <details class="related-more">
        <summary>{showMoreLabel}</summary>
        <ul>
          {hiddenTargets.map((entry) => (
            <li>
              <a href={entry.href}>
                <div class="related-thumb"><img src={entry.thumb} alt="" loading="lazy" width="1600" height="900" /></div>
                <div class="related-body">
                  <EntryDates date={entry.date} createdAt={entry.createdAt} updatedAt={entry.updatedAt} lang={lang} variant="related" dateFields={['event']} />
                  <span class="related-title">{entry.title}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>
)}

<style>
  .related-entries {
    /* --rhythm-block (global.css): shared with .thread-banner and
       .source-citation so end-of-article spacing collapses uniformly
       everywhere, not three independently-authored magic numbers. */
    margin: var(--rhythm-block) 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
  }
  .related-entries h2 {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-family: var(--font-heading);
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  /* Mini card grid -- top-image card, closer to the home page's
     Analyses treatment, scaled down for the end-of-article box. The
     240px floor lands on 3 columns at the .container (1000px) reading
     width (measured 291px/card there) and collapses to 2 then 1 on
     narrower viewports, same auto-fit/minmax pattern as every other
     card grid on the site. */
  .related-entries ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem;
    align-items: start;
  }
  .related-entries li {
    margin: 0;
  }
  .related-entries a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .related-entries a:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .related-entries a:hover .related-title {
    color: var(--color-link);
    text-decoration: underline;
  }
  .related-more {
    margin-top: 0.5rem;
  }
  .related-thumb {
    aspect-ratio: 16 / 9;
    width: 100%;
  }
  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .related-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.6rem 0.7rem 0.75rem;
    /* Matches the natural max .related-body height measured at 3
       columns (103.5px, the 3-line-title case) so all cards in a row
       land at the same height instead of leaving a gap under 2-line
       titles (see .analysis-card .body on the home page for the same
       container-level min-height pattern and why it beats per-element
       min-height). */
    min-height: 6.5rem;
  }
  .related-title {
    font-size: 0.88rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-entries :global(.entry-dates--related) {
    font-size: 0.72rem;
  }
  .related-more > summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    padding: 0.4rem 0;
    user-select: none;
    list-style-position: inside;
  }
  .related-more > summary:hover {
    color: var(--color-link);
  }
  .related-more[open] > summary {
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .related-more ul {
    margin-top: 0.4rem;
  }
</style>
