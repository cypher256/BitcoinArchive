---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryCard from '../../../components/EntryCard.astro';
import PrevNextNav from '../../../components/PrevNextNav.astro';
import { useTranslations, getDisplayEntries, absoluteUrl, localePath } from '../../../i18n/utils';
import { buildThreadInfo, collapseThreads, resolveThreadId } from '../../../data/threads';
import { defaultSortAxis, byDateAxisDesc } from '../../../lib/dateAxis';
import { siblingPrevNext } from '../../../lib/siblingNav';
import gitDates from '../../../data/git-dates.json';

type LangDate = { createdAt: string; updatedAt: string };
type GitDateRecord = { en?: LangDate; ja?: LangDate };
const gitDateMap = gitDates as Record<string, GitDateRecord>;
function gitJa(id: string) {
  return gitDateMap[id]?.ja ?? gitDateMap[id]?.en;
}

export async function getStaticPaths() {
  const { getDisplayEntries } = await import('../../../i18n/utils');
  const entries = await getDisplayEntries('ja');
  const types = [...new Set(entries.map((e) => e.data.type))];
  const enEntries = await getDisplayEntries('en');
  const enTypes = new Set(enEntries.map((e) => e.data.type));
  // Prev/next siblings, ordered alphabetically by JA display label -- see
  // EN mirror src/pages/types/[type].astro for the rationale.
  const t = useTranslations('ja');
  const sortedTypes = [...types].sort((a, b) =>
    (t(`type.${a}` as any) || a).localeCompare(t(`type.${b}` as any) || b, 'ja')
  );
  return types.map((type) => {
    const { prev: prevType, next: nextType } = siblingPrevNext(sortedTypes, type);
    return {
      params: { type },
      props: { type, hasEn: enTypes.has(type), prevType, nextType },
    };
  });
}

const lang = 'ja';
const t = useTranslations(lang);
const { type, hasEn, prevType, nextType } = Astro.props;
const entries = await getDisplayEntries(lang);
const { threadCounts, threadStarters, threadTitles } = buildThreadInfo(entries, lang);
const filtered = entries.filter((e) => e.data.type === type);
// Default axis depends on this type's date semantics — see EN mirror
// src/pages/types/[type].astro and dateAxis.ts.
const sortAxis = defaultSortAxis(type);
const displayEntries = collapseThreads(filtered, threadCounts, threadStarters)
  .slice()
  .sort(byDateAxisDesc(sortAxis, (id) => gitJa(id)?.createdAt));
const typeLabel = t(`type.${type}` as any) || type;

const pageDescription = `${typeLabel}形式のエントリー。サトシ・ナカモトと初期ビットコイン貢献者によるこの形式の通信を、原典とともにアーカイブから集約。`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${typeLabel} - ${t('site.title')}`,
  "url": absoluteUrl(`/types/${type}/`, lang),
  "description": pageDescription,
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": typeLabel,
    "numberOfItems": displayEntries.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": displayEntries.slice(0, 25).map((entry: any, index: number) => {
      const tid = resolveThreadId(entry);
      const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
      const isThread = msgCount >= 2;
      const itemUrl = isThread
        ? absoluteUrl(`/entries/threads/${tid}/`, lang)
        : absoluteUrl(`/entries/${entry.id}/`, lang);
      const itemName = isThread
        ? (threadTitles.get(tid!) || entry.data.title)
        : entry.data.title;
      return {
        "@type": "ListItem",
        "position": index + 1,
        "url": itemUrl,
        "name": itemName,
      };
    }),
  },
};
---

<BaseLayout
  title={`${typeLabel} - ${t('site.title')}`}
  description={pageDescription}
  lang={lang}
  alternateEn={hasEn ? absoluteUrl(`/types/${type}/`, 'en') : undefined}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentType={type}
>
    <PrevNextNav
      top
      prev={prevType && { href: localePath(`/types/${prevType}/`, lang), label: t(`type.${prevType}` as any) || prevType }}
      next={nextType && { href: localePath(`/types/${nextType}/`, lang), label: t(`type.${nextType}` as any) || nextType }}
    />
    <h1>{typeLabel}</h1>
    <p class="page-lead">この形式（タイプ）のエントリー集約。形式軸で時間を追うと、ビットコイン黎明期のコミュニケーション様式の変遷が見えます。</p>
    <div class="filter-row">
      <input type="text" id="filter-input" class="filter-input" placeholder="フィルター..." aria-label="フィルター" autocomplete="off" />
    </div>
    <div class="list-header">
      <p class="entry-count"><span id="entry-count-num">{displayEntries.length}</span> 件</p>
      <div class="sort-controls">
        <button class:list={['sort-btn', { active: sortAxis === 'date' }]} data-sort="date" data-order="desc">{t('sort.postDate')} ↓</button>
        <button class:list={['sort-btn', { active: sortAxis === 'created' }]} data-sort="created" data-order="desc">{t('sort.added')} ↓</button>
        <button class="sort-btn" data-sort="updated" data-order="desc">{t('sort.updated')} ↓</button>
      </div>
    </div>
    <div id="type-entries-list">
      {displayEntries.map((entry) => {
        const tid = resolveThreadId(entry);
        const msgCount = tid ? threadCounts.get(tid) || 0 : 0;
        const isThread = msgCount >= 2;
        return (
          <EntryCard
            id={entry.id}
            title={isThread ? threadTitles.get(tid!) || entry.data.title : entry.data.title}
            date={entry.data.date}
            author={entry.data.author}
            source={entry.data.source}
            description={entry.data.description}
            isSatoshi={entry.data.isSatoshi}
            lang={lang}
            threadId={isThread ? tid : undefined}
            threadCount={isThread ? msgCount : undefined}
            participants={entry.data.participants}
            entryType={entry.data.type}
            createdAt={gitJa(entry.id)?.createdAt}
            updatedAt={gitJa(entry.id)?.updatedAt}
          />
        );
      })}
    </div>
    <script>
      import { initListSort, initListFilter } from '../../../scripts/list-sort';
      initListSort('type-entries-list');
      initListFilter('type-entries-list', 'filter-input');
    </script>
</BaseLayout>

<style>
  h1 { margin-bottom: 0.25rem; }
  .filter-row {
    max-width: 28rem;
    margin-bottom: 0.75rem;
  }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .page-lead {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0 0 0.75rem 0;
  }
  .entry-count {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
