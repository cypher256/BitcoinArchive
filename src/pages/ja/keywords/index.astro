---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, localePath, absoluteUrl } from '../../../i18n/utils';
import { keywordIndex, keywordSlugs } from '../../../lib/keyword-index';

const lang = 'ja';
const t = useTranslations(lang);

const localeData = keywordIndex.ja;
// Only list keywords with at least one backlink -- see
// src/pages/keywords/[keyword].astro's getStaticPaths comment.
const rows = [
  ...Object.keys(localeData.concept ?? {}).map((kw) => ({ kw, kind: 'concept' as const })),
  ...Object.keys(localeData.person ?? {}).map((kw) => ({ kw, kind: 'person' as const })),
]
  .map(({ kw, kind }) => ({ kw, kind, count: localeData.counts?.[kw] ?? 0, slug: keywordSlugs.ja?.[kw] }))
  .filter((row): row is typeof row & { slug: string } => row.count > 0 && !!row.slug)
  .sort((a, b) => b.count - a.count || a.kw.localeCompare(b.kw));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${t('nav.keywords' as any)} - ${t('site.title')}`,
  "url": absoluteUrl('/keywords/', lang),
  "description": t('keywords.description' as any),
  "inLanguage": lang,
  "mainEntity": {
    "@type": "ItemList",
    "name": t('nav.keywords' as any),
    "numberOfItems": rows.length,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "itemListElement": rows.slice(0, 50).map(({ kw, slug }, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": absoluteUrl(`/keywords/${slug}/`, lang),
      "name": kw,
    })),
  },
};
---

<BaseLayout
  title={`${t('nav.keywords' as any)} - ${t('site.title')}`}
  description={t('keywords.description' as any)}
  lang={lang}
  alternateEn={absoluteUrl('/keywords/', 'en')}
  structuredData={structuredData}
  pageWidth="wide"
  sidebarCurrentCategory="keywords"
>
    <h1>{t('nav.keywords' as any)}</h1>
    <p class="page-lead">{t('keywords.description' as any)}</p>
    <div class="list-header">
      <input type="text" id="filter-input" class="filter-input" placeholder="フィルター..." autocomplete="off" />
      <div class="sort-controls">
        <button class="sort-btn active" data-sort="count" data-order="desc">{t('sort.count' as any)} ↓</button>
        <button class="sort-btn" data-sort="name" data-order="asc">{t('sort.name' as any)} ↑</button>
      </div>
    </div>
    <ul class="tag-list" id="sort-list">
      {rows.map(({ kw, kind, count, slug }) => (
        <li data-name={kw} data-count={count}>
          <a href={localePath(`/keywords/${slug}/`, lang)}>
            {kw}
          </a>
          <span class="kind-badge">{kind === 'person' ? '人物' : '概念'}</span>
          <span class="count">({count})</span>
        </li>
      ))}
    </ul>
</BaseLayout>

<script>
  import { initCategoryList } from '../../../scripts/list-sort';
  initCategoryList('sort-list', 'keywords-sort');
</script>

<style>
  .tag-list { list-style: none; padding: 0; }
  .tag-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.1rem;
  }
  .kind-badge {
    margin-left: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.05rem 0.4rem;
  }
  .count { color: var(--color-text-muted); font-size: 0.9rem; margin-left: 0.4rem; }
</style>
