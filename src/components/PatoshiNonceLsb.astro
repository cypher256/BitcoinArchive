---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const nonceLsbData = await import('../data/patoshi/nonce-lsb.json').then(m => m.default);

const labels = {
  en: {
    title: 'Nonce LSB Distribution (Patoshi Blocks)',
    subtitle: 'Frequency of each least significant byte value (0–255) in Patoshi-attributed blocks. The restriction to ~50 values ([0..9] ∪ [19..58]) proves custom mining software with parallel thread nonce partitioning.',
    yLabel: 'Occurrences',
    xLabel: 'Nonce LSB value',
    range0_9: 'Range 0–9: elevated (247–324)',
    range10_18: 'Range 10–18: near-zero gap',
    range19_58: 'Range 19–58: elevated (up to 201)',
    range59_255: 'Range 59–255: sparse',
    tooltipValue: 'LSB value',
    tooltipCount: 'Occurrences',
    expectedLabel: 'Expected if uniform',
  },
  ja: {
    title: 'Nonce LSB 分布（Patoshi ブロック）',
    subtitle: 'Patoshi 帰属ブロックにおける各最下位バイト値（0〜255）の出現頻度。約 50 値（[0..9] ∪ [19..58]）への集中は、並列スレッドによるナンス空間分割を持つカスタムマイニングソフトウェアの使用を証明する。',
    yLabel: '出現回数',
    xLabel: 'Nonce LSB 値',
    range0_9: '範囲 0–9: 高頻度（247–324）',
    range10_18: '範囲 10–18: ほぼゼロ（ギャップ）',
    range19_58: '範囲 19–58: 高頻度（最大 201）',
    range59_255: '範囲 59–255: まばら',
    tooltipValue: 'LSB 値',
    tooltipCount: '出現回数',
    expectedLabel: '均一分布の場合の期待値',
  },
};

const l = labels[lang];
---

<div class="patoshi-nonce-lsb">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="nonce-lsb-chart" class="chart-container"></div>
    <div class="legend">
      <span class="legend-item"><span class="legend-swatch swatch-patoshi"></span>{l.range0_9}</span>
      <span class="legend-item"><span class="legend-swatch swatch-gap"></span>{l.range10_18}</span>
      <span class="legend-item"><span class="legend-swatch swatch-patoshi"></span>{l.range19_58}</span>
      <span class="legend-item"><span class="legend-swatch swatch-sparse"></span>{l.range59_255}</span>
    </div>
  </section>

  <script type="application/json" id="nonce-lsb-data" set:html={JSON.stringify({ distribution: nonceLsbData.distribution, labels: l })} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Drawing logic lives in src/scripts/nonce-lsb.js (shared with the in-body
// embed via ChartEmbedRuntime). This script only wires the server-rendered
// JSON data block and DOM elements into that shared mount().
import { mount } from '../scripts/nonce-lsb.js';

(function() {
  var dataEl = document.getElementById('nonce-lsb-data') as HTMLElement | null;
  var container = document.getElementById('nonce-lsb-chart') as HTMLElement | null;
  if (!dataEl || !container) return;
  var data = JSON.parse(dataEl.textContent as string);
  var replayBtn = document.querySelector('.patoshi-nonce-lsb [data-replay]') as HTMLElement | null;
  mount(container, replayBtn, data.distribution, data.labels);
})();
</script>

<style>
  .patoshi-nonce-lsb {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .legend-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  /* Swatch tokens mirror the runtime barColor() encoding so the
     legend stays in sync with the chart on theme swap. */
  .swatch-patoshi { background: var(--chart-color-2); }
  .swatch-gap { background: var(--chart-negative); }
  .swatch-sparse { background: var(--chart-color-6); }
</style>
