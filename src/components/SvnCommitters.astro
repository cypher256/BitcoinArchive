---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const svnData = await import('../data/patoshi/svn-committers.json').then(m => m.default);

// Derive headline figures from the JSON so the subtitle stays in sync if the
// data is regenerated.
const totalRevisions: number = svnData.totalRevisions;
const committerCount: number = svnData.committers.length;
const satoshiCommits: number = svnData.committers.find((c: any) => c.isSatoshi)?.commits ?? 0;
const satoshiPct = Math.round((satoshiCommits / totalRevisions) * 100);

const labels = {
  en: {
    barTitle: 'SVN Commit Distribution by Developer',
    barSub: `${totalRevisions.toLocaleString('en-US')} total revisions across ${committerCount} committers. Satoshi authored ${satoshiPct}% of all commits.`,
    timeTitle: 'Commit Access Timeline',
    timeSub: 'Active period for each developer on the SourceForge SVN repository (2009–2011).',
    commits: 'commits',
    revisions: 'revisions',
    of: 'of',
    tooltipFirst: 'First commit',
    tooltipLast: 'Last commit',
  },
  ja: {
    barTitle: 'SVN コミット数の分布（開発者別）',
    barSub: `${committerCount}人のコミッターによる全${totalRevisions.toLocaleString('ja-JP')}リビジョン。全コミットの${satoshiPct}%をサトシが占める。`,
    timeTitle: 'コミットアクセスのタイムライン',
    timeSub: 'SourceForge SVN リポジトリにおける各開発者の活動期間（2009〜2011年）。',
    commits: 'コミット',
    revisions: 'リビジョン',
    of: '/',
    tooltipFirst: '最初のコミット',
    tooltipLast: '最後のコミット',
  },
};

const l = labels[lang];
---

<div class="svn-committers">
  <section class="analysis-section">
    <h3>{l.barTitle}</h3>
    <p class="analysis-desc">{l.barSub}</p>
    <div class="ba-replay-controls"><button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button></div>
    <div id="svn-bar-chart" class="chart-container"></div>
  </section>

  <section class="analysis-section">
    <h3>{l.timeTitle}</h3>
    <p class="analysis-desc">{l.timeSub}</p>
    <div id="svn-timeline-chart" class="chart-container"></div>
  </section>

  <script type="application/json" id="svn-committers-data" set:html={JSON.stringify({ ...svnData, labels: l })} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Real ES-module script (no is:inline) so Vite bundles it and tree-shakes
// d3 down to the submodules actually used here, instead of shipping the
// ~92KB full d3 CDN bundle.
import { select, pointer } from 'd3-selection';
import { scaleBand, scaleLinear, scaleTime } from 'd3-scale';
import { max } from 'd3-array';
import { axisBottom, axisLeft } from 'd3-axis';
import { timeFormat, timeParse } from 'd3-time-format';

// Shape of src/data/patoshi/svn-committers.json (plus the server-rendered
// `labels` block appended alongside it — see the JSON script tag above).
interface Committer {
  username: string;
  name: string;
  slug: string;
  commits: number;
  firstCommit: string;
  lastCommit: string;
  firstRev: number;
  lastRev: number;
  isSatoshi: boolean;
}
interface SvnLabels {
  barTitle: string;
  barSub: string;
  timeTitle: string;
  timeSub: string;
  commits: string;
  revisions: string;
  of: string;
  tooltipFirst: string;
  tooltipLast: string;
}
interface SvnData {
  committers: Committer[];
  labels: SvnLabels;
  totalRevisions: number;
}

(function() {
  function init() {
    // Asserted non-null: the runtime check right below returns early if the
    // lookup actually failed, but that guard doesn't narrow the type inside
    // functions declared further down (panelBar(), panelTimeline(), etc.),
    // so the type itself has to already say "non-null" for those call sites
    // to type-check.
    var dataEl = document.getElementById('svn-committers-data') as HTMLElement;
    if (!dataEl) return;
    var data = JSON.parse(dataEl.textContent as string) as SvnData;
    var committers = data.committers;
    var l = data.labels;
    var total = data.totalRevisions;

    function token(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }
    function readTokens() {
      // 4 committers: Satoshi (accent, the focus) + 3 others rotating
      // through chart-color-2/3/4. Maintains a stable hue position
      // across themes.
      return {
        committers: [
          token('--color-accent'),
          token('--chart-color-2'),
          token('--chart-color-3'),
          token('--chart-color-4'),
        ],
        text: token('--color-text'),
        bg: token('--color-bg'),
        tooltipBg: token('--chart-tooltip-bg'),
        tooltipFg: token('--chart-tooltip-fg'),
      };
    }
    function rerender() { panelBar(); panelTimeline(); }

    // --- Bar Chart ---
    function panelBar() {
      var container = document.getElementById('svn-bar-chart') as HTMLElement;
      if (!container) return;
      var T = readTokens();
      var colors = T.committers;
      container.innerHTML = '';
      var rect = container.getBoundingClientRect();
      var W = rect.width || 600;
      var margin = { top: 20, right: 80, bottom: 30, left: 160 };
      var H = 180;
      var w = W - margin.left - margin.right;
      var h = H - margin.top - margin.bottom;

      var svg = select(container).append('svg').attr('width', W).attr('height', H);
      var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      var y = scaleBand().domain(committers.map(function(c) { return c.name; })).range([0, h]).padding(0.35);
      // max() can return undefined for an empty iterable; committers is
      // always non-empty in practice (fixed 4-developer JSON), so 0 here
      // is an unreachable fallback, not a behavior change.
      var x = scaleLinear().domain([0, max(committers, function(c) { return c.commits; }) ?? 0]).nice().range([0, w]);

      g.append('g').call(axisLeft(y).tickSizeOuter(0))
        .selectAll('text').attr('font-size', '12px').style('fill', T.text).attr('font-weight', function(d) {
          return d === 'Satoshi Nakamoto' ? '700' : '400';
        });

      // ScaleBand's call signature returns `number | undefined` (undefined
      // only if the key isn't in the domain). The domain here is built from
      // this same committers array, so every d.name is guaranteed present;
      // cast rather than fall back to 0 so a real bug wouldn't render at y=0
      // unnoticed.
      g.selectAll('.bar')
        .data(committers)
        .enter().append('rect')
        .attr('y', function(d) { return y(d.name) as number; })
        .attr('x', 0)
        .attr('height', y.bandwidth())
        .attr('width', function(d) { return x(d.commits); })
        .attr('fill', function(d, i) { return colors[i]; })
        .attr('rx', 2);

      g.selectAll('.label')
        .data(committers)
        .enter().append('text')
        .attr('y', function(d) { return (y(d.name) as number) + y.bandwidth() / 2; })
        .attr('x', function(d) { return x(d.commits) + 6; })
        .attr('dominant-baseline', 'central')
        .attr('font-size', '12px')
        .attr('font-weight', '600')
        .attr('fill', function(d, i) { return colors[i]; })
        .text(function(d) { return d.commits + ' (' + Math.round(d.commits / total * 100) + '%)'; });
    }

    // --- Timeline ---
    function panelTimeline() {
      var container = document.getElementById('svn-timeline-chart') as HTMLElement;
      if (!container) return;
      var T = readTokens();
      var colors = T.committers;
      container.innerHTML = '';
      var rect = container.getBoundingClientRect();
      var W = rect.width || 600;
      var margin = { top: 20, right: 20, bottom: 40, left: 120 };
      var H = 170;
      var w = W - margin.left - margin.right;
      var h = H - margin.top - margin.bottom;

      var svg = select(container).append('svg').attr('width', W).attr('height', H);
      var g = svg.append('g').attr('transform', 'translate(' + margin.left + ',' + margin.top + ')');

      // timeParse's return type is `Date | null` (null on an unparseable
      // string). Both literals below are fixed, always-valid "YYYY-MM-DD"
      // strings, so the `as Date` casts don't change behavior — they only
      // tell the type system what's already true at runtime.
      var parseDate = timeParse('%Y-%m-%d');
      var x = scaleTime()
        .domain([parseDate('2009-07-01') as Date, parseDate('2011-11-01') as Date])
        .range([0, w]);
      var y = scaleBand().domain(committers.map(function(c) { return c.name; })).range([0, h]).padding(0.4);

      // Pinned to <Date>: without it, TS infers the axis domain as
      // `Date | NumberValue` from scaleTime's call signature (which also
      // accepts plain numbers), and timeFormat()'s formatter — which only
      // takes a Date — then fails to satisfy tickFormat's wider signature.
      g.append('g').attr('transform', 'translate(0,' + h + ')')
        .call(axisBottom<Date>(x).ticks(6).tickFormat(timeFormat('%Y-%m')))
        .selectAll('text').attr('font-size', '10px').style('fill', T.text);

      g.append('g').call(axisLeft(y).tickSizeOuter(0))
        .selectAll('text').attr('font-size', '11px').style('fill', T.text);

      committers.forEach(function(c, i) {
        // c.firstCommit / c.lastCommit are always valid "YYYY-MM-DD" data
        // from the JSON, so the parse result is never actually null here.
        var x1 = x(parseDate(c.firstCommit) as Date);
        var x2 = x(parseDate(c.lastCommit) as Date);
        var barW = Math.max(x2 - x1, 3);

        g.append('rect')
          .attr('x', x1).attr('y', y(c.name) as number)
          .attr('width', barW).attr('height', y.bandwidth())
          .attr('fill', colors[i]).attr('rx', 2).attr('opacity', 0.8);

        // Start/end markers — surface stroke for halo against bar fill.
        g.append('circle').attr('cx', x1).attr('cy', (y(c.name) as number) + y.bandwidth() / 2)
          .attr('r', 3.5).attr('fill', colors[i]).attr('stroke', T.bg).attr('stroke-width', 1);
        if (barW > 6) {
          g.append('circle').attr('cx', x2).attr('cy', (y(c.name) as number) + y.bandwidth() / 2)
            .attr('r', 3.5).attr('fill', colors[i]).attr('stroke', T.bg).attr('stroke-width', 1);
        }
      });

      // Tooltip
      container.style.position = 'relative';
      var tooltip = select(container).append('div')
        .style('position', 'absolute').style('pointer-events', 'none').style('opacity', 0)
        .style('background', T.tooltipBg).style('color', T.tooltipFg)
        .style('padding', '6px 10px').style('border-radius', '4px')
        .style('font-size', '12px').style('white-space', 'nowrap').style('z-index', '10');

        svg.on('mousemove', function(event) {
          var coords = pointer(event, g.node());
          var yPos = coords[1];
          // .find() (rather than forEach + closure-mutated variable) so
          // TypeScript can narrow `found` after the `if (!found)` guard
          // below — a var reassigned inside a nested callback isn't
          // narrowed back to non-null in the enclosing scope. Bands never
          // overlap, so "first match" and the original "last match wins"
          // loop are equivalent here.
          var found = committers.find(function(c) {
            var top = y(c.name) as number;
            var bot = top + y.bandwidth();
            return yPos >= top && yPos <= bot;
          }) || null;
          if (!found) { tooltip.style('opacity', 0); return; }
          tooltip.html(
            '<b>' + found.name + '</b> (' + found.username + ')<br>' +
            found.commits + ' ' + l.commits + '<br>' +
            l.tooltipFirst + ': r' + found.firstRev + ' (' + found.firstCommit + ')<br>' +
            l.tooltipLast + ': r' + found.lastRev + ' (' + found.lastCommit + ')'
          ).style('opacity', 1);

          var cr = container.getBoundingClientRect();
          var tx = event.clientX - cr.left + 14;
          var ty = event.clientY - cr.top - 10;
          if (tx + 260 > cr.width) tx = tx - 280;
          tooltip.style('left', tx + 'px').style('top', ty + 'px');
      }).on('mouseleave', function() {
        tooltip.style('opacity', 0);
      });
    }

    rerender();

    // Reveal: per-panel time-cursor wipe on scroll-in (chart-anim.js wipeReveal).
    var replayFn: (() => void) | null = null;
    (function arm(n?: number) {
      if (window.BAChartAnim) {
        replayFn = window.BAChartAnim.wipeReveal(['svn-bar-chart', 'svn-timeline-chart'], { duration: 4600 });
      } else if ((n || 0) < 40) { setTimeout(function() { arm((n || 0) + 1); }, 50); }
    })();
    var rb = document.querySelector('.svn-committers [data-replay]');
    if (rb) rb.addEventListener('click', function() { if (replayFn) replayFn(); });

    var timer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', function() { clearTimeout(timer); timer = setTimeout(rerender, 250); });

    if (typeof window.matchMedia === 'function') {
      var mql = window.matchMedia('(prefers-color-scheme: dark)');
      if (mql.addEventListener) mql.addEventListener('change', rerender);
      else if (mql.addListener) mql.addListener(rerender);
    }
    if (typeof MutationObserver === 'function') {
      new MutationObserver(rerender).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-mode', 'data-theme'],
      });
    }
  }
  init();
})();
</script>

<style>
  .svn-committers {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section {
    margin-bottom: 2rem;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
  .chart-container {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
  }
</style>
