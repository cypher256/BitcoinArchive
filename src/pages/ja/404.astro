---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getEntries, findAuthorParticipant, translateParticipantName } from '../../i18n/utils';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Same byline/label metadata /entries computes for its full-text result
// cards (see src/pages/ja/entries/index.astro), built here so the 404
// page's "you might be looking for" suggestions can reuse the exact same
// hitCard() renderer instead of a bare link list (see entries-browse.ts).
const lang = 'ja';
const t = useTranslations(lang);
const allEntries = await getEntries(lang);
const authorMeta: Record<string, { slug: string; name: string }> = {};
const slugToName: Record<string, string> = {};
const typeLabels: Record<string, string> = {};
for (const e of allEntries) {
  const d = e.data as any;
  if (d.author && authorMeta[d.author] === undefined) {
    const ap = findAuthorParticipant(d.author, d.participants || []);
    authorMeta[d.author] = {
      slug: ap?.slug ?? '',
      name: translateParticipantName(ap?.name ?? d.author, ap?.slug, lang),
    };
  }
  for (const p of (d.participants || [])) {
    if (slugToName[p.slug] === undefined) slugToName[p.slug] = translateParticipantName(p.name, p.slug, lang);
  }
  if (d.type && typeLabels[d.type] === undefined) typeLabels[d.type] = t(`type.${d.type}` as any) || d.type;
}
const uiLabels = { event: t('entry.event' as any), added: t('entry.added' as any), updated: t('entry.updated' as any), biography: t('entry.biography' as any) };
const suggestionsConfig = {
  basePath,
  // Cloudflare Pages resolves 404s by walking up the directory tree, so this
  // file (dist/ja/404.html) is served for any unmatched path under /ja/ --
  // we are certain of the locale here, unlike the root 404 (see its comment
  // for why that one has to sniff the path client-side and carry both locales).
  ja: { indexName: 'bitcoin_archive_ja', authorMeta, slugToName, typeLabels, uiLabels },
};
---

<BaseLayout
  title="ページが見つかりません - Bitcoin Institute"
  description="お探しのページが見つかりませんでした。"
  lang="ja"
>
  <div class="container not-found">
    <h1>404</h1>
    <p>お探しのページは存在しません。</p>
    <a href={`${basePath}/ja/`}>トップへ戻る</a>

    <div id="suggestions" class="suggestions" hidden>
      <p class="suggestions-label">こちらのページもご覧ください：</p>
      <div id="suggestions-list"></div>
    </div>
  </div>
</BaseLayout>

<script type="application/json" id="suggestions-config" is:inline set:html={JSON.stringify(suggestionsConfig)}></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/algoliasearch@4.24.0/dist/algoliasearch-lite.umd.js"></script>
<script>
  import { init404Suggestions } from '../../scripts/entries-browse';
  init404Suggestions();
</script>

<style>
  .not-found {
    text-align: center;
    padding: 5rem 0;
  }
  .not-found h1 {
    font-size: 5rem;
    color: var(--color-accent);
    margin: 0 0 1rem;
  }
  .not-found p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
  .not-found a {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .suggestions {
    max-width: 40rem;
    margin: 3rem auto 0;
    text-align: left;
  }
  .suggestions-label {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
</style>
