---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryWidget from '../components/CategoryWidget.astro';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalUrl?: string;
  alternateJa?: string | null;
  alternateEn?: string | null;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  breadcrumbs?: Array<{
    name: string;
    url: string;
  }>;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
  /** Only ~5 of 6596 entries contain math ($$ blocks). Loading the KaTeX
      CSS unconditionally on every page cost ~760ms of render-blocking time
      site-wide for a feature almost no page uses — see the KaTeX <link>
      below, gated on this flag instead of always present in <head>. */
  hasMath?: boolean;
  /** PC-only 2-column sidebar (>=1200px; identical single-column render
   * below that, see global.css .entry-sidebar). Set to opt a page into
   * BaseLayout building the .container/.container-wide wrapper, the
   * sidebar aside (category widget + optional page-specific extra via
   * the `sidebar-extra` slot), and the .entry-main-col wrapper around
   * the default slot -- one place instead of every page hand-rolling
   * the same three elements. 'read' = .container (1000px, single-
   * document pages); 'wide' = .container-wide (1200px, list/hub
   * pages). Omit entirely for the handful of pages with their own
   * bespoke width handling (novel/, cite citation table, etc.) --
   * they keep rendering their own wrapper inside the plain <slot/>
   * exactly as before. */
  pageWidth?: 'read' | 'wide';
  /** Highlights the matching row in the category widget's expanded
   * type list -- pass the current entry's `type` on pages scoped to
   * one type (an entry-detail page, a /types/{type}/ listing). */
  sidebarCurrentType?: string;
  /** Highlights the matching "other categories" link (sources/
   * participants/tags/keywords) -- pass on that category's own index
   * or detail pages, which have no entry `type` of their own to match
   * against sidebarCurrentType. */
  sidebarCurrentCategory?: 'sources' | 'participants' | 'tags' | 'keywords';
}

const { title, description, lang, canonicalUrl, alternateJa, alternateEn, ogType, publishedTime, modifiedTime, author, noindex, ogImage, ogImageWidth, ogImageHeight, breadcrumbs, structuredData, hasMath = false, pageWidth, sidebarCurrentType, sidebarCurrentCategory } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    {/*
      Head-early inline blocking theme script. It MUST run before any
      stylesheet or font <link> resolves. It does three things:

      1. Read `localStorage.mode` and apply `data-mode` to <html>
         (3-way: light / dark / system; system = no attribute).
      2. Ensure `<meta name="theme-color">` exists in <head> and
         seed its content with a fixed hex computed from the active
         mode (no CSS variables — stylesheets haven't loaded yet,
         so `getComputedStyle('--color-bg')` returns empty here).
         This guarantees the mobile browser chrome (address bar,
         task switcher) is correct from the very first paint;
         dark-mode users no longer see a flash of light chrome.
      3. After stylesheets resolve (DOMContentLoaded or later), run
         `syncBrowserChrome()` to refresh the meta from the actual
         `--color-bg` value — handles the rare case where the
         token diverges from the seeded literal, and tracks any
         later mode flip via media query / MutationObserver.

      The seeded literals MUST stay in sync with `--color-bg` in
      `src/styles/global.css` (light: `#ffffff`; dark: `#0e1218`).
      If you change the bg token, change them here too.

      Wrapped in a try/catch because localStorage can throw in
      private browsing modes — silent fallback to defaults is
      better than blowing up first paint.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var m = null;
          try { m = localStorage.getItem('mode'); } catch (_) {}
          if (m === 'light' || m === 'dark') root.setAttribute('data-mode', m);
        } catch (_) {}

        // Resolve the active mode in the same 3-way logic the CSS uses:
        //   data-mode='light'  → light
        //   data-mode='dark'   → dark
        //   no attribute       → follow OS preference
        function activeMode() {
          var attr = root.getAttribute('data-mode');
          if (attr === 'light' || attr === 'dark') return attr;
          try {
            return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch (_) { return 'light'; }
        }
        // Light / dark `--color-bg` literals from `src/styles/global.css`.
        // Kept in sync manually — see the doc-comment above.
        function bgLiteralFor(mode) {
          return mode === 'dark' ? '#0e1218' : '#ffffff';
        }

        // Ensure the theme-color meta exists in <head>. Created on demand
        // so this script doesn't depend on BaseHead's render order — if
        // <head> emits other tags first, the meta is appended; if a
        // future BaseHead change adds a literal <meta>, this finds it.
        function ensureThemeColorMeta() {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (!meta) {
            meta = document.createElement('meta');
            meta.setAttribute('name', 'theme-color');
            document.head.appendChild(meta);
          }
          return meta;
        }

        // Step 2: seed the meta immediately with the literal for the
        // active mode so the address bar paints correctly on the first
        // frame. Stylesheets are still loading; we cannot read CSS vars.
        var seedMeta = ensureThemeColorMeta();
        seedMeta.setAttribute('content', bgLiteralFor(activeMode()));

        // Step 3: once stylesheets resolve, refresh from the actual
        // `--color-bg` token so any future palette change in global.css
        // propagates without touching the literals above.
        function syncBrowserChrome() {
          var meta = ensureThemeColorMeta();
          var bg = getComputedStyle(root).getPropertyValue('--color-bg').trim();
          if (bg) meta.setAttribute('content', bg);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncBrowserChrome);
        } else {
          syncBrowserChrome();
        }
        // Also re-run when OS preference flips, when the user toggles
        // mode, or when any script mutates the attribute.
        try {
          var mq = matchMedia('(prefers-color-scheme: dark)');
          if (mq.addEventListener) mq.addEventListener('change', syncBrowserChrome);
          // Legacy fallback for browsers without addEventListener on
          // MediaQueryList (Safari < 14). Deprecated but still the
          // only API there.
          // @ts-ignore
          else if (mq.addListener) mq.addListener(syncBrowserChrome);
        } catch (_) {}
        try {
          new MutationObserver(syncBrowserChrome).observe(
            root,
            { attributes: true, attributeFilter: ['data-mode'] }
          );
        } catch (_) {}
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      canonicalUrl={canonicalUrl}
      alternateJa={alternateJa}
      alternateEn={alternateEn}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      noindex={noindex}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      breadcrumbs={breadcrumbs}
      structuredData={structuredData}
    />
    {hasMath && (
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" integrity="sha384-zh0CIslj+VczCZtlzBcjt5ppRcsAmDnRem7ESsYwWwg3m/OaJ2l4x7YBZl9Kxxib" crossorigin="anonymous">
    )}
  </head>
  <body>
    <Header lang={lang} alternateHref={lang === 'ja' ? alternateEn : alternateJa} />
    <main>
      {pageWidth ? (
        <div class:list={[pageWidth === 'wide' ? 'container-wide' : 'container', 'has-2col-sidebar']}>
          <aside class="entry-sidebar">
            <slot name="sidebar-extra" />
            <CategoryWidget lang={lang} currentType={sidebarCurrentType} currentCategory={sidebarCurrentCategory} />
          </aside>
          <div class="entry-main-col">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>
    <Footer lang={lang} />
    {/*
      Horizontal-scroll affordance. iOS/Android hide the scrollbar until you
      drag, so an overflowing table / mermaid / code block gives no hint that
      there's more to the side. Tag each scroller with
      data-scroll=right|left|both|none from its scroll position; global.css
      then fades the edge(s) that still have off-screen content. Progressive
      enhancement: with no JS the attribute is absent and the block scrolls
      plainly. Most d3 charts (data-kind="chart") resize to fit and never
      scroll, so update() below just tags them "none" (no visual effect) --
      but a few (fork-genealogy, identity-suspect-map) force a min-width
      wider than narrow viewports on purpose, so "chart" stays in the
      selector rather than being excluded wholesale. Chart-embed figures
      are mounted client-side by ChartEmbedRuntime.astro well after this
      script's first pass, so a MutationObserver re-scans for newly
      inserted matches instead of a one-time querySelectorAll.
      .minimap-scroll (the /sources/{source} list-page minimap, see
      lib/minimap.ts) reuses this same mechanism rather than a one-off --
      it only forces a min-width past the viewport for a source with many
      years, so most sources tag "none" just like a chart that fits.
    */}
    <script>
      (() => {
        const sel =
          '.figure-block[data-kind="mermaid"], .figure-block[data-kind="table"], .figure-block[data-kind="chart"], .figure-block[data-kind="visual"], pre, .minimap-scroll';
        const update = (el: HTMLElement) => {
          const max = el.scrollWidth - el.clientWidth;
          if (max <= 2) {
            el.setAttribute('data-scroll', 'none');
            return;
          }
          const x = el.scrollLeft;
          el.setAttribute(
            'data-scroll',
            x <= 2 ? 'right' : x >= max - 2 ? 'left' : 'both',
          );
        };
        const bound = new Set<HTMLElement>();
        const ro =
          'ResizeObserver' in window
            ? new ResizeObserver((entries) =>
                entries.forEach((e) => update(e.target as HTMLElement)),
              )
            : null;
        const bind = (el: HTMLElement) => {
          if (bound.has(el)) return;
          bound.add(el);
          update(el);
          let ticking = false;
          el.addEventListener(
            'scroll',
            () => {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(() => {
                ticking = false;
                update(el);
              });
            },
            { passive: true },
          );
          ro && ro.observe(el);
        };
        const scan = () => document.querySelectorAll<HTMLElement>(sel).forEach(bind);
        scan();
        addEventListener('resize', () => bound.forEach(update), { passive: true });
        // Tables can reflow once web fonts load; re-measure when ready.
        if (document.fonts) document.fonts.ready.then(() => bound.forEach(update));
        // Coalesce bursts of mutations (e.g. a chart drawer building a
        // multi-node SVG) into a single re-scan per frame instead of one
        // querySelectorAll per mutation record.
        let scanScheduled = false;
        const scheduleScan = () => {
          if (scanScheduled) return;
          scanScheduled = true;
          requestAnimationFrame(() => {
            scanScheduled = false;
            scan();
          });
        };
        new MutationObserver(scheduleScan).observe(document.body, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
    {/*
      Height-aware table sizing. On wide screens, a 2- or 3-column table
      can be shorter either with its natural content width or with a shared
      30em cell cap. CSS cannot compare those two rendered heights, so try
      the bounded layout for every such table and keep it only when it is
      no taller. The attribute is runtime state, not a per-table rule.
      Below 1200px the existing responsive cap remains unchanged.
    */}
    <script>
      (() => {
        const tables = () =>
          Array.from(
            document.querySelectorAll('.figure-block[data-kind="table"] > table'),
          ).filter((table) => {
            const columns = table.rows[0]?.cells.length ?? 0;
            return columns >= 2 && columns <= 3;
          });
        let ticking = false;
        const apply = () => {
          const candidates = tables();
          candidates.forEach((table) => {
            table.removeAttribute('data-width-trial');
          });
          if (window.innerWidth < 1200) return;
          for (const table of candidates) {
            const naturalHeight = table.getBoundingClientRect().height;
            table.setAttribute('data-width-trial', '');
            const boundedHeight = table.getBoundingClientRect().height;
            if (boundedHeight > naturalHeight + 0.5) {
              table.removeAttribute('data-width-trial');
            }
          }
        };
        const schedule = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            apply();
          });
        };
        apply();
        addEventListener('resize', schedule, { passive: true });
        if (document.fonts) document.fonts.ready.then(schedule);
      })();
    </script>
    {/*
      Overflow-only figure breakout (pairs with global.css
      `.figure-outer[data-breakout]`, see the figure-block section there).
      A figure that fits the prose column keeps its exact in-column layout;
      only a figure whose required width exceeds the column is promoted:
      its .figure-outer gets `data-breakout`, which enables the viewport
      breakout and centers the block. Pure CSS cannot branch on "content
      overflows" (grid `safe center` clamps in the wrong direction), hence
      this one-attribute script. No-JS fallback: attribute absent, figure
      scrolls in-column (status quo).

      Per-kind threshold: table keeps 1500px (chosen 0531 to avoid the
      1100-1499px zone where a small table breakout reads as misaligned
      with prose). Mermaid/chart use 1200px (mermaid's original pre-0531
      threshold, restored 2026-08-14) — a diagram/chart isn't expected to
      sit flush with the prose column the way a table is, so the same
      alignment concern doesn't apply. The CSS media query itself only
      needs the lowest threshold (1200px); this script is what withholds
      `data-breakout` from table blocks until 1500px.

      Required-width predicate, per kind:
      - table / mermaid: `scrollWidth` is stable across the breakout
        toggle (neither resizes itself — table is natural width, mermaid
        is `width: max-content`), so comparing it against the column
        directly never flip-flops.
      - chart (d3): the SVG resizes itself to fill whatever width its
        figure-block is given (`width: 100%`), so scrollWidth AFTER a
        breakout is already applied always reads "fits" — checking it
        would flip data-breakout on, then off, then on again. Read each
        chart's own declared CSS `min-width` instead (e.g. `.ce-chart
        {min-width:1080px}`, `.srm-svg{min-width:760px}` in
        ChartEmbedRuntime.astro) — a static per-chart-type declaration
        that doesn't change with the figure-block's current width.

      Full history of why this script covers all three kinds via the
      same overflow-gated mechanism (table used to be the only one;
      mermaid/chart used to get breakout from an unconditional CSS
      rule instead): see STYLE_GUIDE_VISUAL.md § d3 components →
      Layout width consideration → History.
    */}
    <script>
      (() => {
        const sel =
          '.figure-outer > .figure-block[data-kind="table"], ' +
          '.figure-outer > .figure-block[data-kind="mermaid"], ' +
          '.figure-outer > .figure-block[data-kind="chart"]';
        const threshold: Record<string, number> = { table: 1500, mermaid: 1200, chart: 1200 };
        const blocks: HTMLElement[] = [];
        // Measure the prose column each block actually lives in. The
        // first `.container-wide` in the document is the site header,
        // which is wider than the reading column — querying globally
        // would misclassify figures narrower than the header band.
        const columnWidth = (block: HTMLElement): number => {
          // .entry-main-col matches first (nearer ancestor) on the
          // >=1200px 2-column editorial entry layout, where .container
          // itself has become the sidebar+content grid and no longer
          // equals the content column's own width -- see global.css
          // .has-2col-sidebar. Every other .container/.container-wide
          // page (no .entry-main-col in its markup) is unaffected.
          const c = block.closest('.entry-main-col, .container, .container-wide');
          if (!c) return 0;
          const cs = getComputedStyle(c);
          return (
            c.clientWidth -
            parseFloat(cs.paddingLeft) -
            parseFloat(cs.paddingRight)
          );
        };
        const chartRequiredWidth = (block: HTMLElement): number => {
          let max = 0;
          for (const el of block.querySelectorAll('*')) {
            const mw = parseFloat(getComputedStyle(el).minWidth);
            if (mw > max) max = mw;
          }
          return max || block.scrollWidth;
        };
        const requiredWidth = (block: HTMLElement): number =>
          block.dataset.kind === 'chart'
            ? chartRequiredWidth(block)
            : block.scrollWidth;
        // Whenever a figure needs horizontal scroll at all -- with or
        // without the breakout above (mermaid/chart only; tables have
        // never auto-centered their scroll position) -- center its
        // initial scroll position instead of leaving it flush against
        // the left edge. Not gated on `data-breakout`: a figure below
        // the breakout viewport threshold (e.g. a mobile-width column)
        // that still overflows should start centered too. Skipped once
        // the visitor scrolls the block themselves, so this never
        // fights a manual scroll on resize/mutation-triggered re-runs.
        const userScrolled = new WeakSet<HTMLElement>();
        const centerScroll = (block: HTMLElement) => {
          if (block.dataset.kind === 'table' || userScrolled.has(block)) return;
          const max = block.scrollWidth - block.clientWidth;
          if (max > 2) block.scrollLeft = max / 2;
        };
        // Breakout margin: how far .figure-outer may expand left/right of
        // its own normal (non-breakout) position. Previously a single
        // symmetric `calc((100vw - 100%) / -2 + 2rem)` on both sides --
        // correct only when the containing block sits centered in the
        // viewport, which no longer holds on the >=1200px 2-column
        // entry layout (the content column is offset right, past the
        // sidebar). Measuring live and setting the two sides
        // independently as custom properties works unconditionally,
        // sidebar or not, so this replaced the CSS-only formula
        // everywhere rather than keeping two code paths.
        const BREAKOUT_GUTTER = 32; // 2rem, matches the prior formula's own +2rem term
        const setBreakoutMargins = (outer: HTMLElement) => {
          // Read BEFORE data-breakout is applied, while .figure-outer
          // still sits at its normal (non-breakout) position -- reading
          // after would measure the already-expanded box, which is
          // circular (the margin we're computing would feed back into
          // the rect used to compute it).
          const rect = outer.getBoundingClientRect();
          // On the 2-column editorial layout, the sidebar occupies real
          // space to the left -- "available" space stops at its right
          // edge, not at the viewport edge (x=0). Without this, the
          // breakout expands leftward straight through the sidebar.
          // Every other page (no sidebar in this block's ancestry) keeps
          // the viewport edge as the boundary, same as before.
          const sidebar = outer.closest('.has-2col-sidebar')?.querySelector('.entry-sidebar');
          const leftBoundary =
            sidebar && getComputedStyle(sidebar).display !== 'none'
              ? sidebar.getBoundingClientRect().right
              : 0;
          const left = Math.max(rect.left - leftBoundary - BREAKOUT_GUTTER, 0);
          const right = Math.max(window.innerWidth - rect.right - BREAKOUT_GUTTER, 0);
          outer.style.setProperty('--breakout-left', left + 'px');
          outer.style.setProperty('--breakout-right', right + 'px');
          // A figure narrower than its expanded box (mermaid, table --
          // chart is width:100% and unaffected) re-centers itself via
          // `margin-inline: auto` (global.css .figure-block) -- correct
          // when left/right grow by roughly the same amount, but with
          // the sidebar this box is lopsided (small left, large right),
          // and centering within a lopsided box visibly drags the
          // figure right of the prose column's own left edge. Pin it
          // flush left instead whenever the sidebar is the reason for
          // the asymmetry.
          outer.style.setProperty('--breakout-figure-align', leftBoundary > 0 ? '0' : 'auto');
        };
        const apply = () => {
          for (const block of blocks) {
            const outer = block.parentElement as HTMLElement | null;
            if (!outer) continue;
            // Clear first so both the columnWidth() read below and the
            // rect setBreakoutMargins() reads reflect normal (non-
            // breakout) layout, regardless of this block's state from
            // the previous apply() pass.
            outer.removeAttribute('data-breakout');
            const wide = window.innerWidth >= (threshold[block.dataset.kind ?? ''] ?? 1500);
            const col = columnWidth(block);
            if (wide && col > 0 && requiredWidth(block) > col + 1) {
              setBreakoutMargins(outer);
              outer.setAttribute('data-breakout', '');
            } else {
              outer.style.removeProperty('--breakout-left');
              outer.style.removeProperty('--breakout-right');
              outer.style.removeProperty('--breakout-figure-align');
            }
            // Reading scrollWidth/clientWidth here forces the layout to
            // reflect the attribute change just made above.
            centerScroll(block);
          }
        };
        let ticking = false;
        const schedule = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            apply();
          });
        };
        const bound = new Set<HTMLElement>();
        const ro = 'ResizeObserver' in window ? new ResizeObserver(schedule) : null;
        const bind = (block: HTMLElement) => {
          if (bound.has(block)) return;
          bound.add(block);
          blocks.push(block);
          const inner =
            block.querySelector('table, svg, .ce-chart, .ce-map, .srm-wrap') || block;
          ro && ro.observe(inner);
          // First user-initiated scroll cancels auto-centering for this
          // block from then on -- 'wheel'/'touchstart' (not 'scroll',
          // which also fires for the programmatic centering itself).
          const markUser = () => userScrolled.add(block);
          block.addEventListener('wheel', markUser, { passive: true, once: true });
          block.addEventListener('touchstart', markUser, { passive: true, once: true });
        };
        // Table/mermaid figures exist in the initial SSR HTML; chart
        // figures are mounted client-side by ChartEmbedRuntime.astro
        // well after this script's first pass, so a MutationObserver
        // re-scans for newly inserted matches instead of a one-time
        // querySelectorAll (mirrors the scroll-affordance script above).
        const scan = () => document.querySelectorAll<HTMLElement>(sel).forEach(bind);
        scan();
        apply();
        addEventListener('resize', schedule, { passive: true });
        // Figures reflow after web fonts load and when late layout
        // (vertical headers, sibling figures) settles — re-measure on
        // both.
        if (document.fonts) document.fonts.ready.then(schedule);
        let scanScheduled = false;
        const scheduleScan = () => {
          if (scanScheduled) return;
          scanScheduled = true;
          requestAnimationFrame(() => {
            scanScheduled = false;
            scan();
            apply();
          });
        };
        new MutationObserver(scheduleScan).observe(document.body, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
  </body>
</html>
