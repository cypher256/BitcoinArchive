---
import type { Lang } from '../i18n/ui';
import type { GraphData } from '../lib/graphData';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  graphData: GraphData;
  lang: Lang;
}

const { graphData, lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="network-graph-wrapper">
  <p class="graph-instructions">{t('network.instructions' as any)}</p>
  <div class="graph-stage">
    <div id="network-graph"></div>
    <div class="zoom-controls">
      <button type="button" id="zoom-out" class="zoom-btn" aria-label="Zoom out">−</button>
      <input type="range" id="zoom-slider" min="0.3" max="5" step="0.05" value="1" aria-label="Zoom level" />
      <button type="button" id="zoom-in" class="zoom-btn" aria-label="Zoom in">+</button>
      <button type="button" id="zoom-reset" class="zoom-btn zoom-reset" aria-label="Reset zoom">⟲</button>
    </div>
  </div>
  <script type="application/json" id="graph-data" set:html={JSON.stringify(graphData)} />
  <script
    type="application/json"
    id="graph-meta"
    set:html={JSON.stringify({
      lang,
      basePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}${lang === 'ja' ? '/ja' : ''}`,
      entriesLabel: t('network.entries' as any),
      coLabel: t('network.coOccurrences' as any),
    })}
  />
</div>

<script>
// Real ES-module script (no define:vars, no is:inline) so Vite bundles it
// and tree-shakes d3 down to the four submodules actually used here,
// instead of shipping the ~92KB full d3 CDN bundle for ~4KB of API surface.
// define:vars would force Astro to treat this as is:inline (no import
// processing) — see the sibling `#graph-meta` JSON block above for how
// server-side values now cross into this script instead.
import { select } from 'd3-selection';
// Renamed on import: the component already has local variables named
// `drag` and `zoom` (the d3 behavior instances configured below), which
// would otherwise shadow these bindings within their own scope.
import { drag as d3drag } from 'd3-drag';
import { zoom as d3zoom, zoomIdentity } from 'd3-zoom';
import { forceSimulation, forceLink, forceManyBody, forceCenter, forceCollide, forceX, forceY } from 'd3-force';
import type { SimulationNodeDatum, SimulationLinkDatum } from 'd3-force';
import type { GraphNode, GraphEdge } from '../lib/graphData';

// d3-force mutates each datum in place, adding x/y/vx/vy/fx/fy (SimulationNodeDatum)
// as the simulation runs; SimulationLinkDatum resolves source/target from the
// plain string ids in GraphEdge to full node object references at runtime.
interface SimNode extends GraphNode, SimulationNodeDatum {}
interface SimEdge extends SimulationLinkDatum<SimNode> {
  weight: number;
}

(function() {
  // Asserted non-null: the runtime check right below returns early if any
  // of these three lookups actually failed, but that guard doesn't narrow
  // the type inside functions declared further down (draw(), etc.), so the
  // type itself has to already say "non-null" for those call sites to
  // type-check.
  var container = document.getElementById('network-graph') as HTMLElement;
  var dataEl = document.getElementById('graph-data') as HTMLElement;
  var metaEl = document.getElementById('graph-meta') as HTMLElement;
  if (!container || !dataEl || !metaEl) return;

  var data = JSON.parse(dataEl.textContent as string) as { nodes: GraphNode[]; edges: GraphEdge[] };
  var nodes = data.nodes;
  var edges = data.edges;
  var meta = JSON.parse(metaEl.textContent as string) as { lang: string; basePath: string; entriesLabel: string; coLabel: string };
  var lang = meta.lang;
  var basePath = meta.basePath;
  var entriesLabel = meta.entriesLabel;
  var coLabel = meta.coLabel;

  function token(name: string) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function readTokens() {
    return {
      satoshi: token('--color-accent'),
      // Other-participant nodes use --chart-color-9 (slate). The
      // existing literal #5b7f95 (the "satoshi vs other" cool tone)
      // maps onto --chart-color-9 in light + brighter slate in dark
      // mode so the contrast stays similar across themes.
      other: token('--chart-color-9'),
      edge: token('--color-divider'),
      labelFill: token('--color-text'),
      labelHalo: token('--color-bg'),
    };
  }

  var abortCtrl: AbortController | null = null;
  function draw() {
    container.innerHTML = '';
    var T = readTokens();
    if (abortCtrl) abortCtrl.abort();
    abortCtrl = new AbortController();

    // 固定のシミュレーション空間（viewBox で自動スケーリング）
    // scale: 1.0 = 等倍、2.0 = 2倍表示（viewBox を縮小して相対的に拡大）
    var scale = 1.5;
    var baseW = 800;
    var baseH = 600;
    var simW = Math.round(baseW / scale);
    var simH = Math.round(baseH / scale);

    var maxCount = 1;
    var minCount = Infinity;
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].count > maxCount) maxCount = nodes[i].count;
      if (nodes[i].count < minCount) minCount = nodes[i].count;
    }

    var maxWeight = 1;
    for (var i = 0; i < edges.length; i++) {
      if (edges[i].weight > maxWeight) maxWeight = edges[i].weight;
    }

    function nodeRadius(count: number) {
      if (maxCount <= 1) return 8;
      var t = Math.log(count) / Math.log(maxCount);
      return 5 + t * 30;
    }

    function edgeWidth(weight: number) {
      if (maxWeight <= 1) return 1;
      var t = Math.log(weight) / Math.log(maxWeight);
      return 0.75 + t * 5.25;
    }

    // viewBox で固定空間を定義、SVG は常にコンテナ幅にフィット
    var margin = 0;
    var svg = select(container).append('svg')
      .attr('width', '100%')
      .attr('viewBox', (-margin) + ' ' + (-margin) + ' ' + (simW + margin * 2) + ' ' + (simH + margin * 2))
      .attr('preserveAspectRatio', 'xMidYMid meet');

    var g = svg.append('g');

    var slider = document.getElementById('zoom-slider') as HTMLInputElement | null;
    var zoomIn = document.getElementById('zoom-in');
    var zoomOut = document.getElementById('zoom-out');
    var zoomReset = document.getElementById('zoom-reset');

    var zoom = d3zoom<SVGSVGElement, unknown>()
      .scaleExtent([0.3, 5])
      .on('zoom', function(event) {
        g.attr('transform', event.transform);
        if (slider) slider.value = event.transform.k;
      });
    svg.call(zoom);

    var signal = abortCtrl.signal;
    if (slider) {
      var sliderEl: HTMLInputElement = slider;
      sliderEl.value = '1';
      sliderEl.addEventListener('input', function() {
        svg.transition().duration(100).call(zoom.scaleTo, parseFloat(sliderEl.value));
      }, { signal: signal });
    }
    if (zoomIn) {
      zoomIn.addEventListener('click', function() {
        svg.transition().duration(200).call(zoom.scaleBy, 1.3);
      }, { signal: signal });
    }
    if (zoomOut) {
      zoomOut.addEventListener('click', function() {
        svg.transition().duration(200).call(zoom.scaleBy, 1 / 1.3);
      }, { signal: signal });
    }
    if (zoomReset) {
      zoomReset.addEventListener('click', function() {
        svg.transition().duration(300).call(zoom.transform, zoomIdentity);
      }, { signal: signal });
    }

    var tooltip = select(container).append('div')
      .attr('class', 'graph-tooltip')
      .style('opacity', 0);

    var adjMap: Record<string, string[]> = {};
    for (var i = 0; i < nodes.length; i++) adjMap[nodes[i].id] = [];
    for (var i = 0; i < edges.length; i++) {
      adjMap[edges[i].source] = adjMap[edges[i].source] || [];
      adjMap[edges[i].target] = adjMap[edges[i].target] || [];
      adjMap[edges[i].source].push(edges[i].target);
      adjMap[edges[i].target].push(edges[i].source);
    }

    var simNodes: SimNode[] = nodes.map(function(n) {
      return { id: n.id, name: n.name, count: n.count, isSatoshi: n.isSatoshi };
    });
    var simEdges: SimEdge[] = edges.map(function(e) {
      return { source: e.source, target: e.target, weight: e.weight };
    });

    // 描画順: count 昇順ソートで登場回数の多いノード（Satoshi 等）を前面に
    simNodes.sort(function(a, b) { return a.count - b.count; });

    var cx = simW / 2, cy = simH / 2;
    var simulation = forceSimulation(simNodes)
      .force('link', forceLink<SimNode, SimEdge>(simEdges).id(function(d) { return d.id; })
        .distance(function(d) { return 120 / Math.log(d.weight + 1); }))
      .force('charge', forceManyBody<SimNode>().strength(function(d) { return d.isSatoshi ? -400 : -120; }))
      .force('center', forceCenter(cx, cy))
      .force('collide', forceCollide<SimNode>().radius(function(d) { return nodeRadius(d.count) + 4; }))
      .force('gravityX', forceX<SimNode>(cx).strength(function(d) { return d.isSatoshi ? 0.3 : 0.05; }))
      .force('gravityY', forceY<SimNode>(cy).strength(function(d) { return d.isSatoshi ? 0.3 : 0.05; }));

    // Precompute the layout synchronously, off-DOM, instead of letting the
    // simulation's automatic timer drive ~300 ticks of live SVG attribute
    // updates across every node/edge/label as the graph "settles" into
    // place. simulation.tick(n) advances the physics in memory only (no
    // DOM writes at all), so this costs a fraction of a millisecond; the
    // graph then appears already-settled on first paint. .stop() prevents
    // the auto-timer from also firing during this loop. Drag interactions
    // still animate live: a drag's 'start' handler calls
    // simulation.alphaTarget(0.3).restart(), which resumes the timer and
    // re-triggers the 'tick' listener attached below.
    simulation.stop();
    var settleTicks = Math.ceil(Math.log(simulation.alphaMin()) / Math.log(1 - simulation.alphaDecay()));
    simulation.tick(settleTicks);

    var link = g.append('g')
      .selectAll('line')
      .data(simEdges)
      .enter().append('line')
      .attr('stroke', T.edge)
      .attr('stroke-opacity', 0.6)
      .attr('stroke-width', function(d) { return edgeWidth(d.weight); });

    var node = g.append('g')
      .selectAll('circle')
      .data(simNodes)
      .enter().append('circle')
      .attr('r', function(d) { return nodeRadius(d.count); })
      .attr('fill', function(d) { return d.isSatoshi ? T.satoshi : T.other; })
      .attr('stroke', T.labelHalo)
      .attr('stroke-width', 1.5)
      .style('cursor', 'pointer');

    var label = g.append('g')
      .selectAll('text')
      .data(simNodes)
      .enter().append('text')
      .text(function(d) { return d.name; })
      .attr('font-size', function(d) { return d.isSatoshi ? '13px' : '10px'; })
      .attr('font-family', 'var(--font-heading), system-ui, sans-serif')
      .attr('font-weight', function(d) { return d.isSatoshi ? '700' : '400'; })
      .attr('fill', T.labelFill)
      .attr('stroke', T.labelHalo)
      .attr('stroke-width', 2)
      .attr('stroke-linejoin', 'round')
      .attr('paint-order', 'stroke')
      .attr('text-anchor', 'middle')
      .attr('dy', function(d) { return -nodeRadius(d.count) - 4; })
      .style('pointer-events', 'none')
      .style('opacity', function(d) { return d.count > 3 ? 1 : d.count >= 2 ? 0.5 : 0.3; });

    // Highlight helper (shared by hover and drag)
    function highlightNode(d: SimNode) {
      var neighbors = adjMap[d.id] || [];
      var neighborSet: Record<string, boolean> = {};
      for (var i = 0; i < neighbors.length; i++) neighborSet[neighbors[i]] = true;

      node.attr('opacity', function(n) {
        return n.id === d.id || neighborSet[n.id] ? 1 : 0.15;
      });
      link.attr('stroke-opacity', function(l) {
        var s = l.source as SimNode, t = l.target as SimNode;
        return (s.id === d.id || t.id === d.id) ? 0.9 : 0.05;
      });
      label.style('opacity', function(n) {
        return n.id === d.id || neighborSet[n.id] ? 1 : 0.1;
      });
    }

    function unhighlightAll() {
      node.attr('opacity', 1);
      link.attr('stroke-opacity', 0.6);
      label.style('opacity', function(d) { return d.count > 3 ? 1 : d.count >= 2 ? 0.5 : 0.3; });
    }

    // Drag
    var drag = d3drag<SVGCircleElement, SimNode>()
      .on('start', function(event, d) {
        if (!event.active) simulation.alphaTarget(0.3).restart();
        d.fx = d.x; d.fy = d.y;
        highlightNode(d);
      })
      .on('drag', function(event, d) {
        d.fx = event.x; d.fy = event.y;
      })
      .on('end', function(event, d) {
        if (!event.active) simulation.alphaTarget(0);
        d.fx = null; d.fy = null;
        unhighlightAll();
        tooltip.style('opacity', 0);
      });
    node.call(drag);

    // Hover
    node.on('mouseover', function(event, d) {
      highlightNode(d);

      var html = '<strong>' + d.name + '</strong><br>' + d.count + ' ' + entriesLabel;
      var connEdges = simEdges.filter(function(e) {
        var s = e.source as SimNode, t = e.target as SimNode;
        return s.id === d.id || t.id === d.id;
      });
      if (connEdges.length > 0) {
        connEdges.sort(function(a, b) { return b.weight - a.weight; });
        var top = connEdges.slice(0, 5);
        // Connection list — color comes from --color-text-muted via
        // the inline style; the tooltip font-color falls back to
        // --color-text on the parent for the headline.
        html += '<br><span style="font-size:0.8em;color:var(--color-text-muted)">';
        for (var i = 0; i < top.length; i++) {
          var s = top[i].source as SimNode, t = top[i].target as SimNode;
          var other = s.id === d.id ? t : s;
          html += other.name + ': ' + top[i].weight + ' ' + coLabel;
          if (i < top.length - 1) html += '<br>';
        }
        html += '</span>';
      }

      tooltip.html(html)
        .style('opacity', 1)
        .style('left', (event.offsetX + 15) + 'px')
        .style('top', (event.offsetY - 10) + 'px');
    })
    .on('mousemove', function(event) {
      tooltip
        .style('left', (event.offsetX + 15) + 'px')
        .style('top', (event.offsetY - 10) + 'px');
    })
    .on('mouseout', function() {
      unhighlightAll();
      tooltip.style('opacity', 0);
    });

    // Click → navigate to participant page
    node.on('click', function(event, d) {
      window.location.href = basePath + '/participants/' + d.id + '/';
    });

    function ticked() {
      link
        .attr('x1', function(d) { return (d.source as SimNode).x ?? 0; })
        .attr('y1', function(d) { return (d.source as SimNode).y ?? 0; })
        .attr('x2', function(d) { return (d.target as SimNode).x ?? 0; })
        .attr('y2', function(d) { return (d.target as SimNode).y ?? 0; });
      node
        .attr('cx', function(d) { return d.x ?? 0; })
        .attr('cy', function(d) { return d.y ?? 0; });
      label
        .attr('x', function(d) { return d.x ?? 0; })
        .attr('y', function(d) { return d.y ?? 0; });
    }
    // Paint once immediately at the pre-settled positions (simulation is
    // stopped, so nothing will call this automatically until a drag
    // restarts it) — otherwise every element would sit at its (0, 0)
    // default until some future tick.
    ticked();
    simulation.on('tick', ticked);
  }

  // d3 is a static import now (bundled, not a CDN global), so it's already
  // available by the time this module runs — no more polling for it.
  function init() {
    draw();
  }

  // Lazy: defer rendering until the graph is about to enter the viewport.
  // The graph is below the fold for most visitors; delaying the D3 render
  // until it's actually needed improves LCP on the home page.
  var started = false;
  function startOnce() {
    if (started) return;
    started = true;
    init();
  }

  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          startOnce();
          observer.disconnect();
          break;
        }
      }
    }, { rootMargin: '200px' });
    observer.observe(container);
  } else {
    // Fallback for browsers without IntersectionObserver: render immediately.
    startOnce();
  }

  var resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', function() {
    if (!started) return;
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      draw();
    }, 250);
  });

  // Theme/mode listeners — repaint when palette changes. Guarded
  // by `started` so we don't trigger lazy-init prematurely (the
  // graph only renders when scrolled into view).
  function rerenderIfStarted() {
    if (!started) return;
    draw();
  }
  if (typeof window.matchMedia === 'function') {
    var mql = window.matchMedia('(prefers-color-scheme: dark)');
    if (mql.addEventListener) mql.addEventListener('change', rerenderIfStarted);
    else if (mql.addListener) mql.addListener(rerenderIfStarted);
  }
  if (typeof MutationObserver === 'function') {
    new MutationObserver(rerenderIfStarted).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-mode', 'data-theme'],
    });
  }
})();
</script>

<style>
  .network-graph-wrapper {
    position: relative;
  }
  .graph-instructions {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .graph-stage {
    position: relative;
  }
  #network-graph {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  #network-graph:empty::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Skeleton shimmer — token-driven so it stays subtle on both
       light and dark themes. The transparent middle stop fades to
       --color-divider for the visible band. */
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-divider),
      transparent
    );
    background-size: 200% 100%;
    opacity: 0.4;
    animation: network-skeleton 1.8s ease-in-out infinite;
  }
  @keyframes network-skeleton {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  #network-graph :global(svg) {
    display: block;
  }
  .zoom-controls {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.5rem;
    /* Semitransparent surface so underlying graph stays visible. */
    background: var(--color-bg);
    opacity: 0.92;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    backdrop-filter: blur(2px);
  }
  .zoom-btn {
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .zoom-btn:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }
  .zoom-btn.zoom-reset {
    font-size: 0.9rem;
  }
  #zoom-slider {
    width: 120px;
    cursor: pointer;
  }
  @media (max-width: 480px) {
    #zoom-slider { width: 80px; }
    .zoom-controls { gap: 0.25rem; padding: 0.25rem 0.4rem; }
  }
  #network-graph :global(.graph-tooltip) {
    position: absolute;
    pointer-events: none;
    /* Surface stays slightly transparent (0.96 opacity) so the
       underlying graph remains visible behind dense node clusters. */
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    z-index: 10;
    max-width: 260px;
    opacity: 0.96;
  }
</style>
