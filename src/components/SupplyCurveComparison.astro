---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const seriesData = await import('../data/supply-curves/series.json').then(m => m.default);

const labels = {
  en: {
    title: 'Supply trajectories, normalized to 2024 = 100',
    subtitle: 'Bitcoin and ten other proof-of-work and proof-of-stake chains, plotted against gold and USD M2 on a single supply index. Bitcoin asymptotes to its hard cap; USD M2 keeps compounding; the others decay toward a cap, run a permanent tail, or hold a one-time fixed supply.',
    yLabel: 'Supply index (2024 = 100)',
    xLabel: 'Year',
    scaleLinear: 'Linear',
    scaleLog: 'Log',
    hoverYear: 'Year',
    legendHint: 'Click a label to toggle the series.',
  },
  ja: {
    title: '2024 年を 100 とした供給量の推移',
    subtitle: 'ビットコインと他の 10 チェーン (プルーフ・オブ・ワーク / プルーフ・オブ・ステーク) を、金と USD M2 を対照に、1 つの供給指標で比較。ビットコインはハード上限に漸近、USD M2 は複利的に拡大を続け、他は上限へ逓減する、恒久的な末尾発行を続ける、あるいは一度きりの固定供給のいずれかを取る。',
    yLabel: '供給指標 (2024 年 = 100)',
    xLabel: '年',
    scaleLinear: '線形',
    scaleLog: '対数',
    hoverYear: '年',
    legendHint: '凡例のラベルをクリックすると系列の表示を切り替えられる。',
  },
};

const l = labels[lang];

// Localize series + annotation labels server-side so the client script
// receives a single lang-agnostic data structure.
const localized = {
  baselineYear: seriesData.baselineYear,
  yearRange: seriesData.yearRange,
  annotations: seriesData.annotations.map((a: any) => ({
    year: a.year,
    label: lang === 'ja' ? a.labelJa : a.labelEn,
  })),
  series: seriesData.series.map((s: any) => ({
    id: s.id,
    label: lang === 'ja' ? s.labelJa : s.labelEn,
    colorVar: s.colorVar,
    dash: s.dash,
    points: s.points,
  })),
};
---

<div class="supply-curve-comparison">
  <section class="analysis-section">
    <h3>{l.title}</h3>
    <p class="analysis-desc">{l.subtitle}</p>

    <div class="chart-controls">
      <div class="chart-scale-btns">
        <button class="scale-btn active" data-scale="linear">{l.scaleLinear}</button>
        <button class="scale-btn" data-scale="log">{l.scaleLog}</button>
      </div>
      <button class="ba-replay-btn" data-replay type="button">{lang === 'ja' ? '↻ リプレイ' : '↻ Replay'}</button>
    </div>

    <div id="supply-curve-chart" class="chart-container"></div>
    <div id="supply-curve-legend" class="legend"></div>
    <p class="legend-hint">{l.legendHint}</p>
  </section>

  <script type="application/json" id="supply-curve-data" set:html={JSON.stringify(localized)} />
  <script type="application/json" id="supply-curve-labels" set:html={JSON.stringify(l)} />
  <script is:inline src={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'scripts/chart-anim.js'}></script>
</div>

<script>
// Drawing logic lives in src/scripts/supply-curve-comparison.js (shared with
// the in-body embed via ChartEmbedRuntime). This script only wires the
// server-rendered JSON data blocks and DOM elements into that shared mount().
import { mount } from '../scripts/supply-curve-comparison.js';

(function() {
  var container = document.getElementById('supply-curve-chart') as HTMLElement;
  var legendEl  = document.getElementById('supply-curve-legend') as HTMLElement;
  var dataEl    = document.getElementById('supply-curve-data') as HTMLElement;
  var labelsEl  = document.getElementById('supply-curve-labels') as HTMLElement;
  if (!container || !legendEl || !dataEl || !labelsEl) return;

  var data   = JSON.parse(dataEl.textContent as string);
  var labels = JSON.parse(labelsEl.textContent as string);
  var replayBtn = (container.parentElement as HTMLElement).querySelector('[data-replay]') as HTMLElement | null;
  var scaleBtns = Array.from((container.parentElement as HTMLElement).querySelectorAll('.scale-btn')) as HTMLElement[];

  mount(container, legendEl, replayBtn, scaleBtns, data, labels);
})();
</script>

<style>
  .supply-curve-comparison {
    margin: var(--rhythm-block) 0;
  }
  .analysis-section h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .analysis-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 0.85rem;
  }
  .chart-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .chart-scale-btns {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }
  .scale-btn {
    padding: 3px 10px;
    font-size: 0.78rem;
    font-family: var(--font-heading);
    background: var(--color-bg);
    color: var(--color-text-muted);
    border: none;
    border-right: 1px solid var(--color-border);
    cursor: pointer;
  }
  .scale-btn:last-child { border-right: none; }
  .scale-btn.active {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    font-weight: 600;
  }
  .chart-container {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    overflow: hidden;
  }
  .chart-container :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 0.7rem;
    font-size: 0.83rem;
  }
  .legend :global(.legend-item) {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
    color: var(--color-text);
  }
  .legend :global(.legend-item.off) {
    color: var(--color-text-muted);
    text-decoration: line-through;
    opacity: 0.55;
  }
  .legend :global(.legend-swatch) {
    display: inline-flex;
    align-items: center;
    margin-right: 5px;
  }
  .legend-hint {
    margin-top: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
